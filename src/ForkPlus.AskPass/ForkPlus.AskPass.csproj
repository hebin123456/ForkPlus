<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 阶段 6：与主工程 ForkPlus.csproj 同 TFM，便于 CopyHelperExecutables 用
         $(TargetFramework) 定位 exe 输出路径。AskPass 是 git credential helper
         子进程，被 ForkPlus 通过 Process.Start 调用。net10.0 目标使 Linux/macOS 也能生成。-->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <AssemblyName>ForkPlus.AskPass</AssemblyName>
    <TargetName>ForkPlus.AskPass</TargetName>
    <RootNamespace>ForkPlus.AskPass</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- 不生成 .xml 文档注释导出文件（运行时不需要，仅供 IDE IntelliSense / API 文档用途）。-->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
</Project>
