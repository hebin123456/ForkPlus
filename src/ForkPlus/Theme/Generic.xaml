<ResourceDictionary xmlns="https://github.com/avaloniaui">
  <ResourceDictionary.MergedDictionaries>
    <!-- Pure resource files (brushes / geometries / colors). These stay as
         <ResourceDictionary> root and are merged into Application.Resources
         so DynamicResource lookups across the app can resolve them.

         The Style / ControlTemplate files (Button.xaml, Window.xaml, etc.) used
         to live here too, but they have been converted to <Styles> root and are
         now loaded via <StyleInclude> in App.axaml so the styles auto-apply to
         controls via their Selector. ResourceInclude cannot load <Styles>-root
         files (AVLN2000), and StyleInclude cannot load <ResourceDictionary>-
         root files, so the two categories must be split between App.Resources
         and App.Styles accordingly. -->
    <ResourceInclude Source="Styles/Brushes/Brushes.xaml" />
    <ResourceInclude Source="Styles/Geometries.xaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
