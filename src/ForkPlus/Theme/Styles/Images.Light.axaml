  <wpf:BitmapImage x:Key="BitbucketOnIcon" UriSource="avares://ForkPlus/Assets/BitBucketOn.png" />
  <wpf:BitmapImage x:Key="GitHubIcon" UriSource="avares://ForkPlus/Assets/Github.png" />
  <wpf:BitmapImage x:Key="GitHubOnIcon" UriSource="avares://ForkPlus/Assets/GithubOn.png" />
  <wpf:BitmapImage x:Key="GitLabIcon" UriSource="avares://ForkPlus/Assets/Gitlab.png" />
  <wpf:BitmapImage x:Key="GitLabOnIcon" UriSource="avares://ForkPlus/Assets/GitlabOn.png" />
