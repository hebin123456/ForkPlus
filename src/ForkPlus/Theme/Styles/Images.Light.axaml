  <wpf:BitmapImage x:Key="GenericRemoteIcon" UriSource="avares://ForkPlus/Assets/Remote.png" />
  <wpf:BitmapImage x:Key="GenericRemoteOnIcon" UriSource="avares://ForkPlus/Assets/RemoteOn.png" />
  <!-- 业务层 IconKeys 用带 "Remote." 前缀的键（Remote.Azure / Remote.Bitbucket / ...），
       与上面 XxxIcon 键不一致，导致 FindImage 找不到退化成 GenericRemoteIcon（全是 Remote.png）。
       这里追加同名别名指向同一份 png，让两套键都能解析到正确图标。-->
  <wpf:BitmapImage x:Key="Remote.Azure" UriSource="avares://ForkPlus/Assets/Azure.png" />
  <wpf:BitmapImage x:Key="Remote.Bitbucket" UriSource="avares://ForkPlus/Assets/BitBucket.png" />
  <wpf:BitmapImage x:Key="Remote.Gitea" UriSource="avares://ForkPlus/Assets/Gitea.png" />
  <wpf:BitmapImage x:Key="Remote.Github" UriSource="avares://ForkPlus/Assets/Github.png" />
  <wpf:BitmapImage x:Key="Remote.Gitlab" UriSource="avares://ForkPlus/Assets/Gitlab.png" />
  <wpf:BitmapImage x:Key="Remote.Generic" UriSource="avares://ForkPlus/Assets/Remote.png" />
</ResourceDictionary>
