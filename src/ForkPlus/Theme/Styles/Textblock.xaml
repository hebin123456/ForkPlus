<!-- Migration Notes (WPF -> Avalonia):
     - Root xmlns set to https://github.com/avaloniaui; removed duplicate xmlns:x on child elements.
     - Style TargetType="T" -> Selector="T"; x:Key values preserved, BasedOn preserved.
     - Property prefixes stripped: TextElement.FontSize -> FontSize, TextElement.FontWeight -> FontWeight,
       TextElement.Foreground -> Foreground, FrameworkElement.Margin -> Margin,
       FrameworkElement.HorizontalAlignment -> HorizontalAlignment, FrameworkElement.VerticalAlignment -> VerticalAlignment,
       FrameworkElement.Height -> Height, FrameworkElement.Width -> Width, UIElement.Focusable -> Focusable,
       Panel.Background -> Background, FrameworkContentElement.FocusVisualStyle -> FocusVisualStyle,
       Inline.TextDecorations -> TextDecorations, TextBlock.Text -> Text, FrameworkElement.ToolTip -> ToolTip,
       Control.Template -> Template.
     - TemplateBinding class prefixes stripped ({TemplateBinding Width} -> {TemplateBinding Width},
       {TemplateBinding Background} -> {TemplateBinding Background}, {TemplateBinding FontSize} ->
       {TemplateBinding FontSize}, {TemplateBinding Foreground} -> {TemplateBinding Foreground}).
     - 5 Hyperlink Style.Triggers (ContentElement.IsMouseOver=True) converted to nested <Style.Styles> with
       ^:pointerover selectors (scoped to each named style via parent x:Key). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="SettingsHeaderTextBlockStyle" Selector="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,12,0,6" />
  </Style>
  <Style x:Key="ReferenceLabelTextBlockStyle" Selector="TextBlock">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReferenceForeground}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Margin" Value="2,-1,2,1" />
  </Style>
  <Style x:Key="ToolbarButtonTitle" Selector="TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="4,-3,4,2" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ToolbarForeground}" />
  </Style>
  <Style x:Key="LfsLabel" Selector="Label">
    <Setter Property="Height" Value="16" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Width="{TemplateBinding Width}" Background="{TemplateBinding Background}" CornerRadius="4">
            <TextBlock Margin="0,0,0,1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="LFS" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" x:Name="ContentTextBlock" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NotLfsLabel" Selector="Label">
    <Setter Property="Height" Value="16" />
    <Setter Property="Width" Value="42" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="#FFFF6663" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Width="{TemplateBinding Width}" Background="{TemplateBinding Background}" CornerRadius="4">
            <TextBlock Margin="0,0,0,1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="not LFS" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" x:Name="ContentTextBlock" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BugtrackerHyperlinkStyle" Selector="Hyperlink">
<Setter Property="TextElement.Foreground" Value="{DynamicResource ReferenceBrush}" />
    <Setter Property="TextDecorations">
      <Setter.Value>
        <x:Null />
      </Setter.Value>
    </Setter>
    <!-- Converted from Style.Triggers: ContentElement.IsMouseOver=True -> :pointerover -->
    <Style Selector="^:pointerover">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ReferenceBrush}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Style>
  <Style x:Key="BlueHyperlinkStyle" Selector="Hyperlink">
<Setter Property="TextElement.Foreground" Value="{DynamicResource ReferenceBrush}" />
    <!-- Converted from Style.Triggers: ContentElement.IsMouseOver=True -> :pointerover -->
    <Style Selector="^:pointerover">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ReferenceBrush}" />
    </Style>
  </Style>
  <Style x:Key="BlueUnderlineHyperlinkStyle" Selector="Hyperlink">
<Setter Property="TextElement.Foreground" Value="{DynamicResource ReferenceBrush}" />
    <Setter Property="TextDecorations">
      <Setter.Value>
        <x:Null />
      </Setter.Value>
    </Setter>
    <!-- Converted from Style.Triggers: ContentElement.IsMouseOver=True -> :pointerover -->
    <Style Selector="^:pointerover">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ReferenceBrush}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Style>
  <Style x:Key="GrayHyperlinkStyle" Selector="Hyperlink">
<Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush.Gray}" />
    <!-- Converted from Style.Triggers: ContentElement.IsMouseOver=True -> :pointerover -->
    <Style Selector="^:pointerover">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ReferenceBrush}" />
    </Style>
  </Style>
  <Style x:Key="GrayUnderlineHyperlinkStyle" Selector="Hyperlink">
    <Setter Property="TextDecorations">
      <Setter.Value>
        <x:Null />
      </Setter.Value>
    </Setter>
    <!-- Converted from Style.Triggers: ContentElement.IsMouseOver=True -> :pointerover -->
    <Style Selector="^:pointerover">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ReferenceBrush}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Style>
  <Style x:Key="HintTextBlock" Selector="TextBlock">
    <Setter Property="Text" Value="?" />
    <Setter Property="Margin" Value="4,2,6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="ToolTip">
      <Setter.Value>
        <ToolTip>
          <ToolTip.DataContext>
            <Binding Path="PlacementTarget" RelativeSource="{x:Static RelativeSource.Self}" />
          </ToolTip.DataContext>
          <StackPanel>
            <TextBlock>
              <TextBlock.Text>
                <Binding Path="Tag" />
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
        </ToolTip>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
