<!-- Migration notes (WPF -> Avalonia):
     - Root xmlns set to https://github.com/avaloniaui; removed redundant child xmlns:x declarations.
     - Style TargetType="{x:Type T}" -> Selector="T" (x:Key values preserved, BasedOn preserved).
     - ControlTemplate.Triggers -> nested <Style Selector="^..."> with /template/ Element#Name selectors.
     - Pseudoclass mapping: IsMouseOver->:pointerover, IsPressed->:pressed, IsEnabled=False->:disabled,
       IsSelected=True->:selected, IsKeyboardFocused->:focus, Thumb.IsDragging->:dragging.
     - MultiTrigger (IsSelectionActive=True + IsSelected=True) -> :selected (active values). The inactive
       case (IsSelectionActive=False + IsSelected=True) has no Avalonia equivalent (no pseudoclass for
       Selector.IsSelectionActive) -> documented inline as NOTE (Avalonia limitation); the active :selected
       styling is used regardless of focus.
     - DataTemplate.Triggers bind to view-model properties (IsActive, IsWorktree, HasDownstream, IsGood)
       and target named elements within the DataTemplate -> migrated in phase 4.5 to direct bindings +
       converters (BoolToFontWeightConverter, BoolToBrushConverter, BoolToCornerRadiusConverter,
       BoolToThicknessConverter, and MultiBinding with BoolConverters.And). See inline comments.
     - Style.Triggers on ListBox.SelectionMode (enum value, no pseudoclass) -> NOTE (Avalonia limitation);
       consumers set ItemContainerStyle explicitly.
     - Style.Triggers DataTriggers on view-model properties (IsHead, IsReachable) -> migrated to Style
       Setters with BoolToFontWeightConverter / BoolToBrushConverter (same pattern as
       RevisionListViewUserControl ItemContainerStyle).
     - Trigger on FrameworkElement.Height=Auto (no pseudoclass) -> NOTE (Avalonia limitation).
     - Property prefixes stripped in Setters (Panel.Background->Background, Border.BorderBrush->BorderBrush,
       FrameworkElement.* -> *, Control.* -> *, UIElement.* -> *, TextElement.* -> *, Shape.* -> *,
       Image.* -> *, ContentControl.* -> *, ItemsControl.* -> *, ButtonBase.* -> *, Inline.* -> *).
       Attached properties (ScrollViewer.*, KeyboardNavigation.*, Stylus.*, RenderOptions.*,
       VirtualizingPanel.*) kept as-is.
     - UIElement.Visibility in Setters and literal template attrs -> IsVisible (bool: Visible->True,
       Collapsed/Hidden->False). TemplateBindings to ComputedHorizontalScrollBarVisibility/
       ComputedVerticalScrollBarVisibility -> IsVisible (Avalonia returns bool).
     - TemplateBinding paths stripped of class prefixes for direct properties; attached properties kept.
     - ControlTemplate internal control tree and layout preserved. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:avaloniaConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  <Style x:Key="ListItemRoundedBorderStyle" Selector="Border">
    <Setter Property="Margin" Value="4,0,4,0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style x:Key="ListItemNotRoundedBorderStyle" Selector="Border">
    <Setter Property="Margin" Value="4,0,4,0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <DataTemplate x:Key="ReferencesDataTemplates">
    <DataTemplate.Resources>
      <ResourceDictionary>
        <DataTemplate DataType="{x:Type ui:TagViewModel}">
          <StackPanel Orientation="Horizontal" Height="18" Margin="3,2,3,2">
            <Border BorderThickness="1" CornerRadius="4,0,0,4" BorderBrush="{DynamicResource RevisionList.TagBorder}" Background="{DynamicResource ListBox.Static.Background}">
              <Image Source="{DynamicResource TagIcon}" Height="14" Width="14" Margin="2,0,2,0" />
            </Border>
            <Border BorderThickness="0,1,1,1" Padding="2,0" CornerRadius="0,4,4,0" BorderBrush="{DynamicResource RevisionList.TagBorder}" Background="{DynamicResource RevisionList.TagBackground}">
              <controls:HighlightableTextBlock>
                <controls:HighlightableTextBlock.Text>
                  <Binding Path="Name" />
                </controls:HighlightableTextBlock.Text>
                <controls:HighlightableTextBlock.HighlightString>
                  <Binding Path="SearchString" />
                </controls:HighlightableTextBlock.HighlightString>
              </controls:HighlightableTextBlock>
            </Border>
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:LocalBranchViewModel}">
          <Border Height="18" BorderThickness="1" CornerRadius="4" Margin="3,2,3,2">
            <Border.BorderBrush>
              <Binding Path="BorderBrush" />
            </Border.BorderBrush>
            <Border.Background>
              <Binding Path="BackgroundBrush" />
            </Border.Background>
            <StackPanel Orientation="Horizontal">
              <!-- 阶段 4.5：原 DataTrigger (IsActive=True -> ActiveBranchIcon.IsVisible=True) 用直接绑定实现。 -->
              <Path Stretch="None" Margin="3,0,0,0" VerticalAlignment="Center" Data="{DynamicResource OptionMarkGeomentry}" Fill="{DynamicResource ReferenceForeground}" IsVisible="{Binding IsActive}" x:Name="ActiveBranchIcon" />
              <!-- 阶段 4.5：原 MultiDataTrigger (IsActive=True AND IsWorktree=True -> IconBorder 可见,
                   BorderThickness=0,0,1,0, Background=ListBox.Static.Background) 用 MultiBinding +
                   BoolConverters.And 实现 IsVisible;BorderThickness/Background 直接设为触发值
                   (IconBorder 不可见时不渲染,故常驻触发值视觉等价)。 -->
              <Border BorderThickness="0,0,1,0" CornerRadius="4,0,0,4" Background="{DynamicResource ListBox.Static.Background}" x:Name="IconBorder">
                <Border.IsVisible>
                  <MultiBinding Converter="{x:Static avaloniaConverters:BoolConverters.And}">
                    <Binding Path="IsActive" />
                    <Binding Path="IsWorktree" />
                  </MultiBinding>
                </Border.IsVisible>
                <Border.BorderBrush>
                  <Binding Path="BorderBrush" />
                </Border.BorderBrush>
                <Image Source="{DynamicResource WorktreeIcon}" Height="14" Width="14" Margin="2,0,2,0" />
              </Border>
              <!-- 阶段 4.5：原 DataTrigger (IsActive=True -> FontWeight=Bold) 用直接绑定 + BoolToFontWeightConverter 实现。 -->
              <controls:HighlightableTextBlock FontWeight="{Binding IsActive, Converter={controls:BoolToFontWeightConverter TrueWeight=Bold}}" Margin="4,-1,4,1" x:Name="NameTextBlock">
                <controls:HighlightableTextBlock.Text>
                  <Binding Path="Name" />
                </controls:HighlightableTextBlock.Text>
                <controls:HighlightableTextBlock.HighlightString>
                  <Binding Path="SearchString" />
                </controls:HighlightableTextBlock.HighlightString>
              </controls:HighlightableTextBlock>
            </StackPanel>
          </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:RemoteBranchViewModel}">
          <!-- 阶段 4.5：原 DataTemplate.Triggers (HasDownstream -> NameContainer.IsVisible/Border.CornerRadius/
               Container.Margin) 用直接绑定 + 转换器实现:
               - NameContainer.IsVisible = !HasDownstream (有下游时隐藏名称,仅显示图标)
               - Border.CornerRadius: HasDownstream=true->4(全圆), false->4,0,0,4(左圆,衔接名称) [BoolToCornerRadiusConverter]
               - Container.Margin: HasDownstream=true->3,2,1,2, false->3,2,3,2 [BoolToThicknessConverter] -->
          <StackPanel Orientation="Horizontal" Height="18" x:Name="Container">
            <StackPanel.Margin>
              <Binding Path="HasDownstream">
                <Binding.Converter>
                  <controls:BoolToThicknessConverter TrueThickness="3,2,1,2" FalseThickness="3,2,3,2" />
                </Binding.Converter>
              </Binding>
            </StackPanel.Margin>
            <Border BorderThickness="1" Background="{DynamicResource ListBox.Static.Background}" x:Name="Border">
              <Border.CornerRadius>
                <Binding Path="HasDownstream">
                  <Binding.Converter>
                    <controls:BoolToCornerRadiusConverter TrueCornerRadius="4" FalseCornerRadius="4,0,0,4" />
                  </Binding.Converter>
                </Binding>
              </Border.CornerRadius>
              <Border.BorderBrush>
                <Binding Path="BorderBrush" />
              </Border.BorderBrush>
              <Image Height="14" Width="14" Margin="2,0,2,0" x:Name="Icon">
                <Image.Source>
                  <Binding Path="RemoteIcon" />
                </Image.Source>
              </Image>
            </Border>
            <Border BorderThickness="0,1,1,1" Padding="2,0" CornerRadius="0,4,4,0" IsVisible="{Binding !HasDownstream}" x:Name="NameContainer">
              <Border.BorderBrush>
                <Binding Path="BorderBrush" />
              </Border.BorderBrush>
              <Border.Background>
                <Binding Path="BackgroundBrush" />
              </Border.Background>
              <controls:HighlightableTextBlock>
                <controls:HighlightableTextBlock.Text>
                  <Binding Path="Name" />
                </controls:HighlightableTextBlock.Text>
                <controls:HighlightableTextBlock.HighlightString>
                  <Binding Path="SearchString" />
                </controls:HighlightableTextBlock.HighlightString>
              </controls:HighlightableTextBlock>
            </Border>
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:BisectMarkViewModel}">
          <StackPanel Orientation="Horizontal" Height="18" Margin="3,2,3,2">
            <!-- 阶段 4.5：原 DataTrigger (IsGood=True -> IconBorder.BorderBrush/Icon.Source 切换为 Good)
                 用 BoolToBrushConverter 绑定 BorderBrush + 叠放两个 Image(IsVisible 绑定 IsGood/!IsGood)实现。 -->
            <Border BorderThickness="1" CornerRadius="4,0,0,4" Background="{DynamicResource ListBox.Static.Background}" x:Name="IconBorder">
              <Border.BorderBrush>
                <Binding Path="IsGood">
                  <Binding.Converter>
                    <controls:BoolToBrushConverter TrueBrush="{DynamicResource RevisionList.BisectGoodBorder}" FalseBrush="{DynamicResource RevisionList.BisectBadBorder}" />
                  </Binding.Converter>
                </Binding>
              </Border.BorderBrush>
              <Grid>
                <Image Height="14" Width="14" Margin="2,0,2,0" Source="{DynamicResource BisectBadIcon}" IsVisible="{Binding !IsGood}" />
                <Image Height="14" Width="14" Margin="2,0,2,0" Source="{DynamicResource BisectGoodIcon}" IsVisible="{Binding IsGood}" />
              </Grid>
            </Border>
            <!-- 阶段 4.5：原 DataTrigger (IsGood=True -> LabelBorder.BorderBrush/Background 切换为 Good)
                 用 BoolToBrushConverter 绑定实现。 -->
            <Border BorderThickness="0,1,1,1" Padding="2,0" CornerRadius="0,4,4,0" x:Name="LabelBorder">
              <Border.BorderBrush>
                <Binding Path="IsGood">
                  <Binding.Converter>
                    <controls:BoolToBrushConverter TrueBrush="{DynamicResource RevisionList.BisectGoodBorder}" FalseBrush="{DynamicResource RevisionList.BisectBadBorder}" />
                  </Binding.Converter>
                </Binding>
              </Border.BorderBrush>
              <Border.Background>
                <Binding Path="IsGood">
                  <Binding.Converter>
                    <controls:BoolToBrushConverter TrueBrush="{DynamicResource RevisionList.BisectGoodBackground}" FalseBrush="{DynamicResource RevisionList.BisectBadBackground}" />
                  </Binding.Converter>
                </Binding>
              </Border.Background>
              <TextBlock>
                <TextBlock.Text>
                  <Binding Path="Name" />
                </TextBlock.Text>
              </TextBlock>
            </Border>
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:StashReferenceViewModel}">
          <Border Height="18" BorderThickness="1" CornerRadius="4" Padding="0" Margin="3,2,3,2" BorderBrush="{DynamicResource RevisionList.StashBorder}" Background="{DynamicResource ListBox.Static.Background}">
            <DockPanel>
              <Image Source="{DynamicResource SidebarStashIcon}" DockPanel.Dock="Left" Height="14" Width="14" Margin="2,0,2,0" />
              <Border BorderThickness="1,0,0,0" Padding="2,0" CornerRadius="0,3,3,0" BorderBrush="{DynamicResource RevisionList.StashBorder}" Background="{DynamicResource RevisionList.StashBackground}">
                <TextBlock>
                  <TextBlock.Text>
                    <Binding Path="ReflogName" />
                  </TextBlock.Text>
                </TextBlock>
              </Border>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ResourceDictionary>
    </DataTemplate.Resources>
    <ContentPresenter>
      <ContentPresenter.Content>
        <Binding />
      </ContentPresenter.Content>
    </ContentPresenter>
  </DataTemplate>
  <Style x:Key="FocusVisual" Selector="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="2" Stroke="{DynamicResource Item.SelectedActive.Background}" StrokeThickness="1" StrokeDashArray="1 2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ListViewItemStyle" Selector="ListViewItem">
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="HorizontalContentAlignment">
      <Setter.Value>
        <Binding Path="HorizontalContentAlignment"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ItemsControl}" /></Binding.RelativeSource></Binding>
      </Setter.Value>
    </Setter>
    <Setter Property="VerticalContentAlignment">
      <Setter.Value>
        <Binding Path="VerticalContentAlignment"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ItemsControl}" /></Binding.RelativeSource></Binding>
      </Setter.Value>
    </Setter>
    <Setter Property="Background" Value="{DynamicResource ListBox.Static.Background}" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" x:Name="Bd">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <!-- Converted from ControlTemplate.Triggers: IsMouseOver=True -> :pointerover -->
          <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Item.MouseOver.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Item.MouseOver.Border}" />
          </Style>
          <!-- Converted from ControlTemplate.Triggers: IsSelectionActive=True + IsSelected=True -> :selected (active) -->
          <Style Selector="^:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
          </Style>
          <!-- NOTE (Avalonia limitation): ControlTemplate.Triggers MultiTrigger (Selector.IsSelectionActive=False + IsSelected=True)
               could not be converted (no Avalonia pseudoclass for Selector.IsSelectionActive). Original
               inactive-selection styling preserved below for reference; reimplement using a custom
               pseudoclass toggled from code-behind (e.g. :selection-inactive).
               Original logic:
                 Bd.Background = Item.SelectedInactive.Background
                 Bd.BorderBrush = Item.SelectedInactive.Border -->
          <!-- Converted from ControlTemplate.Triggers: IsEnabled=False -> :disabled -->
          <Style Selector="^:disabled /template/ Border#Bd">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
          </Style>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ListView}" Selector="ListView">
    <Setter Property="Background" Value="{DynamicResource ListBox.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListBox.Static.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0,4,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ItemContainerStyle" Value="{DynamicResource ListViewItemStyle}" />
<Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" x:Name="Bd">
            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- NOTE (Avalonia limitation): Style.Triggers Trigger on ListBox.SelectionMode=Extended could not be converted (no Avalonia
         pseudoclass for SelectionMode enum value). Original logic preserved below for reference;
         reimplement using a custom pseudoclass toggled from code-behind, or by setting
         ItemContainerStyle via a binding/converter.
    <Style.Triggers>
      <Trigger Property="ListBox.SelectionMode" Value="Extended">
        <Setter Property="ItemContainerStyle" Value="{DynamicResource MultiselectListBoxItemStyle}" />
      </Trigger>
    </Style.Triggers>
    -->
  </Style>
  <Style x:Key="GridViewColumnHeaderStyle" Selector="GridViewColumnHeader">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style x:Key="ListViewWithGridViewScrollViewerStyle" Selector="ScrollViewer">
    <Setter Property="Background" Value="{DynamicResource ListBox.Static.Background}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="{TemplateBinding Padding}">
              <controls:TouchpadAwareScrollViewer DockPanel.Dock="Top" Focusable="False" HorizontalScrollBarIsVisible="False" VerticalScrollBarIsVisible="False">
                <GridViewHeaderRowPresenter Margin="0" Columns="{Binding Path=TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}">
                  <GridViewHeaderRowPresenter.AllowsColumnReorder>
                    <Binding Path="TemplatedParent.View.AllowsColumnReorder"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
                  </GridViewHeaderRowPresenter.AllowsColumnReorder>
                  <GridViewHeaderRowPresenter.ColumnHeaderContainerStyle>
                    <Binding Path="TemplatedParent.View.ColumnHeaderContainerStyle"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
                  </GridViewHeaderRowPresenter.ColumnHeaderContainerStyle>
                  <GridViewHeaderRowPresenter.ColumnHeaderToolTip>
                    <Binding Path="TemplatedParent.View.ColumnHeaderToolTip"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
                  </GridViewHeaderRowPresenter.ColumnHeaderToolTip>
                  <GridViewHeaderRowPresenter.ColumnHeaderContextMenu>
                    <Binding Path="TemplatedParent.View.ColumnHeaderContextMenu"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
                  </GridViewHeaderRowPresenter.ColumnHeaderContextMenu>
                  <GridViewHeaderRowPresenter.ColumnHeaderTemplate>
                    <Binding Path="TemplatedParent.View.ColumnHeaderTemplate"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
                  </GridViewHeaderRowPresenter.ColumnHeaderTemplate>
                </GridViewHeaderRowPresenter>
              </controls:TouchpadAwareScrollViewer>
              <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" Content="{TemplateBinding Content}" ContentTemplate="{x:Null}" KeyboardNavigation.DirectionalNavigation="Local" x:Name="PART_ScrollContentPresenter" />
            </DockPanel>
            <ScrollBar Cursor="Arrow" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0" Orientation="Horizontal" Grid.Row="1" IsVisible="{TemplateBinding ComputedHorizontalScrollBarVisibility}" ViewportSize="{TemplateBinding ViewportWidth}" x:Name="PART_HorizontalScrollBar">
              <ScrollBar.Value>
                <Binding Path="HorizontalOffset" Mode="OneWay"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
              </ScrollBar.Value>
            </ScrollBar>
            <ScrollBar Cursor="Arrow" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Orientation="Vertical" IsVisible="{TemplateBinding ComputedVerticalScrollBarVisibility}" ViewportSize="{TemplateBinding ViewportHeight}" x:Name="PART_VerticalScrollBar">
              <ScrollBar.Value>
                <Binding Path="VerticalOffset" Mode="OneWay"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
              </ScrollBar.Value>
            </ScrollBar>
            <DockPanel Background="{DynamicResource ScrollViewerBackground}" Grid.Column="1" LastChildFill="False" Grid.Row="1">
              <Rectangle DockPanel.Dock="Left" Fill="{DynamicResource ScrollBar.Static.Background}" Width="1" IsVisible="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
              <Rectangle DockPanel.Dock="Top" Fill="{DynamicResource ScrollBar.Static.Background}" Height="1" IsVisible="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
            </DockPanel>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ListViewItemGridViewStyle" Selector="ListViewItem">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="4,0,4,0" x:Name="Bd">
            <Border.CornerRadius>
              <Binding Path="SelectionType"><Binding.Converter><ui:SelectionToCornerRadiusConverter /></Binding.Converter></Binding>
            </Border.CornerRadius>
            <GridViewRowPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <!-- Converted from ControlTemplate.Triggers: IsSelectionActive=True + IsSelected=True -> :selected (active) -->
          <Style Selector="^:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
          </Style>
          <!-- NOTE (Avalonia limitation): ControlTemplate.Triggers MultiTrigger (Selector.IsSelectionActive=False + IsSelected=True)
               could not be converted (no Avalonia pseudoclass for Selector.IsSelectionActive). Original
               inactive-selection styling preserved below for reference; reimplement using a custom
               pseudoclass toggled from code-behind.
               Original logic:
                 Bd.Background = Item.SelectedInactive.Background
                 Bd.BorderBrush = Item.SelectedInactive.Border -->
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ListViewWithGridViewStyle" Selector="ListView">
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ListViewItem}" Selector="ListViewItem" />
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" Padding="0" x:Name="Bd">
            <controls:TouchpadAwareScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
              <ItemsPresenter />
            </controls:TouchpadAwareScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NoSelectionRevisionListViewItemStyle" Selector="ListViewItem">
    <Setter Property="Focusable" Value="False" />
<Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <!-- 阶段 4.5：原 Style.Triggers DataTriggers (IsHead=True -> FontWeight=Bold;
         IsReachable=False -> Foreground=UnreachableBrush) 用 Style Setter + 转换器实现
         (与 RevisionListViewUserControl ItemContainerStyle 同一模式)。
         - IsHead: BoolToFontWeightConverter (TrueWeight=Bold, false->Normal)
         - IsReachable: BoolToBrushConverter (FalseBrush=Unreachable; TrueBrush=null->UnsetValue 保持继承) -->
    <Setter Property="FontWeight">
      <Setter.Value>
        <Binding Path="IsHead">
          <Binding.Converter>
            <controls:BoolToFontWeightConverter TrueWeight="Bold" />
          </Binding.Converter>
        </Binding>
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground">
      <Setter.Value>
        <Binding Path="IsReachable">
          <Binding.Converter>
            <controls:BoolToBrushConverter FalseBrush="{DynamicResource RevisionList.Unreachable.ForegroundBrush}" />
          </Binding.Converter>
        </Binding>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ListBoxItemStyle" Selector="ListBoxItem">
<Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Item.Static.Background}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" x:Name="Bd">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <!-- Converted from ControlTemplate.Triggers: IsSelectionActive=True + IsSelected=True -> :selected (active) -->
          <Style Selector="^:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
          </Style>
          <!-- NOTE (Avalonia limitation): ControlTemplate.Triggers MultiTrigger (Selector.IsSelectionActive=False + IsSelected=True)
               could not be converted (no Avalonia pseudoclass for Selector.IsSelectionActive). Original
               inactive-selection styling preserved below for reference; reimplement using a custom
               pseudoclass toggled from code-behind.
               Original logic:
                 Bd.Background = Item.SelectedInactive.Background
                 Bd.BorderBrush = Item.SelectedInactive.Border -->
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MultiselectListBoxItemStyle" Selector="ListBoxItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="4,0,4,0" x:Name="Bd">
            <Border.CornerRadius>
              <Binding Path="SelectionType"><Binding.Converter><ui:SelectionToCornerRadiusConverter /></Binding.Converter></Binding>
            </Border.CornerRadius>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <!-- Converted from ControlTemplate.Triggers: IsSelectionActive=True + IsSelected=True -> :selected (active) -->
          <Style Selector="^:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}" />
