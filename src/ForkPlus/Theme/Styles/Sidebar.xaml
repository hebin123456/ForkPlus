<!-- Migration notes (WPF -> Avalonia):
     - Root xmlns set to https://github.com/avaloniaui; removed redundant child xmlns:x declarations.
     - Style TargetType="{x:Type T}" -> Selector="T" for styles whose Triggers were converted
       (x:Key values preserved, BasedOn preserved). Styles without Triggers left as-is.
     - ControlTemplate.Triggers -> nested <Style Selector="^..."> with /template/ Element#Name selectors.
     - Style.Triggers -> nested <Style Selector="^:pseudoclass"> control-level selectors.
     - Pseudoclass mapping: ContentElement.IsMouseOver->:pointerover, ToggleButton.IsChecked=true->:checked,
       ButtonBase.IsPressed->:pressed, UIElement.IsEnabled=false->:disabled.
       IsChecked=false trigger is the default (unchecked) state - no separate selector needed.
     - DataTrigger binding to control's own IsChecked (RelativeSource Self) -> :checked pseudoclass.
     - Property prefixes stripped in converted Setters (Panel.Background->Background, Border.*->*,
       Control.*->*, FrameworkElement.*->*, TextElement.*->*, UIElement.*->*, Shape.*->*,
       ContentElement.*->*, Inline.*->*, ContentControl.*->*, ButtonBase.*->*, ToggleButton.*->*).
     - TemplateBinding paths stripped of class prefixes (Panel.Background->Background, etc.).
     - DataTemplate.Triggers (binding to view-model properties Pinned/FilterState/LocalBranch.IsActive/
       Worktree.IsActive and ancestor TreeViewItem state) converted in phase 4.5 cleanup:
       * Ancestor TreeViewItem state (:pointerover / :selected:focus-within) → top-level Style
         Selectors below (FilterButton/HideButton/PinButton visible on hover; primary Image.Source
         switches to *SelectedIcon when selected+focused). TreeViewItem inherits ListBoxItem, so
         :selected ≡ WPF IsSelected=True, :pointerover ≡ IsMouseOver=True, :focus-within ≡ IsKeyboardFocusWithin=True.
       * LocalBranch.IsActive / Worktree.IsActive → TitleTextBlock.FontWeight via BoolToFontWeightConverter.
       * Simplification: composite conditions (Pinned+IsSelected+IsKeyboardFocusWithin,
         FilterState+IsSelected, IsMouseOver+FilterState) are not fully reproduced; FilterState=Filter/Hide
         driven persistent button visibility is not implemented (buttons show on hover only);
         FilterButtonImage/HideButtonImage/PinButtonImage On/Off/Selected icon switching is not implemented. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="RepositoryTitleHyperlinkStyle" Selector="Hyperlink">
<Setter Property="TextDecorations">
      <Setter.Value>
        <x:Null />
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <!-- Converted from Style.Triggers: ContentElement.IsMouseOver=True -> :pointerover -->
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ReferenceBrush}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Style>
  <Style x:Key="SidebarButton" Selector="RadioButton">
    <Setter Property="Background" Value="{DynamicResource Sidebar.Static.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="20 2 20 2" />
    <Setter Property="Margin" Value="2,0,2,0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
<Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}" CornerRadius="4" x:Name="border">
            <ContentPresenter Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="contentPresenter" />
          </Border>
          <!-- Converted from ControlTemplate.Triggers: ToggleButton.IsChecked=true -> :checked -->
          <Style Selector="^:checked /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Sidebar.SelectionActive.Background}" />
          </Style>
          <!-- IsChecked=false trigger is the default (unchecked) state; Background defaults to Sidebar.Static.Background -->
          <!-- Converted from ControlTemplate.Triggers: ButtonBase.IsPressed=true -> :pressed -->
          <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Sidebar.Static.Background}" />
          </Style>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SidebarPathImageRadioButtonStyle" Selector="RadioButton">
    <Setter Property="Margin" Value="0,1,0,1" />
    <Setter Property="Padding" Value="5,2,5,2" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" x:Name="border">
            <Path Height="16" Width="16" Margin="{TemplateBinding Padding}" Focusable="False" Data="{TemplateBinding Content}" Fill="{DynamicResource IconBrush}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ImagePath" />
          </Border>
          <!-- Converted from ControlTemplate.Triggers: DataTrigger IsChecked (RelativeSource Self)=True -> :checked -->
          <Style Selector="^:checked /template/ Path#ImagePath">
            <Setter Property="Fill" Value="{DynamicResource SystemAccentBrush}" />
          </Style>
          <!-- Converted from ControlTemplate.Triggers: IsMouseOver=true -> :pointerover -->
          <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Button.MouseOver.Background}" />
          </Style>
          <!-- Converted from ControlTemplate.Triggers: IsPressed=true -> :pressed -->
          <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Button.Pressed.Background}" />
          </Style>
          <!-- Converted from ControlTemplate.Triggers: IsEnabled=false -> :disabled -->
          <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Background" Value="#00FFFFFF" />
          </Style>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Phase 4.5 cleanup: 9 DataTemplate.Triggers blocks migrated to top-level Styles + bindings.
       Strategy A (ancestor TreeViewItem state → top-level Style Selector):
         :pointerover → FilterButton/HideButton/PinButton visible (default hidden via StyleSetter).
         :selected:focus-within → primary Image.Source switches to *SelectedIcon (default via StyleSetter).
       Strategy B (VM properties → direct binding + converter):
         LocalBranch.IsActive/Worktree.IsActive → TitleTextBlock.FontWeight (BoolToFontWeightConverter).
       Note: default Source/IsVisible moved out of DataTemplate attributes into StyleSetters so that
       :pointerover / :selected:focus-within StyleTriggers can override them (StyleTrigger > StyleSetter). -->
  <Style Selector="controls:TreeViewControlItem Button#FilterButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls:TreeViewControlItem:pointerover Button#FilterButton">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="controls:TreeViewControlItem Button#HideButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls:TreeViewControlItem:pointerover Button#HideButton">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="controls:TreeViewControlItem Button#PinButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls:TreeViewControlItem:pointerover Button#PinButton">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="controls:TreeViewControlItem Image#RemoteBranchImage">
    <Setter Property="Source" Value="{DynamicResource BranchIcon}" />
  </Style>
  <Style Selector="controls:TreeViewControlItem:selected:focus-within Image#RemoteBranchImage">
    <Setter Property="Source" Value="{DynamicResource BranchSelectedIcon}" />
  </Style>
  <Style Selector="controls:TreeViewControlItem Image#StashImage">
    <Setter Property="Source" Value="{DynamicResource SidebarStashIcon}" />
  </Style>
  <Style Selector="controls:TreeViewControlItem:selected:focus-within Image#StashImage">
    <Setter Property="Source" Value="{DynamicResource SidebarStashSelectedIcon}" />
  </Style>
  <Style Selector="controls:TreeViewControlItem Image#SubmoduleImage">
    <Setter Property="Source" Value="{DynamicResource SubmoduleIcon}" />
  </Style>
  <Style Selector="controls:TreeViewControlItem:selected:focus-within Image#SubmoduleImage">
    <Setter Property="Source" Value="{DynamicResource SubmoduleSelectedIcon}" />
  </Style>
  <Style Selector="controls:TreeViewControlItem Image#WorktreeImage">
    <Setter Property="Source" Value="{DynamicResource WorktreeIcon}" />
  </Style>
  <Style Selector="controls:TreeViewControlItem:selected:focus-within Image#WorktreeImage">
    <Setter Property="Source" Value="{DynamicResource WorktreeSelectedIcon}" />
  </Style>
  <Style Selector="controls:TreeViewControlItem Image#TagImage">
    <Setter Property="Source" Value="{DynamicResource TagIcon}" />
  </Style>
  <Style Selector="controls:TreeViewControlItem:selected:focus-within Image#TagImage">
    <Setter Property="Source" Value="{DynamicResource TagSelectedIcon}" />
  </Style>
  <DataTemplate DataType="{x:Type ui:SidebarGroupItem}">
    <TextBlock VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" FontWeight="Medium" FontSize="13.5">
      <TextBlock.Text>
        <Binding Path="Title" />
      </TextBlock.Text>
    </TextBlock>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:RemoteSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16">
        <Image.Source>
          <Binding Path="Remote.Icon" />
        </Image.Source>
      </Image>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <TextBlock.ToolTip.Tip>
          <Binding Path="Tooltip" />
        </TextBlock.ToolTip.Tip>
      </TextBlock>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:FilterableRemoteSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16">
        <Image.Source>
          <Binding Path="Remote.Icon" />
        </Image.Source>
      </Image>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <TextBlock.ToolTip.Tip>
          <Binding Path="Tooltip" />
        </TextBlock.ToolTip.Tip>
      </TextBlock>
      <Button Grid.Column="2" x:Name="FilterButton">
        <Button.ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource BranchFilterOnIcon}" x:Name="FilterButtonImage" />
      </Button>
      <Button Grid.Column="3" x:Name="HideButton">
        <Button.ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource HideBranchOnIcon}" x:Name="HideButtonImage" />
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:FolderSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Source="{DynamicResource SidebarFolderIcon}" Height="16" Width="16" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
      </TextBlock>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:FilterableFolderSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Source="{DynamicResource SidebarFolderIcon}" Height="16" Width="16" Margin="2,0,0,0" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
      </TextBlock>
      <Button Grid.Column="2" x:Name="FilterButton">
        <Button.ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource BranchFilterOnIcon}" x:Name="FilterButtonImage" />
      </Button>
      <Button Grid.Column="3" x:Name="HideButton">
        <Button.ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource HideBranchOnIcon}" x:Name="HideButtonImage" />
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:TruncateSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" FontSize="13" Margin="4,0,0,0" Padding="0" VerticalAlignment="Center">
        <Hyperlink NavigateUri=" ">
          <TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch">
            <TextBlock.Text>
              <Binding Path="Title" />
            </TextBlock.Text>
          </TextBlock>
        </Hyperlink>
      </TextBlock>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:TagSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16" x:Name="TagImage" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" ToolTip.Tip="" x:Name="TagTitleTextBlock">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
      </TextBlock>
      <Button Grid.Column="2" x:Name="PinButton">
        <Button.ToolTip.Tip>
          <Binding Path="PinTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource PinOnIcon}" x:Name="PinButtonImage" />
      </Button>
      <Button Grid.Column="3" x:Name="FilterButton">
        <Button.ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource BranchFilterOnIcon}" x:Name="FilterButtonImage" />
      </Button>
      <Button Grid.Column="4" x:Name="HideButton">
        <Button.ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource SearchOnIcon}" x:Name="HideButtonImage" />
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:RemoteBranchSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16" x:Name="RemoteBranchImage" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="TitleTextBlock">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <TextBlock.ToolTip.Tip>
          <Binding Path="Tooltip" />
        </TextBlock.ToolTip.Tip>
      </TextBlock>
      <Button Grid.Column="2" x:Name="PinButton">
        <Button.ToolTip.Tip>
          <Binding Path="PinTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource PinOnIcon}" x:Name="PinButtonImage" />
      </Button>
      <Button Grid.Column="3" x:Name="FilterButton">
        <Button.ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource BranchFilterOnIcon}" x:Name="FilterButtonImage" />
      </Button>
      <Button Grid.Column="4" x:Name="HideButton">
        <Button.ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource HideBranchOnIcon}" x:Name="HideButtonImage" />
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:LocalBranchSidebarItem}">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16" x:Name="BranchImage">
        <Image.Source>
          <Binding Path="UpstreamStatus"><Binding.Converter><ui:UpstreamStatusToImageConverter /></Binding.Converter></Binding>
        </Image.Source>
      </Image>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" FontWeight="{Binding LocalBranch.IsActive, Converter={controls:BoolToFontWeightConverter TrueWeight=Bold}}" x:Name="TitleTextBlock">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <TextBlock.ToolTip.Tip>
          <Binding Path="Tooltip" />
        </TextBlock.ToolTip.Tip>
      </TextBlock>
      <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,2,0">
        <TextBlock.Text>
          <Binding Path="UpstreamStatusString" />
        </TextBlock.Text>
      </TextBlock>
      <Button Grid.Column="3" x:Name="PinButton">
        <Button.ToolTip.Tip>
          <Binding Path="PinTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource PinOnIcon}" x:Name="PinButtonImage" />
      </Button>
      <Button Grid.Column="4" x:Name="FilterButton">
        <Button.ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource BranchFilterOnIcon}" x:Name="FilterButtonImage" />
      </Button>
      <Button Grid.Column="5" x:Name="HideButton">
        <Button.ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </Button.ToolTip.Tip>
        <Image Source="{DynamicResource HideBranchOnIcon}" x:Name="HideButtonImage" />
      </Button>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:StashSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16" x:Name="StashImage" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <TextBlock.ToolTip.Tip>
          <Binding Path="Tooltip" />
        </TextBlock.ToolTip.Tip>
      </TextBlock>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:SubmoduleSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16" x:Name="SubmoduleImage" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
      </TextBlock>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:WorktreeSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16" x:Name="WorktreeImage" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" FontWeight="{Binding Worktree.IsActive, Converter={controls:BoolToFontWeightConverter TrueWeight=Bold}}" x:Name="TitleTextBlock">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <TextBlock.ToolTip.Tip>
          <Binding Path="Tooltip" />
        </TextBlock.ToolTip.Tip>
      </TextBlock>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type ui:MainWorktreeSidebarItem}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16" x:Name="WorktreeImage" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" FontWeight="{Binding Worktree.IsActive, Converter={controls:BoolToFontWeightConverter TrueWeight=Bold}}" x:Name="TitleTextBlock">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <TextBlock.ToolTip.Tip>
          <Binding Path="Tooltip" />
        </TextBlock.ToolTip.Tip>
      </TextBlock>
    </Grid>
  </DataTemplate>
</ResourceDictionary>