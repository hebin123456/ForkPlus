    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border SnapsToDevicePixels="true">
            <Grid>
              <Rectangle RadiusX="3" RadiusY="3" Height="18" Width="20" Margin="{TemplateBinding Padding}" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2.5" x:Name="Rectangle" />
              <Path Data="{DynamicResource CloseGeometry}" Height="10" Width="10" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False" SnapsToDevicePixels="True" Fill="#FFFFFFFF" x:Name="ClearIcon" />
            </Grid>
          </Border>
          <!-- Converted from ControlTemplate.Triggers: IsChecked=true -> :checked -->
          <Style Selector="^:checked /template/ Rectangle#Rectangle">
            <Setter Property="Stroke" Value="{DynamicResource SystemAccentBrush}" />
          </Style>
          <!-- Converted from ControlTemplate.Triggers MultiTrigger (IsChecked + IsMouseOver) -> :checked:pointerover -->
          <Style Selector="^:checked:pointerover /template/ Path#ClearIcon">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
