    <!-- 阶段 6 关键修复：在 Avalonia 11 中，<Style Selector="Button"> 的类型选择器会匹配所有
         Button 派生类（包括 ToolbarButton）。如果 Style 包含 Template setter，会覆盖派生类
         ControlTheme 的 Template，导致 ToolbarButton 丢失 Title TextBlock、DropDownButton
         丢失自定义模板等。修复：将 Template 移到 ControlTheme 中（ControlTheme 按 StyleKey
         精确匹配类型，不会影响派生类），Style 仅保留属性 setter 和伪类样式。 -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
              <DockPanel>
                <Border DockPanel.Dock="Bottom" Height="1" Margin="0,0,0,-1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="{DynamicResource Button.Static.Shadow}" IsVisible="True" x:Name="ShadowBorder" />
                <ContentPresenter Focusable="False" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ContentPresenter">
                </ContentPresenter>
              </DockPanel>
            </Border>
          </ControlTemplate>
