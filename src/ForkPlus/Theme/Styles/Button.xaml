    </Style>
    <Setter Property="Background" Value="{DynamicResource ToolbarButton.Static.Background}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="8,0,8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ToolbarDropDownButton">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <StackPanel>
              <Grid Width="42">
                <ContentPresenter Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="contentPresenter" />
                <Path HorizontalAlignment="Center" Margin="32,3,0,0" VerticalAlignment="Center" Fill="{DynamicResource ToolbarForeground}" Data="{DynamicResource ArrowGeometry}">
                  <Path.IsVisible>
                    <Binding Path="IsArrowVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                  </Path.IsVisible>
                </Path>
              </Grid>
              <TextBlock Text="{TemplateBinding Title}" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Button">
    <!-- Migration note: 原 WPF <Style.Resources><Style TargetType="TextBlock"> 定义 Button 内所有
         TextBlock 后代隐式应用 TextTrimming=CharacterEllipsis。Avalonia 等价写法是嵌套 Style 使用
         "^ TextBlock" 后代选择器（^ 引用父 Style 的目标 = Button）。不带 ^ 的子 Style 会触发
         "Child styles must have a nesting selector" 编译错误。 -->
    <Style Selector="^ TextBlock">
