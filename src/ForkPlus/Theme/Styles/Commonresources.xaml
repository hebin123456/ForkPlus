<!-- Migration Notes (WPF -> Avalonia):
     - Root xmlns set to https://github.com/avaloniaui; removed duplicate xmlns:x on child elements.
     - Style TargetType="T" -> Selector="T"; x:Key values preserved.
       Namespaced types use the Avalonia | selector syntax: TargetType="editor:CodeEditor"
       -> Selector="editor|CodeEditor", TargetType="controls:EditableTextBlock"
       -> Selector="controls|EditableTextBlock", etc.
     - Property prefixes stripped: Panel.Background -> Background, TextElement.Foreground -> Foreground,
       TextElement.FontFamily -> FontFamily, TextElement.FontSize -> FontSize, Control.Template -> Template,
       FrameworkElement.Height -> Height, FrameworkElement.Width -> Width,
       FrameworkElement.HorizontalAlignment -> HorizontalAlignment, FrameworkElement.VerticalAlignment -> VerticalAlignment,
       FrameworkElement.Margin -> Margin, FrameworkElement.FocusVisualStyle -> FocusVisualStyle,
       FrameworkElement.OverridesDefaultStyle -> OverridesDefaultStyle, Border.BorderBrush -> BorderBrush,
       Border.BorderThickness -> BorderThickness, Control.Padding -> Padding, TextElement.FontWeight -> FontWeight,
       ToolTip.HasDropShadow -> HasDropShadow, UIElement.Effect -> Effect.
     - TemplateBinding class prefixes stripped ({TemplateBinding Background} -> {TemplateBinding Background},
       {TemplateBinding Padding} -> {TemplateBinding Padding}, {TemplateBinding Width}
       -> {TemplateBinding Width}, {TemplateBinding Height} -> {TemplateBinding Height},
       {TemplateBinding BorderBrush} -> {TemplateBinding BorderBrush},
       {TemplateBinding BorderThickness} -> {TemplateBinding BorderThickness}).
     - Custom attached properties preserved (controls:GitPointView.IconMargin, ScrollViewer.HorizontalScrollBarVisibility,
       KeyboardNavigation.IsTabStop).
     - CodeEditor ControlTemplate.Triggers (WordWrap=True -> PART_ScrollViewer HorizontalScrollBarVisibility=Disabled)
       has no Avalonia pseudoclass for WordWrap; left as NOTE comment.
     - ToolTip ControlTemplate.Triggers (ToolTip.HasDropShadow=True -> Margin=10 + Border Effect) has no
       Avalonia pseudoclass for HasDropShadow; left as NOTE comment. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:editor="clr-namespace:ForkPlus.UI.Controls.Editor" xmlns:usercontrols="clr-namespace:ForkPlus.UI.UserControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <PopupAnimation x:Key="{x:StaticExtension SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>
  <controls:LevelToIndentationConverter x:Key="LevelToIndentation" />
  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  <controls:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
  <Style x:Key="CodeEditor" Selector="editor|CodeEditor">
    <Setter Property="Background" Value="{DynamicResource CodeEditorBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource CodeEditorForeground}" />
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="13.0" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid ClipToBounds="True" Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" x:Name="SearchPanelPlaceholder" />
            <controls:TouchpadAwareScrollViewer Background="{TemplateBinding Background}" Grid.Row="1" Focusable="False" ContentTemplate="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" ScrollViewer.HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="{TemplateBinding Padding}" x:Name="PART_ScrollViewer">
              <controls:TouchpadAwareScrollViewer.Content>
                <Binding Path="TextArea">
                  <Binding.RelativeSource>
                    <RelativeSource Mode="TemplatedParent" />
                  </Binding.RelativeSource>
                </Binding>
              </controls:TouchpadAwareScrollViewer.Content>
            </controls:TouchpadAwareScrollViewer>
            <usercontrols:CodeEditorSearchPanelUserControl Grid.RowSpan="2" x:Name="PART_SearchPanelUserControl">
              <usercontrols:CodeEditorSearchPanelUserControl.SearchPanelPlaceholder>
                <Binding ElementName="SearchPanelPlaceholder" />
              </usercontrols:CodeEditorSearchPanelUserControl.SearchPanelPlaceholder>
            </usercontrols:CodeEditorSearchPanelUserControl>
            <Canvas Grid.Row="1" Width="10" HorizontalAlignment="Right" IsHitTestVisible="False">
              <Path Fill="#CCD18281" x:Name="SrcBlockPath" />
              <Path Fill="#CC90C494" x:Name="DstBlockPath" />
            </Canvas>
          </Grid>
          <!-- NOTE (Avalonia limitation): ControlTemplate.Triggers WordWrap=True -> PART_ScrollViewer HorizontalScrollBarVisibility=Disabled.
               Avalonia CodeEditor has no :wordwrap pseudoclass; reimplement using a custom pseudoclass toggled
               from code-behind when WordWrap changes, or apply the value directly via a binding. -->
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusVisual">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OptionMarkFocusVisual">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="0" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GridSplitter" Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style x:Key="HorizontalGridSplitter" Selector="GridSplitter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
    <Setter Property="Margin" Value="0,-2,0,-2" />
    <Setter Property="Height" Value="5" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Background="#00FFFFFF">
            <Border BorderBrush="{TemplateBinding BorderBrush}" Height="1" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="VerticalGridSplitter" Selector="GridSplitter">
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
    <Setter Property="Margin" Value="-2,0,-2,0" />
    <Setter Property="Width" Value="5" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Background="#00FFFFFF">
            <Border BorderBrush="{TemplateBinding BorderBrush}" Width="1" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Separator" Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style x:Key="CheckBox" Selector="CheckBox">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="EditableTextBlock" Selector="controls|EditableTextBlock">
    <Setter Property="Height" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
<Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <TextBlock Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalAlignment}" TextTrimming="CharacterEllipsis">
            <TextBlock.Text>
              <Binding Path="Value">
                <Binding.RelativeSource>
                  <RelativeSource Mode="TemplatedParent" />
                </Binding.RelativeSource>
              </Binding>
            </TextBlock.Text>
            <TextBlock.IsVisible>
              <Binding Path="IsInEditMode" Converter="{StaticResource InverseBooleanToVisibility}">
                <Binding.RelativeSource>
                  <RelativeSource Mode="TemplatedParent" />
                </Binding.RelativeSource>
              </Binding>
            </TextBlock.IsVisible>
          </TextBlock>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CommandTextBox" Selector="controls|CommandTextBox">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" x:Name="PART_LabelsStackPanel" />
            <controls:PlaceholderTextBox Margin="2,0,0,0" BorderThickness="{TemplateBinding BorderThickness}" FontSize="{TemplateBinding FontSize}" Placeholder="Command" x:Name="PART_PlaceholderTextBox">
              <controls:PlaceholderTextBox.Text>
                <Binding Path="Text">
                  <Binding.RelativeSource>
                    <RelativeSource Mode="TemplatedParent" />
                  </Binding.RelativeSource>
                </Binding>
              </controls:PlaceholderTextBox.Text>
            </controls:PlaceholderTextBox>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BindableGitPointView" Selector="controls|BindableGitPointView">
    <Setter Property="controls:GitPointView.IconMargin" Value="4,3,4,1" />
  </Style>
  <Style x:Key="ToolTip" Selector="ToolTip">
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ComboBox.Popup.BorderBrush}" />
    <Setter Property="Padding" Value="6,2,6,3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Padding="{TemplateBinding Padding}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="3" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" x:Name="Border">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top" />
          </Border>
          <!-- NOTE (Avalonia limitation): ControlTemplate.Triggers ToolTip.HasDropShadow=True -> Margin=10 on templated parent +
               Border#Border Effect=DropShadowEffect. Avalonia ToolTip has no :dropshadow pseudoclass;
               reimplement using a custom pseudoclass toggled from code-behind, or apply the drop shadow
               unconditionally / via a binding on HasDropShadow. Original logic:
                 <Setter Property="Margin" Value="10" />
                 <Setter TargetName="Border" Property="Effect">
                   <DropShadowEffect BlurRadius="10" Color="{DynamicResource DropShadowColor}" Opacity="0.2" />
                 </Setter> -->
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ContentControl" Selector="ContentControl">
</Style>
</ResourceDictionary>
