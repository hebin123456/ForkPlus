<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  
  <controls:ResizeModeToVisibilityConverter x:Key="ResizeModeToVisibilityConverter" />
  <StreamGeometry x:Key="MinimizeGeometry">M0,0 L10,0 10,1.0 10,1.0 1,1.0 0,1.0 z</StreamGeometry>
  <StreamGeometry x:Key="MaximizeGeometry">M1,1 L1,11 11,11 11,1 z M0,0 L12,0 12,12 0,12 z</StreamGeometry>
  <StreamGeometry x:Key="RestoreGeometry">M1,4.56 L1,14.56 11,14.56 11,4.56z M4.0,1 L4.0,3.56 12,3.56 12,11 14.0,11 14.0,1 z M3.0,0 L15.0,0 15.0,12 12,12 12,15.56 0,15.56 0,3.56 3.0,3.56 z</StreamGeometry>
  <StreamGeometry x:Key="CloseGeometry">M0.71,0 L4.6,3.8 8.5,0 9.2,0.71 5.3,4.6 9.2,8.48 8.48,9.2 4.6,5.3 0.71,9.2 0,8.48 3.89,4.6 4.77E-07,0.71 z</StreamGeometry>
  <ControlTheme x:Key="WindowPathStyle" TargetType="Path">
    <Setter Property="Height" Value="10" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Stretch" Value="Uniform" />
    
    <Setter Property="Fill" Value="{DynamicResource Window.Button.Static.Foreground}" />
    
  
    <Style Selector="^:pointerover">
        <Setter Property="Fill" Value="{DynamicResource Window.Button.MouseOver.Foreground}" />
    </Style></ControlTheme>
  <ControlTheme x:Key="WindowCloseButtonPathStyle" TargetType="Path">
    <Setter Property="Height" Value="10" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Stretch" Value="Uniform" />
    
    <Setter Property="Fill" Value="{DynamicResource Window.Button.Static.Foreground}" />
    
  
    <Style Selector="^:pointerover">
        <Setter Property="Fill" Value="#FFFFFFFF" />
    </Style></ControlTheme>
  <ControlTheme x:Key="WindowButton" TargetType="Button">
    <Setter Property="Height" Value="26" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Background" Value="{DynamicResource Window.Button.Static.Background}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" x:Name="border">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"  ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover /template/ Border#border">
        <Setter Value="{DynamicResource Window.Button.MouseOver.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pressed /template/ Border#border">
        <Setter Value="{DynamicResource Window.Button.Pressed.Background}" Property="Background" />
    </Style></ControlTheme>
  <ControlTheme x:Key="WindowRoundedButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
    <Setter Property="Margin" Value="0,2,6,0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="3" x:Name="border">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"  ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover /template/ Border#border">
        <Setter Value="{DynamicResource Window.Button.MouseOver.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pressed /template/ Border#border">
        <Setter Value="{DynamicResource Window.Button.Pressed.Background}" Property="Background" />
    </Style></ControlTheme>
  <ControlTheme x:Key="WindowToggleButton" TargetType="ToggleButton">
    <Setter Property="Height" Value="26" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Background" Value="{DynamicResource Window.Button.Static.Background}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" x:Name="border">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"  ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover /template/ Border#border">
        <Setter Value="{DynamicResource Window.Button.MouseOver.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pressed /template/ Border#border">
        <Setter Value="{DynamicResource Window.Button.Pressed.Background}" Property="Background" />
    </Style>
    <Style Selector="^:disabled /template/ Border#border">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Background" Value="#00FFFFFF" />
    </Style></ControlTheme>
  <ControlTheme x:Key="WindowRoundedToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource WindowToggleButton}">
    <Setter Property="Margin" Value="0,2,6,0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" CornerRadius="3" x:Name="border">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"  ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover /template/ Border#border">
        <Setter Value="{DynamicResource Window.Button.MouseOver.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pressed /template/ Border#border">
        <Setter Value="{DynamicResource Window.Button.Pressed.Background}" Property="Background" />
    </Style>
    <Style Selector="^:disabled /template/ Border#border">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Background" Value="#00FFFFFF" />
    </Style></ControlTheme>
  <ControlTheme x:Key="WindowCloseButton" TargetType="Button">
    <Setter Property="Height" Value="26" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Background" Value="{DynamicResource Window.CloseButton.Static.Background}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" x:Name="border">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"  ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover /template/ Border#border">
        <Setter Value="{DynamicResource Window.CloseButton.MouseOver.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pressed /template/ Border#border">
        <Setter Value="{DynamicResource Window.CloseButton.Pressed.Background}" Property="Background" />
    </Style></ControlTheme>
  <ControlTheme x:Key="{x:Type ui:CustomWindow}" TargetType="ui:CustomWindow">
    <Setter Property="Background" Value="{DynamicResource Window.BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Window.Foreground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="240" />
    <Setter Property="MinHeight" Value="80" />
    
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:CustomWindow">
          <Border BorderThickness="{TemplateBinding ui:CustomWindow.WindowResizeBorderThickness}">
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
              <!-- 窗口菜单"放大/缩小"：WPF 原版此处 Grid 有 LayoutTransform="{DynamicResource
                   LayoutScaleTransform}"；Avalonia 用 LayoutTransformControl 实现等效布局缩放。 -->
              <LayoutTransformControl LayoutTransform="{DynamicResource LayoutScaleTransform}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource Window.TitleBar.Background}" BorderThickness="0" Padding="0" x:Name="PART_WindowHeader">
                  <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                      <Button x:Name="PART_MinimizeButton" Theme="{DynamicResource WindowButton}">
                        <Path Data="{StaticResource MinimizeGeometry}" Theme="{DynamicResource WindowPathStyle}" />
                      </Button>
                      <Button x:Name="PART_RestoreButton" Theme="{DynamicResource WindowButton}">
                        <Path Data="{StaticResource RestoreGeometry}" Theme="{DynamicResource WindowPathStyle}" />
                      </Button>
                      <Button x:Name="PART_MaximizeButton" Theme="{DynamicResource WindowButton}">
                        <Path Data="{StaticResource MaximizeGeometry}" Theme="{DynamicResource WindowPathStyle}" />
                      </Button>
                      <Button x:Name="PART_CloseButton" Theme="{DynamicResource WindowCloseButton}">
                        <Path Data="{StaticResource CloseGeometry}" Theme="{DynamicResource WindowCloseButtonPathStyle}" />
                      </Button>
                    </StackPanel>
                    <Border Background="{DynamicResource Window.TitleBar.Background}">
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{TemplateBinding Icon}" />
                        <ContentControl Content="{TemplateBinding Title}" Foreground="{TemplateBinding Foreground}">
                          <Label.IsVisible>
                            <Binding Path="IsTitleVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                          </Label.IsVisible>
                        </ContentControl>
                      </StackPanel>
                    </Border>
                  </DockPanel>
                </Border>
                <!-- Bug 修复（2026-09-04，"颜色管理器面板弹出来不对"的深层根因）：模板缺
                     VisualLayerManager，且必须命名为 PART_VisualLayerManager——
                     TopLevel.OnApplyTemplate 经 e.NameScope.Find("PART_VisualLayerManager")
                     取回它，随后 Window.OnApplyTemplate 的 EnableVisualLayerManagerLayers()
                     把 EnableOverlayLayer / EnablePopupOverlayLayer（internal，XAML 无法直接设）
                     / EnableTextSelectorLayer 全部置 true。Popup/Tooltip/ComboBox 下拉在无平台
                     IPopupImpl 的环境（headless/部分平台）回退 PopupOverlayLayer 路径时靠它宿主，
                     缺名或缺控件都直接抛 "Unable to create IPopupImpl and no overlay layer is
                     found"（与 Avalonia 内置 Fluent Window 模板一致）。 -->
                <VisualLayerManager x:Name="PART_VisualLayerManager" Grid.Row="1">
                  <ContentPresenter Content="{TemplateBinding Content}" ClipToBounds="True"  ContentTemplate="{TemplateBinding ContentTemplate}" />
                </VisualLayerManager>
    <!-- Migration note：WPF ResizeGrip 已删（Avalonia 窗口缩放由系统边框处理；自绘 chrome 需 CustomWindow 自己实现） -->
              </Grid>
              </LayoutTransformControl>
            </Border>
          </Border>

        </ControlTemplate>
      </Setter.Value>
    </Setter>

<!-- Migration note：WPF 选择器 ^[ResizeMode=CanResizeWithGrip][WindowState=Normal] /template/ ResizeGrip#ResizeGrip 无对应 Avalonia 属性，样式块注释化。原始片段：
    <Style Selector="^[ResizeMode=CanResizeWithGrip][WindowState=Normal] /template/ ResizeGrip#ResizeGrip">
        <Setter Property="IsVisible" Value="True" />
    </Style>-->
</ControlTheme>
  <ControlTheme x:Key="ForkPlusDialogWindowStyle" TargetType="dialogs:ForkPlusDialogWindow" BasedOn="{StaticResource {x:Type ui:CustomWindow}}">
    <Setter Property="ui:CustomWindow.HideMinimizeMaximizeButtons" Value="True" />
    <Setter Property="Background" Value="{DynamicResource Window.Dialog.Background}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:CustomWindow">
          <Border BorderThickness="{TemplateBinding ui:CustomWindow.WindowResizeBorderThickness}">
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
              <!-- 窗口菜单"放大/缩小"：同主窗口模板，WPF 原版此 Grid 有
                   LayoutTransform="{DynamicResource LayoutScaleTransform}"。 -->
              <LayoutTransformControl LayoutTransform="{DynamicResource LayoutScaleTransform}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource Window.Dialog.Background}" BorderThickness="0" Padding="0" x:Name="PART_WindowHeader">
                  <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                      <Button x:Name="PART_MinimizeButton" Theme="{DynamicResource WindowButton}">
                        <Path Data="{StaticResource MinimizeGeometry}" Theme="{DynamicResource WindowPathStyle}" />
                      </Button>
                      <Button x:Name="PART_RestoreButton" Theme="{DynamicResource WindowButton}">
                        <Path Data="{StaticResource RestoreGeometry}" Theme="{DynamicResource WindowPathStyle}" />
                      </Button>
                      <Button x:Name="PART_MaximizeButton" Theme="{DynamicResource WindowButton}">
                        <Path Data="{StaticResource MaximizeGeometry}" Theme="{DynamicResource WindowPathStyle}" />
                      </Button>
                      <Button x:Name="PART_CloseButton" Theme="{DynamicResource WindowCloseButton}">
                        <Path Data="{StaticResource CloseGeometry}" Theme="{DynamicResource WindowCloseButtonPathStyle}" />
                      </Button>
                    </StackPanel>
                    <Border>
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{TemplateBinding Icon}" />
                        <ContentControl Content="{TemplateBinding Title}" Foreground="{TemplateBinding Foreground}">
                          <Label.IsVisible>
                            <Binding Path="IsTitleVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                          </Label.IsVisible>
                        </ContentControl>
                      </StackPanel>
                    </Border>
                  </DockPanel>
                </Border>
                <!-- Bug 修复（2026-09-04）：同 CustomWindow 模板——补 VisualLayerManager 且必须
                     命名 PART_VisualLayerManager（TopLevel 经该名查找，Window.OnApplyTemplate 的
                     EnableVisualLayerManagerLayers 会启用 internal 的 EnablePopupOverlayLayer），
                     对话框内 Popup（颜色选择器等）才能在 OverlayLayer 回退路径下打开。 -->
                <VisualLayerManager x:Name="PART_VisualLayerManager" Grid.Row="1">
                  <ContentPresenter Content="{TemplateBinding Content}" ClipToBounds="True"  ContentTemplate="{TemplateBinding ContentTemplate}" />
                </VisualLayerManager>
    <!-- Migration note：WPF ResizeGrip 已删（Avalonia 窗口缩放由系统边框处理；自绘 chrome 需 CustomWindow 自己实现） -->
              </Grid>
              </LayoutTransformControl>
            </Border>
          </Border>

        </ControlTemplate>
      </Setter.Value>
    </Setter>

<!-- Migration note：WPF 选择器 ^[ResizeMode=CanResizeWithGrip][WindowState=Normal] /template/ ResizeGrip#ResizeGrip 无对应 Avalonia 属性，样式块注释化。原始片段：
    <Style Selector="^[ResizeMode=CanResizeWithGrip][WindowState=Normal] /template/ ResizeGrip#ResizeGrip">
        <Setter Property="IsVisible" Value="True" />
    </Style>-->
</ControlTheme>
</ResourceDictionary>