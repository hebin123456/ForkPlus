<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="{x:Type controls:PlaceholderTextBox}" TargetType="controls:PlaceholderTextBox">
    <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
    <!-- Migration note（2026-09-03，"git 错误弹窗选中内容没有选中样式"根因，同 Textbox.axaml）：
         WPF 默认选区为系统高亮蓝底白字；迁移后未设置且模板未传递，选区无高亮。对齐原版。
         2026-09-04（"重命名仓库时选中颜色不对"）：AccentBrush → 全皮肤固定选区蓝
         TextBox.Selection.*（浅色 accent 皮肤白字不可读），见 Brushes.axaml 注释。 -->
    <Setter Property="SelectionBrush" Value="{DynamicResource TextBox.Selection.Background}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextBox.Selection.Foreground}" />
    <!-- Migration note（2026-09-04，"字和左/上边框贴得太紧"，同 Textbox.axaml）：模板未把
         Padding 下传 TextPresenter，显式 Padding 对文字无效。主题默认 2,1 + Margin 下传。 -->
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />

<!-- Migration note：WPF Setter Property=AllowDrop 已删（Avalonia 无该属性/值） -->
<!-- Migration note：WPF 专有属性 Setter 已删（Avalonia 无此属性） -->
<!-- Migration note：WPF 专有属性 Setter 已删（Avalonia 无此属性） -->
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:PlaceholderTextBox">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <Grid Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Source="{TemplateBinding controls:PlaceholderTextBox.Icon}" Height="14" Width="14" Margin="4,0,0,0" x:Name="IconElement" />
              <TextPresenter x:Name="PART_TextPresenter" Grid.Column="1" Margin="{TemplateBinding Padding}" Text="{TemplateBinding Text}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" CaretIndex="{TemplateBinding CaretIndex}" PasswordChar="{TemplateBinding PasswordChar}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" />
              <TextBlock Grid.Column="1" Padding="{TemplateBinding Padding}" IsHitTestVisible="False" FontSize="{TemplateBinding FontSize}" Margin="2,0,0,0" Foreground="{TemplateBinding Foreground}" Opacity="0.56" Text="{TemplateBinding controls:PlaceholderTextBox.Placeholder}" x:Name="PlaceholderElement" IsVisible="False" />
            </Grid>
          </Border>

        </ControlTemplate>
      </Setter.Value>
    </Setter>
 
  
<!-- Migration note：WPF 选择器 ^[IsInactiveSelectionHighlightEnabled=true][IsSelectionActive=false] 无对应 Avalonia 属性，样式块注释化。原始片段：
    <Style Selector="^[IsInactiveSelectionHighlightEnabled=true][IsSelectionActive=false]">
        <Setter Property="SelectionBrush" Value="#FF9A9A9A" />
    </Style>-->

    <Style Selector="^:empty /template/ TextBlock#PlaceholderElement">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Border">
        <Setter Property="Opacity" Value="0.56" />
    </Style>
    <Style Selector="^:focus /template/ Border#Border">
        <Setter Value="{DynamicResource SystemAccentBrush}" Property="BorderBrush" />
    </Style>
    <!-- Migration note（2026-09-07 v3.14 修复）：原 WPF Trigger Property=Icon Value=Null →
         IconElement Collapsed（Auto 列折叠 0 宽）曾被注释丢弃——无图标时空 Image 14x14+
         Margin4 恒占位，左侧凭空 18px 留白（AI 偏好"推理服务 URL"等 128 处）。Avalonia 选择器
         无"属性=null"匹配 → 控件类维护 :noicon 伪类（见 PlaceholderTextBox.cs），此处折叠。 -->
    <Style Selector="^:noicon /template/ Image#IconElement">
        <Setter Property="IsVisible" Value="False" />
    </Style></ControlTheme>
  <ControlTheme x:Key="{x:Type controls:AutoCompleteTextBox}" TargetType="controls:AutoCompleteTextBox">
    <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
    <!-- Migration note（2026-09-03，选区高亮根因，同 PlaceholderTextBox）。
         2026-09-04（"重命名仓库时选中颜色不对"）：AccentBrush → 全皮肤固定选区蓝
         TextBox.Selection.*（浅色 accent 皮肤白字不可读），见 Brushes.axaml 注释。 -->
    <Setter Property="SelectionBrush" Value="{DynamicResource TextBox.Selection.Background}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextBox.Selection.Foreground}" />
    <!-- Migration note（2026-09-04，"字和左/上边框贴得太紧"，同上方 PlaceholderTextBox 主题）：
         本主题未 BasedOn PlaceholderTextBox（无 Padding 继承），补默认 Padding，模板经
         Margin="{TemplateBinding Padding}" 下传 TextPresenter，否则文字 0px 贴边框。 -->
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    
<!-- Migration note：WPF Setter Property=AllowDrop 已删（Avalonia 无该属性/值） -->
<!-- Migration note：WPF 专有属性 Setter 已删（Avalonia 无此属性） -->
<!-- Migration note：WPF 专有属性 Setter 已删（Avalonia 无此属性） -->
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:PlaceholderTextBox">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <Grid Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Source="{TemplateBinding controls:PlaceholderTextBox.Icon}" Height="14" Width="14" Margin="4,0,0,0" x:Name="IconElement" />
              <TextPresenter x:Name="PART_TextPresenter" Grid.Column="1" Margin="{TemplateBinding Padding}" Text="{TemplateBinding Text}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" CaretIndex="{TemplateBinding CaretIndex}" PasswordChar="{TemplateBinding PasswordChar}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" />
              <TextBlock Grid.Column="1" Padding="{TemplateBinding Padding}" IsHitTestVisible="False" FontSize="{TemplateBinding FontSize}" Margin="2,0,0,0" Foreground="{TemplateBinding Foreground}" Opacity="0.56" Text="{TemplateBinding controls:PlaceholderTextBox.Placeholder}" x:Name="PlaceholderElement" IsVisible="False" />
              <Popup Focusable="False" VerticalOffset="-3" HorizontalOffset="-8" x:Name="Popup" />
            </Grid>
          </Border>

        </ControlTemplate>
      </Setter.Value>
    </Setter>


<!-- Migration note：WPF 选择器 ^[IsInactiveSelectionHighlightEnabled=true][IsSelectionActive=false] 无对应 Avalonia 属性，样式块注释化。原始片段：
    <Style Selector="^[IsInactiveSelectionHighlightEnabled=true][IsSelectionActive=false]">
        <Setter Property="SelectionBrush" Value="#FF9A9A9A" />
    </Style>-->

    <Style Selector="^:empty /template/ TextBlock#PlaceholderElement">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Border">
        <Setter Property="Opacity" Value="0.56" />
    </Style>
    <Style Selector="^:focus /template/ Border#Border">
        <Setter Value="{DynamicResource SystemAccentBrush}" Property="BorderBrush" />
    </Style>
    <!-- Migration note（2026-09-07 v3.14 修复）：同上 PlaceholderTextBox 主题——Icon=null 时
         折叠 IconElement（:noicon 伪类由控件类维护），消除空图标列 18px 留白。 -->
    <Style Selector="^:noicon /template/ Image#IconElement">
        <Setter Property="IsVisible" Value="False" />
    </Style></ControlTheme>
  <ControlTheme x:Key="CommitPlaceholderTextBox" TargetType="controls:PlaceholderTextBox" BasedOn="{StaticResource {x:Type controls:PlaceholderTextBox}}">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="3,3,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:PlaceholderTextBox">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <Grid Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Source="{TemplateBinding controls:PlaceholderTextBox.Icon}" MaxHeight="15" Margin="2,0,-1,0" x:Name="iconElement" />
              <TextPresenter x:Name="PART_TextPresenter" Grid.Column="1" Margin="{TemplateBinding Padding}" Text="{TemplateBinding Text}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" CaretIndex="{TemplateBinding CaretIndex}" PasswordChar="{TemplateBinding PasswordChar}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" />
              <TextBlock Grid.Column="1" Padding="{TemplateBinding Padding}" IsHitTestVisible="False" FontSize="13" Margin="2,1,0,0" FontWeight="Normal" Foreground="{TemplateBinding Foreground}" Opacity="0.56" Text="{TemplateBinding controls:PlaceholderTextBox.Placeholder}" x:Name="placeholderElement" IsVisible="False" />
              <Popup Focusable="False" VerticalOffset="-3" HorizontalOffset="-8" x:Name="Popup" />
            </Grid>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:empty /template/ TextBlock#placeholderElement">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Migration note（2026-09-07 v3.14 修复）：原 WPF Trigger Icon=Null → iconElement Collapsed
         曾被注释丢弃。:noicon 伪类由控件类维护，此处折叠（部件名本主题为小写 iconElement）。 -->
    <Style Selector="^:noicon /template/ Image#iconElement">
        <Setter Property="IsVisible" Value="False" />
    </Style></ControlTheme>
  <ControlTheme x:Key="{x:Type controls:CommitDescriptionTextBox}" TargetType="controls:CommitDescriptionTextBox" BasedOn="{StaticResource {x:Type controls:PlaceholderTextBox}}">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="4,4,4,2" />
    <Setter Property="CornerRadius" Value="0,0,3,3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:CommitDescriptionTextBox">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <Grid Background="#00FFFFFF">
              <TextPresenter x:Name="PART_TextPresenter" Margin="{TemplateBinding Padding}" Text="{TemplateBinding Text}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" CaretIndex="{TemplateBinding CaretIndex}" PasswordChar="{TemplateBinding PasswordChar}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" />
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="1" Margin="{TemplateBinding controls:CommitDescriptionTextBox.GuideLineMargin}" HorizontalAlignment="Left" x:Name="PART_GuideLine" IsVisible="True" />
              <TextBlock Margin="2,0,0,0" Padding="{TemplateBinding Padding}" IsHitTestVisible="False" FontSize="{TemplateBinding FontSize}" FontFamily="Segoe UI" Foreground="{TemplateBinding Foreground}" Opacity="0.56" Text="{TemplateBinding controls:PlaceholderTextBox.Placeholder}" x:Name="placeholderElement" IsVisible="False" />
              <Popup Focusable="False" VerticalOffset="-3" HorizontalOffset="-8" x:Name="Popup" />
            </Grid>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:empty /template/ TextBlock#placeholderElement">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Padding" Value="4,2,4,3" />
    </Style>
    <Style Selector="^:empty /template/ Border#PART_GuideLine">
        <Setter Property="IsVisible" Value="False" />
    </Style></ControlTheme>
  <ControlTheme x:Key="{x:Type controls:ReferenceTextBox}" TargetType="controls:ReferenceTextBox" BasedOn="{StaticResource {x:Type controls:AutoCompleteTextBox}}" />
  <ControlTheme x:Key="{x:Type controls:SpellingPlaceholderTextBox}" TargetType="controls:SpellingPlaceholderTextBox" BasedOn="{StaticResource {x:Type controls:AutoCompleteTextBox}}" />
  <ControlTheme x:Key="SearchPanelPlaceholderTextBox" TargetType="controls:PlaceholderTextBox" BasedOn="{StaticResource {x:Type controls:PlaceholderTextBox}}">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="2,1,2,1" />
    
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:PlaceholderTextBox">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <Grid Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Source="{TemplateBinding controls:PlaceholderTextBox.Icon}" Height="14" Width="14" Margin="4,0,0,0" x:Name="IconElement" />
              <TextPresenter x:Name="PART_TextPresenter" Grid.Column="1" Margin="{TemplateBinding Padding}" Text="{TemplateBinding Text}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" CaretIndex="{TemplateBinding CaretIndex}" PasswordChar="{TemplateBinding PasswordChar}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" />
              <TextBlock Grid.Column="1" Padding="{TemplateBinding Padding}" IsHitTestVisible="False" FontSize="{TemplateBinding FontSize}" Margin="2,0,0,0" Foreground="{TemplateBinding Foreground}" Opacity="0.56" Text="{TemplateBinding controls:PlaceholderTextBox.Placeholder}" x:Name="PlaceholderElement" IsVisible="False" />
            </Grid>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:empty /template/ TextBlock#PlaceholderElement">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Border">
        <Setter Property="Opacity" Value="0.56" />
    </Style>
    <!-- Migration note（2026-09-07 v3.14 修复）：原 WPF Trigger Icon=Null → IconElement Collapsed
         曾被注释丢弃。:noicon 伪类由控件类维护，此处折叠（实际用法均带搜索图标，防御性补齐）。 -->
    <Style Selector="^:noicon /template/ Image#IconElement">
        <Setter Property="IsVisible" Value="False" />
    </Style></ControlTheme>
  <ControlTheme x:Key="{x:Type controls:FilterTextBox}" TargetType="controls:FilterTextBox" BasedOn="{StaticResource {x:Type controls:PlaceholderTextBox}}">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="controls:PlaceholderTextBox.Placeholder" Value="Filter" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="2,1,2,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:FilterTextBox">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <Border.RenderTransform>
              <TranslateTransform />
            </Border.RenderTransform>
            <Grid Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Source="{DynamicResource SearchOnIcon}" Width="13" Height="13" Margin="4,0,0,0" x:Name="PART_Icon" />
              <controls:DropDownButton HorizontalAlignment="Left" Height="20" Margin="0" Background="#00FFFFFF" BorderThickness="0" Focusable="False" x:Name="PART_DropDownButton" IsVisible="False">
<!-- Migration note：WPF controls:DropDownButton.FocusVisualStyle 块已删（Avalonia 无 FocusVisualStyle） -->

                <controls:DropDownButton.ContextMenu>
                  <ContextMenu />
                </controls:DropDownButton.ContextMenu>
                <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                  <Image Height="13" Width="13" Margin="4,0,0,0" Source="{DynamicResource SearchOnIcon}" x:Name="DropdownButtonImage" />
                  <Path Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{DynamicResource ArrowGeometry}" Fill="{DynamicResource AccentBrush}" x:Name="DropdownButtonPath" />
                </StackPanel>
              </controls:DropDownButton>
              <TextPresenter x:Name="PART_TextPresenter" Grid.Column="1" Margin="{TemplateBinding Padding}" Text="{TemplateBinding Text}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" CaretIndex="{TemplateBinding CaretIndex}" PasswordChar="{TemplateBinding PasswordChar}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" />
              <TextBlock Grid.Column="1" Padding="{TemplateBinding Padding}" IsHitTestVisible="False" FontSize="{TemplateBinding FontSize}" Margin="1,0,0,0" Foreground="{TemplateBinding Foreground}" Opacity="0.56" Text="{TemplateBinding controls:PlaceholderTextBox.Placeholder}" x:Name="placeholderElement" IsVisible="False" />
              <TextBlock Grid.Column="2" Text="?" Margin="4,-2,4,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" x:Name="HintTextBlock">
                <ToolTip.Tip>
                  <Binding Path="Hint"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:FilterTextBox}" /></Binding.RelativeSource></Binding>
                </ToolTip.Tip>
              </TextBlock>
              <Button Grid.Column="3" Margin="0,0,2,0" Height="16" Width="16" Padding="0" BorderThickness="0" Background="#00FFFFFF" x:Name="PART_ClearButton" Theme="{DynamicResource InlineButton}">
                <Image Source="{DynamicResource CancelSearchIcon}" Width="14" Height="14" VerticalAlignment="Center" />
              </Button>
            </Grid>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:empty /template/ TextBlock#placeholderElement">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:empty /template/ Button#PART_ClearButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:empty /template/ Image#PART_Icon">
        <Setter Value="{DynamicResource SearchIcon}" Property="Source" />
    </Style>
    <Style Selector="^:empty /template/ Image#DropdownButtonImage">
        <Setter Value="{DynamicResource SearchIcon}" Property="Source" />
    </Style>
    <Style Selector="^:empty /template/ Path#DropdownButtonPath">
        <Setter Value="{DynamicResource ComboBox.Static.Glyph}" Property="Fill" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Border">
        <Setter Property="Opacity" Value="0.56" />
    </Style>
    <Style Selector="^:focus /template/ Border#Border">
        <Setter Value="{DynamicResource TextBox.Static.Background}" Property="Background" />
        <Setter Value="{DynamicResource BorderBrush}" Property="BorderBrush" />
    </Style>
    <!--
      WPF migration note: 条件(controls:FilterTextBox.Hint=) 的部分条件/Setter 无选择器等价物（无伪类/匹配器、SourceName≠TargetName 或部件未找到），已注释保留待人工处理。
      原始片段：
      <Trigger Property="controls:FilterTextBox.Hint" xmlns="https://github.com/avaloniaui">
                    <Trigger.Value>
                      <x:Null xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                    </Trigger.Value>
                    <Setter TargetName="HintTextBlock" Property="IsVisible" Value="False" />
                  </Trigger>
    --></ControlTheme>
</ResourceDictionary>