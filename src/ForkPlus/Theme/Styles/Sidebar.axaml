<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="RepositoryTitleHyperlinkStyle" TargetType="HyperlinkButton">
    
<!-- Migration note：WPF Setter Property=TextDecorations 块注释化（HyperlinkButton 无此属性）。原始片段：
    <Setter Property="TextDecorations">
      <Setter.Value>
        <x:Null />
      </Setter.Value>
    </Setter>-->

    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />

    <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ReferenceBrush}" />
<!-- Migration note：WPF Setter Property=TextDecorations 已删（Avalonia 该类型无此属性） -->
    </Style></ControlTheme>
  <ControlTheme x:Key="SidebarButton" TargetType="RadioButton">
    
    <Setter Property="Background" Value="{DynamicResource Sidebar.Static.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="20 2 20 2" />
    <Setter Property="Margin" Value="2,0,2,0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}" CornerRadius="4" x:Name="border">
            <ContentPresenter Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="contentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:checked /template/ Border#border">
        <Setter Value="{DynamicResource Sidebar.SelectionActive.Background}" Property="Background" />
    </Style>
    <Style Selector="^:unchecked /template/ Border#border">
        <Setter Value="{DynamicResource Sidebar.Static.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pressed /template/ Border#border">
        <Setter Value="{DynamicResource Sidebar.Static.Background}" Property="Background" />
    </Style></ControlTheme>
  <ControlTheme x:Key="SidebarPathImageRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="Margin" Value="0,1,0,1" />
    <Setter Property="Padding" Value="5,2,5,2" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- Migration note：原重复 VerticalContentAlignment setter 已删（Avalonia 12 重复 setter 抛异常） -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" x:Name="border">
            <Path Height="16" Width="16" Margin="{TemplateBinding Padding}" Focusable="False" Data="{TemplateBinding Content}" Fill="{DynamicResource IconBrush}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ImagePath" />
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:checked /template/ Path#ImagePath">
        <Setter Value="{DynamicResource SystemAccentBrush}" Property="Fill" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#border">
        <Setter Value="{DynamicResource Button.MouseOver.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pressed /template/ Border#border">
        <Setter Value="{DynamicResource Button.Pressed.Background}" Property="Background" />
    </Style>
    <Style Selector="^:disabled /template/ Border#border">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Background" Value="#00FFFFFF" />
    </Style></ControlTheme>

  

  

  

  
  
</ResourceDictionary>