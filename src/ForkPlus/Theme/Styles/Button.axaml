<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:editorControl="clr-namespace:ForkPlus.UI.Controls.Editor" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  
  <StreamGeometry x:Key="ArrowGeometry">M6,0.919L3,3.919L0,0.919L0.841,0.081L3,2.24L5.159,0.081L6,0.919Z</StreamGeometry>
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    
    
    <Setter Property="Background" Value="{DynamicResource Button.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Button.Static.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Button.Foreground}" />
    <Setter Property="Margin" Value="4,2,4,2" />
    <Setter Property="Padding" Value="10,0,10,0" />
    <!-- 固定高度 24（边框 1+1 → 内槽 22px；13px 字行高 ≈17.3-18px）。
         ⚠️ 垂直 Padding 合计必须 ≤ 4px（槽 ≥ 18px）：WPF 原版同模板下文字溢出槽位
         但 WPF 不裁剪渲染（不可见）；Avalonia 会按槽位裁剪 → 文字底部被切
         （2026-09-05 "有些 button 里面的字下面被遮挡"）。需要更厚的按钮请用
         MinHeight 抬高，而不是加大垂直 Padding。 -->
    <Setter Property="Height" Value="24" />
    <Setter Property="MaxWidth" Value="400" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Height="1" Margin="0,0,0,-1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="{DynamicResource Button.Static.Shadow}" x:Name="ShadowBorder" IsVisible="True" />
              <ContentPresenter Focusable="False" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}">
                <ContentPresenter.Resources>
                  <ResourceDictionary>
                    <ControlTheme x:Key="{x:Type TextBlock}" TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </ControlTheme>
                  </ResourceDictionary>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </DockPanel>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^[IsDefault=true] /template/ Border#Border">
        <Setter Value="{DynamicResource SystemAccentBrush}" Property="BorderBrush" />
    </Style>
    <Style Selector="^[IsDefault=true] /template/ Border#ShadowBorder">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Border">
        <Setter Value="{DynamicResource Button.Pressed.Background}" Property="Background" />
        <Setter Value="{DynamicResource Button.Pressed.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:pressed /template/ Border#ShadowBorder">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#ContentPresenter">
        <Setter Value="{DynamicResource Button.Pressed.Foreground}" Property="Foreground" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Border">
        <Setter Value="{DynamicResource Button.Disabled.Background}" Property="Background" />
        <Setter Value="{DynamicResource Button.Disabled.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
        <Setter Value="{DynamicResource Button.Disabled.Foreground}" Property="Foreground" />
    </Style>
    <Style Selector="^:disabled /template/ Border#ShadowBorder">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[IsDefault=True]:pressed /template/ Border#Border">
        <Setter Value="{DynamicResource SystemAccentBrush}" Property="BorderBrush" />
    </Style></ControlTheme>
  <ControlTheme x:Key="InlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" x:Name="Border">
            <ContentPresenter Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pressed /template/ Border#Border">
        <Setter Value="{DynamicResource Button.Pressed.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Border">
        <Setter Value="{DynamicResource Button.Disabled.Background}" Property="Background" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Opacity" Value="0.4" />
    </Style></ControlTheme>
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
    
    <Setter Property="Background" Value="{DynamicResource Button.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Button.Static.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <ContentPresenter Focusable="False" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
<!-- Migration note：WPF 选择器 ^[IsDefaulted=true] /template/ Border#Border 无对应 Avalonia 属性，样式块注释化。原始片段：
    <Style Selector="^[IsDefaulted=true] /template/ Border#Border">
        <Setter Value="{DynamicResource SystemAccentBrush}" Property="BorderBrush" />
    </Style>-->

    <Style Selector="^:pressed /template/ Border#Border">
        <Setter Value="{DynamicResource Button.Pressed.Background}" Property="Background" />
        <Setter Value="{DynamicResource Button.Pressed.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:checked /template/ Border#Border">
        <Setter Value="{DynamicResource Button.Pressed.Background}" Property="Background" />
        <Setter Value="{DynamicResource Button.Pressed.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Border">
        <Setter Value="{DynamicResource Button.Disabled.Background}" Property="Background" />
        <Setter Value="{DynamicResource Button.Disabled.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
        <Setter Value="{DynamicResource Button.Disabled.Foreground}" Property="Foreground" />
    </Style></ControlTheme>
  <ControlTheme x:Key="InlineToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
    
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" x:Name="Border">
            <ContentPresenter Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pressed /template/ Border#Border">
        <Setter Value="{DynamicResource Button.Pressed.Background}" Property="Background" />
        <Setter Value="{DynamicResource Button.Pressed.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Border">
        <Setter Value="{DynamicResource Button.Disabled.Background}" Property="Background" />
        <Setter Value="{DynamicResource Button.Disabled.Border}" Property="BorderBrush" />
    </Style></ControlTheme>
  <ControlTheme x:Key="{x:Type controls:DropDownButton}" TargetType="controls:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
<!-- Migration note：WPF Setter Property=ClickMode 已删（Avalonia 无该属性/值） -->
  </ControlTheme>
  <ControlTheme x:Key="{x:Type editorControl:FloatingButton}" TargetType="editorControl:FloatingButton" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Margin" Value="2,2,2,2" />
    <Setter Property="Padding" Value="8,0,8,0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="Segoe UI" />
  </ControlTheme>
  <ControlTheme x:Key="ToolbarButton" TargetType="controls:ToolbarButton">
    
    <Setter Property="Background" Value="{DynamicResource ToolbarButton.Static.Background}" />
    <Setter Property="Padding" Value="10,0,10,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ToolbarButton">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <StackPanel>
              <ContentPresenter Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
              <TextBlock Text="{TemplateBinding controls:ToolbarButton.Title}" Theme="{DynamicResource ToolbarButtonTitle}" />
            </StackPanel>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover /template/ Border#Border">
        <Setter Value="{DynamicResource ToolbarButton.MouseOver.Background}" Property="Background" />
        <Setter Value="{DynamicResource ToolbarButton.MouseOver.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Border">
        <Setter Value="{DynamicResource ToolbarButton.Pressed.Background}" Property="Background" />
        <Setter Value="{DynamicResource ToolbarButton.Pressed.Border}" Property="BorderBrush" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Border">
        <Setter Property="Opacity" Value="0.6" />
    </Style></ControlTheme>
  <ControlTheme x:Key="StashToolbarButtonStyle" TargetType="controls:ToolbarButton" BasedOn="{StaticResource ToolbarButton}">
    <Setter Property="CornerRadius" Value="3,0,0,3" />
    
  
    <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource ToolbarButton.MouseOver.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButton.MouseOver.Background}" />
    </Style>
    <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource ToolbarButton.MouseOver.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButton.MouseOver.Background}" />
    </Style></ControlTheme>
  <ControlTheme x:Key="BranchToolbarButtonStyle" TargetType="controls:ToolbarButton" BasedOn="{StaticResource ToolbarButton}">
    <Setter Property="CornerRadius" Value="3,0,0,3" />
    
  
    <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource ToolbarButton.MouseOver.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButton.MouseOver.Background}" />
    </Style>
    <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource ToolbarButton.MouseOver.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButton.MouseOver.Background}" />
    </Style></ControlTheme>
  <ControlTheme x:Key="ToolbarToggleButton" TargetType="ToggleButton">
    
    <Setter Property="Background" Value="{DynamicResource ToolbarButton.Static.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="8,0,8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <ContentPresenter Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover /template/ Border#Border">
        <Setter Value="{DynamicResource ToolbarButton.MouseOver.Background}" Property="Background" />
        <Setter Value="{DynamicResource ToolbarButton.MouseOver.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Border">
        <Setter Value="{DynamicResource ToolbarButton.Pressed.Background}" Property="Background" />
        <Setter Value="{DynamicResource ToolbarButton.Pressed.Border}" Property="BorderBrush" />
        <Setter Property="Opacity" Value="0.9" />
