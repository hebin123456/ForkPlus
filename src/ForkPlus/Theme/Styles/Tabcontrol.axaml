<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
    
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource TabItem.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabItem.Static.Border}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid x:Name="templateRoot">
            <!-- Migration note：WPF ContentSource="Header"（TabItem 标签头显示 Header 而非 Content）。
                 Avalonia 12 无 ContentSource，须显式 Content="{TemplateBinding Header}"；
                 误绑 Content 会导致同一内容控件同时被塞进标签头与 PART_SelectedContentHost，
                 抛 "already has a visual parent" 异常 -->
            <ContentPresenter Focusable="False" Margin="{TemplateBinding Padding}" x:Name="contentPresenter" Content="{TemplateBinding Header}">
              <ContentPresenter.HorizontalAlignment>
                <Binding Path="HorizontalContentAlignment"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ItemsControl}" /></Binding.RelativeSource></Binding>
              </ContentPresenter.HorizontalAlignment>
              <ContentPresenter.VerticalAlignment>
                <Binding Path="VerticalContentAlignment"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ItemsControl}" /></Binding.RelativeSource></Binding>
              </ContentPresenter.VerticalAlignment>
            </ContentPresenter>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
<!-- Migration note：WPF Style.Resources 块（Avalonia Style 无 Resources 属性）。原始片段：
    <Style.Resources>
      <ResourceDictionary>
        <ControlTheme TargetType="TabPanel">
          <Setter Property="Background" Value="{DynamicResource TabItem.Static.Background}" />
        </ControlTheme>
        <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}" />
      </ResourceDictionary>
    </Style.Resources>-->

    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource TabItem.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabItem.Static.Border}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid ClipToBounds="true" KeyboardNavigation.TabNavigation="Local" x:Name="templateRoot">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Migration note：WPF TabControl 默认 ItemsPanel 是 TabPanel（横排）；Avalonia 默认是 WrapPanel，
                 但模板 ItemsPresenter 不绑 ItemsPanel 时落到 ItemsPresenter 自身默认垂直 StackPanel → 标签竖排。
                 必须显式 TemplateBinding（同 Menu.axaml 修复链6 的坑）。 -->
            <ItemsPresenter Grid.Column="0" Margin="0" Grid.Row="0" x:Name="headerPanel" TabIndex="1" ZIndex="1" ItemsPanel="{TemplateBinding ItemsPanel}" />
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.Column="0" Grid.Row="1" KeyboardNavigation.TabNavigation="Local" x:Name="contentPanel" TabIndex="2">
              <ContentPresenter Margin="{TemplateBinding Padding}" x:Name="PART_SelectedContentHost" />
            </Border>
          </Grid>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^[TabStripPlacement=Bottom] /template/ ItemsPresenter#headerPanel">
        <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ Border#contentPanel">
        <Setter Property="Grid.Row" Value="0" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ RowDefinition#RowDefinition0">
        <Setter Property="RowDefinition.Height" Value="*" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ RowDefinition#RowDefinition1">
        <Setter Property="RowDefinition.Height" Value="Auto" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#headerPanel">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="0" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ Border#contentPanel">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="1" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ColumnDefinition#ColumnDefinition0">
        <Setter Property="ColumnDefinition.Width" Value="Auto" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ColumnDefinition#ColumnDefinition1">
        <Setter Property="ColumnDefinition.Width" Value="*" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ RowDefinition#RowDefinition0">
        <Setter Property="RowDefinition.Height" Value="*" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ RowDefinition#RowDefinition1">
        <Setter Property="RowDefinition.Height" Value="0" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ItemsPresenter#headerPanel">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="1" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ Border#contentPanel">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="0" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ColumnDefinition#ColumnDefinition0">
        <Setter Property="ColumnDefinition.Width" Value="*" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ColumnDefinition#ColumnDefinition1">
        <Setter Property="ColumnDefinition.Width" Value="Auto" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ RowDefinition#RowDefinition0">
        <Setter Property="RowDefinition.Height" Value="*" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ RowDefinition#RowDefinition1">
        <Setter Property="RowDefinition.Height" Value="0" />
    </Style>
    <!-- Migration note：TabStripPlacement=Left/Right 时面板改纵排（仿 Avalonia Fluent 主题；
         默认 WrapPanel 横排只适用 Top/Bottom） -->
    <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#headerPanel > WrapPanel">
        <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ItemsPresenter#headerPanel > WrapPanel">
        <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <Style Selector="^:disabled /template/ Grid#templateRoot">
<!-- Migration note：WPF Foreground Setter 已删（Avalonia Border 无 Foreground 属性） -->
    </Style></ControlTheme>
  <ControlTheme x:Key="CloseButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource CloseButton.Static.Background}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Margin" Value="0,0,2,0" />
    
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="border">
            <Path Margin="3" Fill="{DynamicResource CloseButton.Static.Foreground}" Stretch="Uniform" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12 19,6.41z" x:Name="cross" />
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover">
        <Setter Value="{DynamicResource CloseButton.MouseOver.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#cross">
        <Setter Value="{DynamicResource CloseButton.MouseOver.Foreground}" Property="Fill" />
    </Style>
    <Style Selector="^:pressed">
        <Setter Value="{DynamicResource CloseButton.Pressed.Background}" Property="Background" />
    </Style>
    <Style Selector="^:pressed /template/ Path#cross">
        <Setter Value="{DynamicResource CloseButton.Pressed.Foreground}" Property="Fill" />
    </Style></ControlTheme>
  <ControlTheme x:Key="AddButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource AddButtonBackground}" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="2,1,1,1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="border">
            <Path Margin="3" Fill="{DynamicResource CloseButton.MouseOver.Foreground}" Stretch="Uniform" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Data="M19,13L13,13 13,19 11,19 11,13 5,13 5,11 11,11 11,5 13,5 13,11 19,11 19,13z" x:Name="plus" />
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover">
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Background}" Property="Background" />
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#plus">
        <Setter Value="{DynamicResource CloseButton.MouseOver.Foreground}" Property="Fill" />
    </Style>
    <Style Selector="^:pressed">
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Background}" Property="Background" />
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:pressed /template/ Path#plus">
        <Setter Value="{DynamicResource CloseButton.Pressed.Foreground}" Property="Fill" />
    </Style></ControlTheme>
  <!-- v4.x：垂直标签条收拢/展开切换按钮主题。结构同 AddButtonStyle（透明底 + 悬停高亮），
       但 glyph 为描边箭头 Path#chevron。方向由 ClosableTabControl 在按钮上维护 point-right
       class 切换（左侧布局展开 ◶ / 收拢 ◷…默认 = 朝左，point-right = 朝右；
       几何资源 TabStripChevronLeft/Right 见上方）——与 AddButtonStyle 的
       ^:pointerover /template/ Path#plus 同款机制，不依赖嵌套模板代码查找。 -->
  <StreamGeometry x:Key="TabStripChevronLeft">M 7.6,2.6 L 4.2,6 L 7.6,9.4</StreamGeometry>
  <StreamGeometry x:Key="TabStripChevronRight">M 4.4,2.6 L 7.8,6 L 4.4,9.4</StreamGeometry>
  <ControlTheme x:Key="TabStripToggleStyle" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource AddButtonBackground}" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="border">
            <Path x:Name="chevron" Width="12" Height="12" Stretch="None" Data="{DynamicResource TabStripChevronLeft}" Stroke="{DynamicResource CloseButton.MouseOver.Foreground}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:pointerover">
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Background}" Property="Background" />
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:pressed">
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Background}" Property="Background" />
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Border}" Property="BorderBrush" />
    </Style>
    <!-- 代码维护的 class：朝右箭头（默认朝左）。后写者赢。 -->
    <Style Selector="^.point-right /template/ Path#chevron">
      <Setter Property="Data" Value="{DynamicResource TabStripChevronRight}" />
    </Style>
  </ControlTheme>
  <!-- 为避免隐式 Theme 查找失败，提供具名 key + x:Type 别名两种访问方式。 -->
  <ControlTheme x:Key="ClosableTabControlTheme" TargetType="controls:ClosableTabControl">
    <Setter Property="BorderThickness" Value="0,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClosableTabItem.Static.Background}" />
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ClosableTabControl">
          <Grid Background="{DynamicResource ClosableTabItem.Static.Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>
            <ItemsPresenter Grid.Row="0" Grid.Column="0" x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            <Border Grid.Column="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ClosableTabItem.TopBorder}" />
            <Button Grid.Row="0" Grid.Column="1" x:Name="PART_Add" Theme="{DynamicResource AddButtonStyle}" />
            <Border Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ClosableTabItem.Static.Border}" />
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" x:Name="Border">
              <ContentPresenter x:Name="PART_SelectedContentHost" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- items 面板（UniformGrid，由 ClosableTabControl 构造函数 FuncTemplate 提供）的背景，
         原 WPF UniformGrid IsItemsHost=True 上的 Background -->
    <Style Selector="^ /template/ ItemsPresenter > UniformGrid">
      <Setter Property="Background" Value="{DynamicResource ClosableTabItem.Static.Background}" />
    </Style>
    <!-- v4.x：垂直标签条（VSCode 风格）。ClosableTabControl.ApplyTabBarLayout 附加 tabbar-left /
         tabbar-right class 命中以下模板（默认模板 = 顶部水平，保持原样）。结构：
         标签条（固定宽度，PART_TabStripHost，"+"按钮沉底，可滚动）+ GridSplitter（拖拽调宽，
         宽度经 SizeChanged 写回 ForkPlusSettings.TabStripWidth）+ 内容区。 -->
    <Style Selector="^.tabbar-left">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="controls:ClosableTabControl">
            <Grid Background="{DynamicResource ClosableTabItem.Static.Background}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" MaxWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <DockPanel Grid.Column="0" Background="{DynamicResource ClosableTabItem.Static.Background}" x:Name="PART_TabStripHost">
                <!-- Width/Height 必须显式给：DockPanel 底部停靠测量时约束是"整条剩余高度"，
                     AddButtonStyle 的 Path Stretch=Uniform 会随可用空间无限膨胀（水平模板里
                     是 24px 列宽兜住的，垂直模板没有列宽约束 → 出现巨大加号）。 -->
                <Button DockPanel.Dock="Bottom" Width="18" Height="18" x:Name="PART_Add" Theme="{DynamicResource AddButtonStyle}" HorizontalAlignment="Left" Margin="2,1,1,1" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="Transparent">
                  <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </DockPanel>
              <GridSplitter Grid.Column="1" Theme="{DynamicResource VerticalGridSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
              <Border Grid.Column="2" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" x:Name="Border">
                <ContentPresenter x:Name="PART_SelectedContentHost" />
              </Border>
              <!-- v4.x：收拢/展开切换按钮，悬浮在分隔线上（垂直居中）。负边距让布局占位仅 2px，
                   视觉横跨分隔线两侧、不挤占标签条与内容区；声明在最后 = 绘制在两侧面板之上。
                   箭头方向 = 按钮上的 point-right class（ClosableTabControl 维护）。
                   Focusable=False：不抢标签切换的键盘焦点。 -->
              <Button Grid.Column="1" Width="18" Height="18" Margin="-8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Focusable="False" x:Name="PART_TabStripToggle" Theme="{DynamicResource TabStripToggleStyle}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="^.tabbar-right">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="controls:ClosableTabControl">
            <Grid Background="{DynamicResource ClosableTabItem.Static.Background}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" MinWidth="120" MaxWidth="600" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" x:Name="Border">
                <ContentPresenter x:Name="PART_SelectedContentHost" />
              </Border>
              <GridSplitter Grid.Column="1" Theme="{DynamicResource VerticalGridSplitter}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
              <DockPanel Grid.Column="2" Background="{DynamicResource ClosableTabItem.Static.Background}" x:Name="PART_TabStripHost">
                <!-- 同 tabbar-left：显式 Width/Height 防止 Uniform Path 随停靠测量空间膨胀。 -->
                <Button DockPanel.Dock="Bottom" Width="18" Height="18" x:Name="PART_Add" Theme="{DynamicResource AddButtonStyle}" HorizontalAlignment="Left" Margin="2,1,1,1" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="Transparent">
                  <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </DockPanel>
              <!-- 同 tabbar-left：切换按钮悬浮在分隔线上（GridSplitter 与按钮同处 column 1，
                   按钮后声明 = 绘制在两侧面板之上）。 -->
              <Button Grid.Column="1" Width="18" Height="18" Margin="-8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Focusable="False" x:Name="PART_TabStripToggle" Theme="{DynamicResource TabStripToggleStyle}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- v4.x：垂直标签条收拢态（ClosableTabControl 附加 tabbar-collapsed class）。
         收拢 = 标签条列宽压到 0（宽度由代码管理，因列 MinWidth=120 需同步放开），
         隐藏"+"按钮/标签列表/拖拽条；分隔列只剩切换按钮（边距归零 → 18px 展开条）。 -->
    <Style Selector="^.tabbar-collapsed /template/ Button#PART_Add">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.tabbar-collapsed /template/ ScrollViewer">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.tabbar-collapsed /template/ GridSplitter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.tabbar-collapsed /template/ Button#PART_TabStripToggle">
      <Setter Property="Margin" Value="0" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type controls:ClosableTabControl}" TargetType="controls:ClosableTabControl" BasedOn="{StaticResource ClosableTabControlTheme}" />
  <!--
      WPF migration note: 焦点视觉样式 TabItemFocusVisual 已移除（Avalonia 无 FocusVisualStyle 机制，焦点视觉由主题内部处理；所有引用点已随 FocusVisualStyle 属性删除）。
      原始片段：
      <Style x:Key="TabItemFocusVisual" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="https://github.com/avaloniaui">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate>
                <Rectangle StrokeThickness="0" Fill="#00FFFFFF" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
    -->
  <DropShadowEffect x:Key="ClosableTabItemShadow" BlurRadius="10" Color="Black" Opacity="{DynamicResource ClosableTabItem.ShadowOpacity}" OffsetY="4" />
  <ControlTheme x:Key="ClosableTabItemTheme" TargetType="controls:ClosableTabItem">
    
    <Setter Property="Foreground" Value="{DynamicResource TabItem.Static.Foreground}" />
    <Setter Property="Padding" Value="2,0,2,0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClosableTabItem.Static.Border}" />
    <Setter Property="Background" Value="{DynamicResource ClosableTabItem.Static.Background}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
<!-- Migration note：WPF Setter Property=AllowDrop 已删（Avalonia 无该属性/值） -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ClosableTabItem">
          <Grid>
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ClosableTabItem.TopBorder}" x:Name="TopBorder" />
            <Border BorderThickness="0,0,0,1" Margin="0,1,0,0" CornerRadius="4,4,0,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" x:Name="Bd" />
            <Border Margin="0,4,0,4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ClosableTabItem.SeparatorBorder}" x:Name="TabSeparatorBorder" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="Content" Content="{TemplateBinding Header}" />
          </Grid>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^ /template/ Button#PART_Close">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Bd">
        <Setter Value="{DynamicResource TabItemHotBackground}" Property="Background" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#TabSeparatorBorder">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:selected">
        <Setter Property="Panel.ZIndex" Value="1" />
        <Setter Value="{DynamicResource TabItem.Selected.Foreground}" Property="Foreground" />
    </Style>
    <Style Selector="^:selected /template/ Button#PART_Close">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- 原版：鼠标悬停也显示关闭按钮（避免只能选中后才能关）。 -->
    <Style Selector="^:pointerover /template/ Button#PART_Close">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:selected /template/ Border#TabSeparatorBorder">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:selected /template/ Border#Bd">
        <Setter Value="{DynamicResource ClosableTabItem.Selected.Background}" Property="Background" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Margin" Value="-1,0,0,0" />
        <Setter Value="{DynamicResource ClosableTabItem.Selected.Border}" Property="BorderBrush" />
        <Setter Value="{DynamicResource ClosableTabItemShadow}" Property="Effect" />
    </Style>
    <Style Selector="^[IsSelected=false]:pointerover /template/ Border#Bd">
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Background}" Property="Background" />
        <Setter Value="{DynamicResource ClosableTabItem.MouseOver.Border}" Property="BorderBrush" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="Margin" Value="-1,0,0,0" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Bd">
        <Setter Value="{DynamicResource ClosableTabItem.Disabled.Background}" Property="Background" />
        <Setter Value="{DynamicResource ClosableTabItem.Disabled.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:disabled">
        <Setter Value="#FF6D6D6D" Property="Foreground" />
    </Style>
    <!-- v4.x：垂直标签条下的标签样式（ClosableTabControl.ApplyTabBarLayout 给每个
         ClosableTabItem 附加 "vertical" class）。水平模板的视觉是"上翘圆角 + 底部分隔线 +
         顶部条形高亮"，垂直模式改为整行卡片：圆角四角、分隔线转横向下边框、去掉顶部高亮条，
         行高放开（MinHeight）随内容，Padding 加左右留白（颜色点/标题/关闭按钮横排一行）。 -->
    <Style Selector="^.vertical">
        <!-- 修复（2026-09-28）：Height 是 double，"Auto" 是 GridLength 语法（AVLN1000），自动高度用 NaN。 -->
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector="^.vertical /template/ Border#TopBorder">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.vertical /template/ Border#Bd">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^.vertical /template/ Border#TabSeparatorBorder">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Margin" Value="4,0,4,0" />
    </Style>
    <Style Selector="^.vertical:selected /template/ Border#Bd">
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^.vertical[IsSelected=false]:pointerover /template/ Border#Bd">
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
    </Style>
    <!--
      WPF migration note: ControlTemplate 内 MultiDataTrigger（VM 属性条件）需人工改写。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
                    <MultiDataTrigger.Conditions>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsMouseOver">
                            <Binding.RelativeSource>
                              <RelativeSource Mode="TemplatedParent" />
                            </Binding.RelativeSource>
                          </Binding>
                        </Condition.Binding>
                      </Condition>
                      <Condition Value="false">
                        <Condition.Binding>
                          <Binding ElementName="PART_Title" Path="IsInEditMode" />
                        </Condition.Binding>
                      </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="PART_Close" Property="IsVisible" Value="True" />
                  </MultiDataTrigger>
    --></ControlTheme>
  <ControlTheme x:Key="ModernTabControlTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
    
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="16,2" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Background="#00FFFFFF" x:Name="templateRoot">
            <!-- Migration note：同上，WPF ContentSource="Header" → 显式绑定 Header -->
            <ContentPresenter Focusable="False" Margin="{TemplateBinding Padding}" TextElement.FontWeight="Medium" x:Name="contentPresenter" Content="{TemplateBinding Header}">
              <ContentPresenter.HorizontalAlignment>
                <Binding Path="HorizontalContentAlignment"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ItemsControl}" /></Binding.RelativeSource></Binding>
              </ContentPresenter.HorizontalAlignment>
              <ContentPresenter.VerticalAlignment>
                <Binding Path="VerticalContentAlignment"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ItemsControl}" /></Binding.RelativeSource></Binding>
              </ContentPresenter.VerticalAlignment>
            </ContentPresenter>
          </Grid>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:selected /template/ ContentPresenter#contentPresenter">
        <Setter Value="{DynamicResource SystemAccentBrush}" Property="Foreground" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#contentPresenter">
<!-- Migration note：WPF Foreground Setter 已删（Avalonia Border 无 Foreground 属性） -->
    </Style></ControlTheme>
  <ControlTheme x:Key="{x:Type controls:ModernTabControl}" TargetType="controls:ModernTabControl" BasedOn="{StaticResource {x:Type TabControl}}">
<!-- Migration note：WPF Style.Resources 块（Avalonia Style 无 Resources 属性）。原始片段：
    <Style.Resources>
      <ResourceDictionary>
        <ControlTheme x:Key="{x:Type TabPanel}" TargetType="TabPanel">
          <Setter Property="Background" Value="#00FFFFFF" />
        </ControlTheme>
        <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem" BasedOn="{StaticResource ModernTabControlTabItemStyle}" />
      </ResourceDictionary>
    </Style.Resources>-->

    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <!-- Migration note：WPF ModernTabControl.Style.Resources 里的隐式 TabItem 样式（BasedOn
         ModernTabControlTabItemStyle）使所有子 TabItem 自动获得 Height=30/Padding=16,2/
         FontSize=13/选中强调色；Avalonia Style 无 Resources 属性，等价机制是 ItemsControl.
         ItemContainerTheme（同 Menu 修复链的 TopLevelMenuItemTheme 模式）。不挂的话子
         TabItem 回落到隐式 {x:Type TabItem} 主题（Padding=0）→ 标签挤在一起。
         注：曾怀疑本 Setter 导致偏好设置窗口"内容区透明"——实测为误诊：
         真因是无 WM 沙盒里对话框 Z 序被主窗口压住（迁移期验证经验）。 -->
    <Setter Property="ItemContainerTheme" Value="{StaticResource ModernTabControlTabItemStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid ClipToBounds="true" KeyboardNavigation.TabNavigation="Local" x:Name="templateRoot">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Column="0" Grid.Row="0">
              <!-- Migration note：同上，ItemsPresenter 必须显式绑 ItemsPanel，否则默认垂直 StackPanel → 标签竖排 -->
              <ItemsPresenter Margin="0" x:Name="headerPanel" TabIndex="1" ZIndex="1" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Grid>
            <Canvas Grid.Column="0" Grid.Row="0">
              <Border Height="1.5" Margin="0" Canvas.Left="0" Canvas.Bottom="0" BorderThickness="0" HorizontalAlignment="Left" Background="{DynamicResource SystemAccentBrush}" x:Name="PART_IndicatorBorder" />
            </Canvas>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.Column="0" Grid.Row="1" KeyboardNavigation.TabNavigation="Local" x:Name="contentPanel" TabIndex="2">
              <ContentPresenter Margin="{TemplateBinding Padding}" x:Name="PART_SelectedContentHost" />
            </Border>
          </Grid>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
<!-- Migration note：WPF 在 Grid#templateRoot 上设 Foreground 的样式已删（Avalonia 该控件无 Foreground） --></ControlTheme>
  <!-- Migration note：WPF RepositoryManagerTabControl.Style.Resources 里 TabItem FontSize=14；
       Avalonia 等价物 = 派生 ControlTheme + ItemContainerTheme 覆盖基类值 -->
  <ControlTheme x:Key="RepositoryManagerTabItemTheme" TargetType="TabItem" BasedOn="{StaticResource ModernTabControlTabItemStyle}">
    <Setter Property="FontSize" Value="14" />
  </ControlTheme>
  <ControlTheme x:Key="{x:Type controls:ClosableTabItem}" TargetType="controls:ClosableTabItem" BasedOn="{StaticResource ClosableTabItemTheme}" />
  <ControlTheme x:Key="RepositoryManagerTabControl" TargetType="controls:ModernTabControl" BasedOn="{StaticResource {x:Type controls:ModernTabControl}}">
<!-- Migration note：WPF Style.Resources 块（Avalonia Style 无 Resources 属性）。原始片段：
    <Style.Resources>
      <ResourceDictionary>
        <ControlTheme x:Key="{x:Type TabPanel}" TargetType="TabPanel">
          <Setter Property="Background" Value="#00FFFFFF" />
        </ControlTheme>
        <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem" BasedOn="{StaticResource ModernTabControlTabItemStyle}">
          <Setter Property="FontSize" Value="14" />
        </ControlTheme>
      </ResourceDictionary>
    </Style.Resources>-->

    <Setter Property="ItemContainerTheme" Value="{StaticResource RepositoryManagerTabItemTheme}" />
  </ControlTheme>
</ResourceDictionary>