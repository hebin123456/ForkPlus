  <Style x:Key="{x:Type controls:FilterTextBox}" Selector="controls:FilterTextBox" BasedOn="{StaticResource {x:Type controls:PlaceholderTextBox}}">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="controls:PlaceholderTextBox.Placeholder" Value="Filter" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="2,1,2,1" />
