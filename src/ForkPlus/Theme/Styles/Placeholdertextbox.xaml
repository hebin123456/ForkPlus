            <Border.RenderTransform>
              <TranslateTransform x:Name="PART_TranslateTransform" />
            </Border.RenderTransform>
            <Grid Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Source="{DynamicResource SearchOnIcon}" Width="13" Height="13" Margin="4,0,0,0" x:Name="PART_Icon" />
              <controls:DropDownButton HorizontalAlignment="Left" Height="20" Margin="0" IsVisible="False" Background="#00FFFFFF" BorderThickness="0" Focusable="False" x:Name="PART_DropDownButton"><controls:DropDownButton.ContextMenu>
                  <ContextMenu />
                </controls:DropDownButton.ContextMenu>
                <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
                  <Image Height="13" Width="13" Margin="4,0,0,0" Source="{DynamicResource SearchOnIcon}" x:Name="DropdownButtonImage" />
                  <Path Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{DynamicResource ArrowGeometry}" Fill="{DynamicResource AccentBrush}" x:Name="DropdownButtonPath" />
                </StackPanel>
              </controls:DropDownButton>
              <ScrollViewer Grid.Column="1" Focusable="false" HorizontalScrollBarIsVisible="False" VerticalScrollBarIsVisible="False" Background="#00FFFFFF" x:Name="PART_ContentHost" />
              <TextBlock Grid.Column="1" Padding="{TemplateBinding Padding}" IsVisible="False" IsHitTestVisible="False" FontSize="{TemplateBinding FontSize}" Margin="1,0,0,0" Foreground="{TemplateBinding Foreground}" Opacity="0.56" Text="{TemplateBinding controls:PlaceholderTextBox.Placeholder}" x:Name="placeholderElement" />
              <TextBlock Grid.Column="2" Text="?" Margin="4,-2,4,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" ToolTipService.ShowDuration="15000" x:Name="HintTextBlock">
                <TextBlock.ToolTip>
                  <Binding Path="Hint"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:FilterTextBox}" /></Binding.RelativeSource></Binding>
                </TextBlock.ToolTip>
              </TextBlock>
              <Button Grid.Column="3" Margin="0,0,2,0" Height="16" Width="16" Padding="0" BorderThickness="0" Background="#00FFFFFF" x:Name="PART_ClearButton">
                <Image Source="{DynamicResource CancelSearchIcon}" Width="14" Height="14" VerticalAlignment="Center" />
              </Button>
            </Grid>
          </Border>
          <!-- NOTE (Avalonia limitation): ControlTemplate.Triggers Trigger on controls:FilterTextBox.Hint=null could not be
               converted (no Avalonia pseudoclass for Hint=null). Original logic:
                 HintTextBlock.Visibility = Collapsed
               Reimplement using a binding on HintTextBlock.IsVisible with a null-to-bool converter, or add a
               custom pseudoclass to FilterTextBox.
          <Trigger Property="controls:FilterTextBox.Hint">
            <Trigger.Value>
              <x:Null />
            </Trigger.Value>
            <Setter TargetName="HintTextBlock" Property="IsVisible" Value="False" />
          </Trigger>
          -->
          <!-- Converted from ControlTemplate.Triggers: TextBox.Text="" -> :empty -->
          <Style Selector="^:empty /template/ TextBlock#placeholderElement">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^:empty /template/ Button#PART_ClearButton">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^:empty /template/ Image#PART_Icon">
            <Setter Property="Source" Value="{DynamicResource SearchIcon}" />
          </Style>
          <Style Selector="^:empty /template/ Image#DropdownButtonImage">
            <Setter Property="Source" Value="{DynamicResource SearchIcon}" />
          </Style>
          <Style Selector="^:empty /template/ Path#DropdownButtonPath">
            <Setter Property="Fill" Value="{DynamicResource ComboBox.Static.Glyph}" />
          </Style>
          <!-- Converted from ControlTemplate.Triggers: IsEnabled=False -> :disabled -->
          <Style Selector="^:disabled /template/ Border#Border">
            <Setter Property="Opacity" Value="0.56" />
          </Style>
          <!-- Converted from ControlTemplate.Triggers: IsKeyboardFocused=True -> :focus -->
          <Style Selector="^:focus /template/ Border#Border">
            <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          </Style>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
