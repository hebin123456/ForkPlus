<!-- Migration notes (WPF -> Avalonia):
     - Root xmlns set to https://github.com/avaloniaui; removed redundant child xmlns:x declarations.
     - Style TargetType="{x:Type T}" -> Selector="T" (x:Key values preserved, BasedOn preserved).
     - ControlTemplate.Triggers -> nested <Style Selector="^..."> with /template/ Element#Name selectors.
     - Pseudoclass mapping: TextBox.Text="" -> :empty (Avalonia TextBox exposes :empty when Text is null or
       empty), UIElement.IsKeyboardFocused=True -> :focus, UIElement.IsEnabled=False -> :disabled.
     - Property prefixes stripped in Setters (Panel.Background->Background, Border.BorderBrush->BorderBrush,
       FrameworkElement.* -> *, UIElement.* -> *, TextElement.* -> *, Control.* -> *, TextBoxBase.* -> *,
       Image.* -> *, Shape.* -> *, TextBlock.* -> *). Attached properties (KeyboardNavigation.*,
       ScrollViewer.*, Stylus.*, ToolTipService.*) kept as-is.
     - UIElement.Visibility in Setters and literal template attrs -> IsVisible (bool: Visible->True,
       Collapsed/Hidden->False).
     - TemplateBinding paths stripped of class prefixes (Panel.Background->Background, Border.*->*,
       Control.*->*, TextElement.*->*). controls:PlaceholderTextBox.Icon, controls:PlaceholderTextBox.Placeholder,
       controls:CommitDescriptionTextBox.GuideLineMargin kept (namespaced custom properties).
     - Trigger on controls:PlaceholderTextBox.Icon=null could not be converted (no Avalonia pseudoclass for
       a custom property being null) -> preserved as NOTE comments.
     - Trigger on controls:FilterTextBox.Hint=null could not be converted (no pseudoclass for Hint=null)
       -> preserved as NOTE comment.
     - Style.Triggers MultiTrigger on TextBoxBase.IsInactiveSelectionHighlightEnabled (bool property, no
       pseudoclass) + TextBoxBase.IsSelectionActive (no pseudoclass) could not be converted -> NOTE comments.
     - ControlTemplate internal control tree and layout preserved. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="{x:Type controls:PlaceholderTextBox}" Selector="controls:PlaceholderTextBox">
    <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
<Setter Property="AllowDrop" Value="true" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <Grid Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Source="{TemplateBinding controls:PlaceholderTextBox.Icon}" Height="14" Width="14" Margin="4,0,0,0" x:Name="IconElement" />
              <ScrollViewer Grid.Column="1" Focusable="false" HorizontalScrollBarIsVisible="False" VerticalScrollBarIsVisible="False" Background="#00FFFFFF" x:Name="PART_ContentHost" />
              <TextBlock Grid.Column="1" Padding="{TemplateBinding Padding}" IsVisible="False" IsHitTestVisible="False" FontSize="{TemplateBinding FontSize}" Margin="2,0,0,0" Foreground="{TemplateBinding Foreground}" Opacity="0.56" Text="{TemplateBinding controls:PlaceholderTextBox.Placeholder}" x:Name="PlaceholderElement" />
            </Grid>
          </Border>
          <!-- Converted from ControlTemplate.Triggers: TextBox.Text="" -> :empty -->
          <Style Selector="^:empty /template/ TextBlock#PlaceholderElement">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <!-- NOTE (Avalonia limitation): ControlTemplate.Triggers Trigger on controls:PlaceholderTextBox.Icon=null could not be
               converted (no Avalonia pseudoclass for a custom property being null). Original logic:
                 IconElement.Visibility = Collapsed
               Reimplement using a binding on IconElement.IsVisible with a null-to-bool converter, or add a
               custom pseudoclass to PlaceholderTextBox.
          <Trigger Property="controls:PlaceholderTextBox.Icon">
            <Trigger.Value>
              <x:Null />
            </Trigger.Value>
            <Setter TargetName="IconElement" Property="IsVisible" Value="False" />
          </Trigger>
          -->
          <!-- Converted from ControlTemplate.Triggers: IsEnabled=false -> :disabled -->
          <Style Selector="^:disabled /template/ Border#Border">
            <Setter Property="Opacity" Value="0.56" />
          </Style>
          <!-- Converted from ControlTemplate.Triggers: IsKeyboardFocused=True -> :focus -->
          <Style Selector="^:focus /template/ Border#Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentBrush}" />
          </Style>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- NOTE (Avalonia limitation): Style.Triggers MultiTrigger on TextBoxBase.IsInactiveSelectionHighlightEnabled=true (bool
         property, no pseudoclass) + TextBoxBase.IsSelectionActive=false (no pseudoclass) could not be
         converted. Original logic: SelectionBrush = SystemColors.InactiveSelectionHighlightBrush.
         Reimplement using a binding with converter or code-behind.
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="TextBoxBase.IsInactiveSelectionHighlightEnabled" Value="true" />
          <Condition Property="TextBoxBase.IsSelectionActive" Value="false" />
        </MultiTrigger.Conditions>
        <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
      </MultiTrigger>
    </Style.Triggers>
    -->
  </Style>
