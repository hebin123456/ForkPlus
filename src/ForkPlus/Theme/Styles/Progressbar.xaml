                </Rectangle>
                <Rectangle RadiusX="0.85" RadiusY="0.85" Height="4.2" Width="0.998" Canvas.Left="5.548" Canvas.Top="-2.678" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle05">
