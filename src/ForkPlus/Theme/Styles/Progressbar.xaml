                </Rectangle>
              </Canvas>
            </Viewbox>
          </Grid>
          <!-- NOTE (phase 6, Avalonia limitation): Original WPF ControlTemplate.Triggers MultiTrigger
               (ProgressBar.IsIndeterminate=True AND UIElement.IsVisible=True) ran
               BeginStoryboard(BusyIndicatorStoryboard) on enter and RemoveStoryboard on exit.
               Avalonia does not support WPF Storyboard markup. Reimplement the 12-Rectangle
               opacity key-frame loop using <Animation> on the :indeterminate pseudoclass
               (or code-behind). The <Storyboard> resource below is preserved verbatim
               for reference. Original trigger markup:
                 <MultiTrigger>
                   <MultiTrigger.Conditions>
                     <Condition Property="IsIndeterminate" Value="True" />
                     <Condition Property="IsVisible" Value="True" />
                   </MultiTrigger.Conditions>
                   <MultiTrigger.EnterActions>
                     <BeginStoryboard Storyboard="{DynamicResource BusyIndicatorStoryboard}" x:Name="IsIndeterminateStoryboard" />
                   </MultiTrigger.EnterActions>
                   <MultiTrigger.ExitActions>
                     <RemoveStoryboard BeginStoryboardName="IsIndeterminateStoryboard" />
                   </MultiTrigger.ExitActions>
                 </MultiTrigger> -->
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Storyboard x:Key="BusyIndicatorStoryboard" BeginTime="00:00:00" RepeatBehavior="Forever">
    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Rectangle01" Storyboard.TargetProperty="(UIElement.Opacity)">
