<!-- Migration Notes (WPF -> Avalonia):
     - Root xmlns set to https://github.com/avaloniaui; removed duplicate xmlns:x on child elements.
     - Style TargetType="{x:Type ProgressBar}" -> Selector="ProgressBar"; x:Key values preserved.
     - Property prefixes stripped: TextElement.Foreground -> Foreground, Panel.Background -> Background,
       FrameworkElement.Width -> Width, FrameworkElement.Height -> Height, FrameworkElement.MinWidth -> MinWidth,
       FrameworkElement.MaxWidth -> MaxWidth, FrameworkElement.VerticalAlignment -> VerticalAlignment,
       ProgressBar.IsIndeterminate -> IsIndeterminate, Control.Template -> Template,
       RangeBase.Maximum -> Maximum, Border.BorderThickness -> BorderThickness.
     - TemplateBinding class prefixes stripped ({TemplateBinding Background} -> {TemplateBinding Background}).
     - ControlTemplate.Triggers MultiTrigger (ProgressBar.IsIndeterminate=True AND UIElement.IsVisible=True)
       used BeginStoryboard/RemoveStoryboard to start/stop BusyIndicatorStoryboard (12 Rectangle opacity
       key-frame animations, RepeatBehavior=Forever). Avalonia does not support WPF Storyboard markup;
       the animation must be reimplemented in phase 6 using <Animation> on the :indeterminate pseudoclass
       (or code-behind). The <Storyboard> resource is preserved verbatim for reference; the trigger actions
       are left as a NOTE comment below the ControlTemplate. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:circularProgressBar="clr-namespace:ForkPlus.UI.CircularProgressBar" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <circularProgressBar:StartPointConverter x:Key="StartPointConverter" />
  <circularProgressBar:ArcSizeConverter x:Key="ArcSizeConverter" />
  <circularProgressBar:ArcEndPointConverter x:Key="ArcEndPointConverter" />
  <circularProgressBar:LargeArcConverter x:Key="LargeArcConverter" />
  <circularProgressBar:RotateTransformConverter x:Key="RotateTransformConverter" />
  <circularProgressBar:RotateTransformCentreConverter x:Key="RotateTransformCentreConverter" />
