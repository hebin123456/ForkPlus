<!-- Migration Notes (WPF -> Avalonia):
     - Root xmlns set to https://github.com/avaloniaui; removed duplicate xmlns:x on child elements.
     - Style TargetType="{x:Type T}" -> Selector="T"; x:Key values preserved.
     - Property prefixes stripped: Control.Template -> Template, Control.Padding -> Padding,
       TextElement.Foreground -> Foreground, TextElement.FontSize -> FontSize, Panel.Background -> Background,
       Control.HorizontalContentAlignment -> HorizontalContentAlignment,
       Control.VerticalContentAlignment -> VerticalContentAlignment, Border.BorderBrush -> BorderBrush,
       Border.BorderThickness -> BorderThickness, UIElement.Visibility -> IsVisible,
       TextElement.FontWeight -> FontWeight, TextElement.FontStyle -> FontStyle,
       TextElement.FontStretch -> FontStretch, TextElement.FontFamily -> FontFamily,
       HeaderedContentControl.HeaderTemplate -> HeaderTemplate,
       HeaderedContentControl.HeaderTemplateSelector -> HeaderTemplateSelector,
       HeaderedContentControl.Header -> Header, FrameworkElement.Cursor -> Cursor,
       Shape.Stroke -> Stroke, Shape.Fill -> Fill, Path.Data -> Data.
     - TemplateBinding class prefixes stripped ({TemplateBinding Padding} -> {TemplateBinding Padding},
       {TemplateBinding BorderBrush} -> {TemplateBinding BorderBrush}, etc.).
     - ExpanderDownHeaderStyle ControlTemplate.Triggers (4 triggers) converted to nested <Style.Styles> with
       /template/ selectors: ToggleButton.IsChecked=True -> :checked, UIElement.IsMouseOver=True -> :pointerover,
       ButtonBase.IsPressed=True -> :pressed, UIElement.IsEnabled=False -> :disabled.
       IsChecked trigger on SeparatorBorder (Visibility=Visible) -> IsVisible=True; Arrow Path.Data setter
       preserved. IsMouseOver trigger on templated parent Cursor=Hand kept as ^:pointerover (no /template/).
     - DiffListExpanderStyle ControlTemplate.Triggers (Expander.IsExpanded=True -> ExpandSite Visibility=Visible)
       converted to ^:expanded /template/ ContentPresenter#ExpandSite with IsVisible=True.
       IsVisible="False" attribute on ExpandSite converted to IsVisible="False".
       IsVisible="False" attribute on SeparatorBorder converted to IsVisible="False". -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ExpanderDownHeaderStyle" Selector="ToggleButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Padding="{TemplateBinding Padding}" Background="#00FFFFFF" x:Name="Border">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="33" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path Grid.Row="0" Grid.Column="0" Data="M0,0L3.5,3.5 0,7" Margin="25,1,0,0" HorizontalAlignment="Right" Stroke="{DynamicResource Expander.Static.Arrow.Stroke}" StrokeThickness="1.5" VerticalAlignment="Center" x:Name="Arrow" />
              <ContentPresenter Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="ContentPresenter" />
              <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" IsVisible="False" x:Name="SeparatorBorder" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Styles>
      <!-- Converted from ControlTemplate.Triggers: ToggleButton.IsChecked=True -> :checked -->
      <Style Selector="^:checked /template/ Border#SeparatorBorder">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked /template/ Path#Arrow">
        <Setter Property="Data" Value="M0,0L3.5,3.5 7,0" />
      </Style>
      <!-- Converted from ControlTemplate.Triggers: UIElement.IsMouseOver=True -> :pointerover -->
      <Style Selector="^:pointerover /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </Style>
      <Style Selector="^:pointerover /template/ Path#Arrow">
        <Setter Property="Stroke" Value="{DynamicResource Expander.MouseOver.Arrow.Stroke}" />
      </Style>
      <!-- Cursor=Hand targets the templated parent (ToggleButton), no /template/ needed. -->
      <Style Selector="^:pointerover">
        <Setter Property="Cursor" Value="Hand" />
      </Style>
      <!-- Converted from ControlTemplate.Triggers: ButtonBase.IsPressed=True -> :pressed -->
      <Style Selector="^:pressed /template/ Path#Arrow">
        <Setter Property="Stroke" Value="{DynamicResource Expander.Pressed.Arrow.Stroke}" />
      </Style>
      <!-- Converted from ControlTemplate.Triggers: UIElement.IsEnabled=False -> :disabled -->
      <Style Selector="^:disabled /template/ Path#Arrow">
        <Setter Property="Stroke" Value="{DynamicResource Expander.Disabled.Arrow.Stroke}" />
      </Style>
    </Style.Styles>
  </Style>
  <Style x:Key="DiffListExpanderStyle" Selector="Expander">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <DockPanel>
              <ToggleButton ContentTemplate="{TemplateBinding HeaderTemplate}" ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" Content="{TemplateBinding Header}" DockPanel.Dock="Top" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" FontStyle="{TemplateBinding FontStyle}" FontStretch="{TemplateBinding FontStretch}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="0" MinWidth="0" MinHeight="0" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"><ToggleButton.IsChecked>
                  <Binding Path="IsExpanded"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
              <ContentPresenter DockPanel.Dock="Bottom" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" IsVisible="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="ExpandSite" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Styles>
      <!-- Converted from ControlTemplate.Triggers: Expander.IsExpanded=True -> :expanded -->
      <Style Selector="^:expanded /template/ ContentPresenter#ExpandSite">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style.Styles>
  </Style>
</ResourceDictionary>
