      <EasingDoubleKeyFrame KeyTime="00:00:00.35" Value="0.6" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.40" Value="0.3" />
    </DoubleAnimationUsingKeyFrames>
    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00">
      <EasingDoubleKeyFrame KeyTime="00:00:00.05" Value="0.3" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.25" Value="0.3" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.30" Value="1" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.35" Value="0.85" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.40" Value="0.6" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.45" Value="0.3" />
    </DoubleAnimationUsingKeyFrames>
    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00">
      <EasingDoubleKeyFrame KeyTime="00:00:00.05" Value="0.3" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.30" Value="0.3" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.35" Value="1" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.40" Value="0.85" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.45" Value="0.6" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.50" Value="0.3" />
    </DoubleAnimationUsingKeyFrames>
    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00">
      <EasingDoubleKeyFrame KeyTime="00:00:00.05" Value="0.3" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.35" Value="0.3" />
      <EasingDoubleKeyFrame KeyTime="00:00:00.40" Value="1" />
