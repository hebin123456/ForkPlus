<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:circularProgressBar="clr-namespace:ForkPlus.UI.CircularProgressBar" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <circularProgressBar:StartPointConverter x:Key="StartPointConverter" />
  <circularProgressBar:ArcSizeConverter x:Key="ArcSizeConverter" />
  <circularProgressBar:ArcEndPointConverter x:Key="ArcEndPointConverter" />
  <circularProgressBar:LargeArcConverter x:Key="LargeArcConverter" />
  <circularProgressBar:RotateTransformConverter x:Key="RotateTransformConverter" />
  <circularProgressBar:RotateTransformCentreConverter x:Key="RotateTransformCentreConverter" />
  <ControlTheme x:Key="CircularProgressBar" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="#FF007ACC" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="IsIndeterminate" Value="True" />
    <!-- 修复�?026-09-14�?loading 动画转不起来"）：WPF Storyboard 被注释后 spinner 静止�?         �?SpinnerBehavior 附加行为复刻追逐动画（�?UI/CircularProgressBar/SpinnerBehavior.cs）�?-->
    <Setter Property="circularProgressBar:SpinnerBehavior.IsActive" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid Background="{TemplateBinding Background}" ClipToBounds="False" x:Name="TemplateRoot">
            <Border x:Name="PART_Indicator" IsVisible="False" />
            <Viewbox>
              <!-- 修复（2026-10-22，"loading 圆环变成四块/不均匀"）：Avalonia UseLayoutRounding
                     默认开启，把 12 个矩形的亚像素布点（16x16 设计面上精确到 0.001px）量化成
                     整数网格，圆环半径 4.5~5.9 不等、角距 17°~44° 跳变；WPF 默认关闭该行为。
                     显式关闭后 12 点恢复半径 5.2±0.1、角距 30° 的均匀圆。 -->
              <Canvas Height="16" Width="16" UseLayoutRounding="False">
                <Rectangle UseLayoutRounding="False" Height="4.198" Width="0.999" Canvas.Left="7.498" Canvas.Top="0.7" RadiusX="0.85" RadiusY="0.85" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle01" />
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.198" Width="1" Canvas.Left="6.376" Canvas.Top="0.398" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle02">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="30" />
                      <TranslateTransform X="3.7499999999999996" Y="1.00480947161671" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.2" Width="0.998" Canvas.Left="5.548" Canvas.Top="-0.422" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle03">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="60" />
                      <TranslateTransform X="6.49519052838329" Y="3.7500000271702154" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.2" Width="1" Canvas.Left="5.244" Canvas.Top="-1.546" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle04">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="90" />
                      <TranslateTransform X="7.5000000920390741" Y="7.5" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.2" Width="0.998" Canvas.Left="5.548" Canvas.Top="-2.678" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle05">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="120" />
                      <TranslateTransform X="6.49519052838329" Y="11.25" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.2" Width="1" Canvas.Left="6.376" Canvas.Top="-3.5" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle06">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="150" />
                      <TranslateTransform X="3.7500000920390728" Y="13.995190528383292" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.202" Width="0.999" Canvas.Left="7.498" Canvas.Top="11.2" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle07" />
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.202" Width="1" Canvas.Left="8.62" Canvas.Top="11.502" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle08">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="30" />
                      <TranslateTransform X="-3.7499999999999996" Y="-1.00480947161671" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.202" Width="1" Canvas.Left="9.454" Canvas.Top="12.324" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle09">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="60" />
                      <TranslateTransform X="-6.49519052838329" Y="-3.7500000271702154" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.2" Width="1" Canvas.Left="9.744" Canvas.Top="13.448" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle10">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="90" />
                      <TranslateTransform X="-7.5000000920390741" Y="-7.5" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.2" Width="1" Canvas.Left="9.454" Canvas.Top="14.576" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle11">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="120" />
                      <TranslateTransform X="-6.49519052838329" Y="-11.25" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle UseLayoutRounding="False" RadiusX="0.85" RadiusY="0.85" Height="4.2" Width="1" Canvas.Left="8.62" Canvas.Top="15.398" RenderTransformOrigin="50%,50%" Opacity="0.3" Fill="{DynamicResource BusyIndicatorBrush}" x:Name="Rectangle12">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform Angle="150" />
                      <TranslateTransform X="-3.7500000920390728" Y="-13.995190528383292" />
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
              </Canvas>
            </Viewbox>
          </Grid>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <!--
      WPF migration note: MultiTrigger 条件�?Setter 为空，已注释保留�?      原始片段�?      <MultiTrigger xmlns="https://github.com/avaloniaui">
                    <MultiTrigger.Conditions>
                      <Condition Property="ProgressBar.IsIndeterminate" Value="True" />
                      <Condition Property="UIElement.IsVisible" Value="True" />
                    </MultiTrigger.Conditions>
                    <MultiTrigger.EnterActions>
                      <BeginStoryboard Storyboard="{DynamicResource BusyIndicatorStoryboard}" x:Name="IsIndeterminateStoryboard" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                    </MultiTrigger.EnterActions>
                    <MultiTrigger.ExitActions>
                      <RemoveStoryboard BeginStoryboardName="IsIndeterminateStoryboard" />
                    </MultiTrigger.ExitActions>
                  </MultiTrigger>
    --></ControlTheme>
