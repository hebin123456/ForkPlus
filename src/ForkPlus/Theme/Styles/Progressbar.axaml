    </DoubleAnimationUsingKeyFrames>
  </Storyboard>
 -->
  <!-- LfsProgressBar ControlTheme 已迁至 UI/UserControls/BinaryDiff/BinaryContentUserControl.axaml
       （Style Selector="ProgressBar.lfs"）：ControlTheme 无 BasedOn 会失去 Fluent 模板，
       且 {x:Type ProgressBar} 键在延迟构建场景 StaticResource 找不到。 -->
</ResourceDictionary>