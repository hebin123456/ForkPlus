<!-- Migration Notes (WPF -> Avalonia):
     - Root xmlns set to https://github.com/avaloniaui; removed duplicate xmlns:x on child elements.
     - Style TargetType="{x:Type ...}" -> Selector="..."; x:Key values preserved.
     - Property prefixes stripped (Panel.Background -> Background, Border.BorderBrush -> BorderBrush,
       TextElement.Foreground -> Foreground, TextBoxBase.CaretBrush -> CaretBrush,
       Border.BorderThickness -> BorderThickness, Control.HorizontalContentAlignment -> HorizontalContentAlignment,
       FrameworkElement.FocusVisualStyle -> FocusVisualStyle, UIElement.AllowDrop -> AllowDrop,
       Border.CornerRadius -> CornerRadius, Control.Template -> Template, UIElement.Opacity -> Opacity,
       PasswordBox.PasswordChar -> PasswordChar, PasswordBox.CaretBrush -> CaretBrush,
       TextBoxBase.SelectionBrush -> SelectionBrush).
     - TemplateBinding class prefixes stripped (e.g. {TemplateBinding BorderBrush} -> {TemplateBinding BorderBrush}).
     - ControlTemplate.Triggers converted to nested <Style.Styles> using /template/ selectors with ^ parent reference.
     - Pseudo-class mapping: UIElement.IsEnabled=False -> :disabled, UIElement.IsKeyboardFocused=True -> :focus.
     - NOTE (Avalonia limitation): Style.Triggers MultiTrigger (IsInactiveSelectionHighlightEnabled=true AND IsSelectionActive=false)
       cannot be expressed as a single Avalonia selector (both conditions are non-pseudo-class properties);
       original logic preserved as comment, needs code-behind or a data-trigger approach. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="TextBox" Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
<Setter Property="AllowDrop" Value="true" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <ScrollViewer Background="#00FFFFFF" Focusable="false" x:Name="PART_ContentHost" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:disabled /template/ Border#Border">
      <Setter Property="Opacity" Value="0.56" />
    </Style>
    <Style Selector="^:focus /template/ Border#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentBrush}" />
    </Style>
    <!-- NOTE (Avalonia limitation): Original WPF MultiTrigger in Style.Triggers:
         Conditions: TextBoxBase.IsInactiveSelectionHighlightEnabled=true AND TextBoxBase.IsSelectionActive=false
         Setter: SelectionBrush = {DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}
         Cannot be expressed as an Avalonia selector (both conditions are non-pseudo-class properties).
         Needs code-behind or a binding-based approach. -->
  </Style>
  <Style x:Key="PasswordBox" Selector="PasswordBox">
    <Setter Property="PasswordChar" Value="●" />
    <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
<Setter Property="AllowDrop" Value="true" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Border">
            <ScrollViewer Focusable="false" x:Name="PART_ContentHost" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:disabled /template/ Border#Border">
      <Setter Property="Opacity" Value="0.56" />
    </Style>
    <Style Selector="^:focus /template/ Border#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentBrush}" />
    </Style>
    <!-- NOTE (Avalonia limitation): Original WPF MultiTrigger in Style.Triggers:
         Conditions: PasswordBox.IsInactiveSelectionHighlightEnabled=true AND PasswordBox.IsSelectionActive=false
         Setter: SelectionBrush = {DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}
         Cannot be expressed as an Avalonia selector (both conditions are non-pseudo-class properties).
         Needs code-behind or a binding-based approach. -->
  </Style>
</ResourceDictionary>
