                <controls:PlaceholderTextBox Grid.Row="0" Margin="4,4,4,2" Placeholder="{DynamicResource Search}" controls:PlaceholderTextBox.Icon="{DynamicResource SearchOnIcon}" x:Name="PART_SearchBox" />
                <ScrollViewer Grid.Row="1" x:Name="SubMenuScrollViewer">
                  <Grid x:Name="Grid1">
                    <Canvas HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0" x:Name="Canvas">
                      <Rectangle x:Name="OpaqueRect">
                        <Rectangle.Fill>
                          <Binding Path="Background" />
                        </Rectangle.Fill>
                        <Rectangle.Height>
                          <Binding Path="Bounds.Height" />
                        </Rectangle.Height>
                        <Rectangle.Width>
                          <Binding Path="Bounds.Width" />
                        </Rectangle.Width>
                      </Rectangle>
                    </Canvas>
                    <Rectangle Fill="{TemplateBinding Background}" HorizontalAlignment="Left" Margin="29,2,0,2" Width="1" x:Name="Rectangle" />
                    <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.TabNavigation="Cycle" x:Name="ItemsPresenter" />
                  </Grid>
                </ScrollViewer>
              </Grid>
            </Border>
          </Border>
        </Popup>
      </Grid>
    </Border>
