<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 阶段 6：跨平台 TFM。
         主目标 net10.0（跨平台，Linux/macOS/Windows 均可构建运行）。
         net10.0-windows10.0.19041.0 作为次要目标，保留 Windows 专属 API 编译路径（WinRT / Microsoft.Win32.Registry 等）。
         非平台特定的代码必须用 [SupportedOSPlatform] 守卫，CA1416 在 net10.0 目标下会校验。
         Avalonia 11.3.18 包对 net10.0 / net10.0-windows 均兼容。
         UseWPF 必须关闭，否则 XAML 编译器与 Avalonia 冲突。 -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- 阶段 5→7：WPF→Avalonia 迁移已完成，开启编译期绑定以支持 NativeAOT。
         原 WPF XAML 全部使用运行时绑定（WPF 无编译期绑定），DataTemplate 未声明 DataType，
         开启 CompiledBindingsByDefault 会导致 "Unable to resolve property on XamlPseudoType" 错误。
         已为所有 DataTemplate 补齐 DataType 标注，编译期绑定生效后反射绑定（ReflectionBinding）
         警告消除，AOT 兼容性提升。
         改造进度：74 个 XAML 文件 385 个错误待修复（AVLN2000 DataTemplate 缺 DataType + AVLN2100 顶层缺 x:DataType）。
         每个文件需分析 code-behind 的 DataContext / ItemsSource 类型才能确定正确的 DataType，
         属于大型语义重构，分批推进。未完成前保持 false 以维持构建可用。 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>ForkPlus</AssemblyName>
    <TargetName>ForkPlus</TargetName>
    <RootNamespace>ForkPlus</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <!-- 不生成 .xml 文档注释导出文件（运行时不需要，仅供 IDE IntelliSense / API 文档用途）。
         .NET SDK 默认会为 Release build 生成 *.xml，与 dll 同名，导致产物目录多出大量 xml 文件。-->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 阶段 6：跨平台 TFM 后，net10.0 目标对 x86 不支持，统一改 AnyCPU。
         Avalonia 桌面后端在 Windows 仍可用 x64 apphost；此处不锁定平台位数。 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)obj\**;$(MSBuildThisFileDirectory)obj_agent\**;$(MSBuildThisFileDirectory)bin\**</DefaultItemExcludes>
    <!-- Avalonia 11.3 + net10.0 跨平台目标下，部分第三方包 API 仍标注 [SupportedOSPlatform("Windows")]。
         CA1416 在 net10.0 目标下会触发警告（已用 [SupportedOSPlatform] 守卫），暂时静默以推进构建。 -->
    <NoWarn>$(NoWarn);CS0067;CS0108;CS0169;CS0414;CS1522;CS0652;CS8073;CS8632;CA1416</NoWarn>
    <!-- 阶段 7：NativeAOT 第三方库 trim/AOT 警告静默。
         IL2104：引用的程序集（Avalonia.Controls.DataGrid / Newtonsoft.Json / OxyPlot / Markdown.Avalonia）
                 内部产生 trim 警告，无法在本项目代码中修复，需等待上游版本更新。
         IL3053：同上，AOT 分析警告（Newtonsoft.Json / Avalonia.Controls.DataGrid）。
         这些是程序集级别的聚合警告，[UnconditionalSuppressMessage] 无法抑制（仅适用于本程序集代码）。
         已对实际使用点加 [UnconditionalSuppressMessage] 抑制具体方法警告（见 NotificationManager / Connection 等），
         此处仅静默聚合警告以保持 AOT publish 输出干净。 -->
    <NoWarn Condition="'$(PublishAot)' == 'true'">$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <!-- 阶段 6：定义 WINDOWS 编译符号，仅 net10.0-windows 目标启用。
       用于 #if WINDOWS 守卫 WinRT / CommunityToolkit.WinUI.Notifications 等 Windows-only 引用。 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="assets\**\*.*" />
    <None Remove="ForkPlus.Assets.Legal.txt" />
    <None Remove="ForkPlus.Assets.gitignore.txt" />
    <None Remove="ForkPlus.Assets.md-ai-output.css" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 资源：avares:// URI 只能解析 AvaloniaResource 项（WPF 的 <Resource> 在 Avalonia
         工程中不会被打包进 !AvaloniaResources blob，运行时 AssetLoader.Open 抛 FileNotFoundException）。
         assets/ 目录下全部为 PNG 图标资源，由 XAML/C# 通过 avares://ForkPlus/assets/<name>.png 加载。 -->
    <AvaloniaResource Include="assets\**\*.*" />
    <Content Include="Languages\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\gitmm\README.md">
      <Link>Docs\gitmm.zh-Hans.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\gitmm\README.zh-Hant.md">
      <Link>Docs\gitmm.zh-Hant.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\gitmm\README.en.md">
      <Link>Docs\gitmm.en.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\gitmm\README.ja.md">
      <Link>Docs\gitmm.ja.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\gitmm\README.ko.md">
      <Link>Docs\gitmm.ko.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\gitmm\README.fr.md">
      <Link>Docs\gitmm.fr.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\gitmm\README.de.md">
      <Link>Docs\gitmm.de.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\gitmm\README.es.md">
      <Link>Docs\gitmm.es.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\RELEASE_NOTE.md">
      <Link>Docs\RELEASE_NOTE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="ForkPlus.Assets.Legal.txt" LogicalName="ForkPlus.Assets.Legal.txt" />
    <EmbeddedResource Include="ForkPlus.Assets.gitignore.txt" LogicalName="ForkPlus.Assets.gitignore.txt" />
    <EmbeddedResource Include="ForkPlus.Assets.md-ai-output.css" LogicalName="ForkPlus.Assets.md-ai-output.css" />
  </ItemGroup>

  <!-- .NET 10 SDK 风格工程：PresentationCore / WindowsBase / System.* 由框架隐式提供，
       无需显式 Reference。原 net472 时代的 6 个 Reference 节已删除。-->

  <ItemGroup>
    <!-- ===== Avalonia 11.3.18 核心包（阶段 4 里程碑 4.1 引入）=====
         全家桶必须严格同版本，否则触发程序集版本冲突。
         - Avalonia：框架核心（属性系统/控件基类/XAML 编译器）
         - Avalonia.Desktop：桌面平台元包（Win32/X11/macOS Native 后端）
         - Avalonia.Themes.Fluent：默认主题，App.axaml 中 <FluentTheme /> 引用
         - Avalonia.Fonts.Inter：内嵌 Inter 字体，跨平台一致性
         - Avalonia.Controls.DataGrid：DataGrid 控件（11.x 起独立包）
         - Avalonia.Diagnostics：F12 开发者工具，仅 Debug 配置引用
                              （Avalonia 12 起被移除，由 Avalonia Plus 付费替代） -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <!-- DataGrid 包版本号与 Avalonia 主包不同步：11.3 系列最高 11.3.13（不是 11.3.18）。 -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <!-- ===== 第三方库 Avalonia 替代（阶段 4 里程碑 4.7）=====
         AvalonEdit 6.3.1.120 → Avalonia.AvaloniaEdit 11.4.1（官方移植，API 高度一致）
         OxyPlot.Wpf 2.2.0 → OxyPlot.Avalonia 2.1.0-Avalonia11（适配 Avalonia 11 的预发布版本；
                              稳定版 2.1.0 仅适配 Avalonia 0.10，已过时）
         OneWare.Markdown.Avalonia.Tight 11.3.17.1（阶段 4.7-c 引入）：WebView2 的跨平台替代，
              将 Markdown 渲染为原生 Avalonia 控件（Border/Grid/TextBlock）。
              Tight 变体不含 AvaloniaEdit 依赖（避免与 Avalonia.AvaloniaEdit 11.4.1 版本冲突）。
              依赖 Avalonia >= 11.3.17 + OneWare.ColorDocument/ColorTextBlock.Avalonia。
              程序集名 Markdown.Avalonia，命名空间 Markdown.Avalonia，控件 MarkdownScrollViewer。 -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="OxyPlot.Avalonia" Version="2.1.0-Avalonia11" />
    <PackageReference Include="OneWare.Markdown.Avalonia.Tight" Version="11.3.17.1" />
    <!-- ===== 暂保留包（阶段 4 后续里程碑替换/移除）=====
         - CommunityToolkit.WinUI.Notifications：仅 Windows TFM 引用（Toast 通知 Windows-only）；
           非Windows TFM 下 NotificationManager 用反射延迟加载 WinRT，运行时已加 IsWindows 守卫 -->
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
    <!-- 阶段 6 修复：Microsoft.Win32.Registry 在 net10.0 和 net10.0-windows 下都不在 BCL。
         原注释称"net10.0-windows 下随 Windows Desktop SDK 隐式提供"是错误的——
         UseWPF=false / UseWindowsForms=false 时 Windows Desktop SDK 不会被引入，
         Microsoft.Win32.Registry 程序集必须通过 NuGet 包显式提供。
         移除 Condition 让两个 TFM 都引用，避免 net10.0-windows 运行时 TypeLoadException
         （App.IsSystemAccentBrushEnabled / App.GetSystemTheme / WpfSystemThemeService 均依赖 Registry）。 -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.1.3" />
    <PackageReference Include="NuGet.Versioning" Version="7.6.0" />
    <!-- 阶段 6：net10.0 目标下 System.Drawing.Common 不在 BCL，需显式引入。
         OxyPlot.Avalonia 在 net10.0-windows 下传递引入；net10.0 下不再传递。
         官方仅 Windows 受支持，但 Linux/macOS 可加 runtimeconfig runAsUnlimited 开关使用，
         本项目 IconTools / BinaryDiffUserControl 已对 GDI+ 在 Unix 上的失败做 try/catch 兜底。 -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForkPlus.AskPass\ForkPlus.AskPass.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\ForkPlus.RI\ForkPlus.RI.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- 阶段 5：Avalonia 11 的 XAML 编译器默认仅自动包含 *.axaml 文件。
       本项目从 WPF 迁移而来，242 个视图/资源字典仍沿用 *.xaml 扩展名（仅 App.axaml 已改名）。
       若不显式声明为 AvaloniaXaml，这些文件的代码生成（InitializeComponent、x:Name 字段）不会产出，
       导致 ~5000 个 CS0103 “InitializeComponent/命名控件不存在” 编译错误。
       *.xaml glob 不会匹配 *.axaml，App.axaml 不会被重复计入。 -->
  <ItemGroup>
    <AvaloniaXaml Include="**\*.xaml" />
  </ItemGroup>

  <!-- biturbo 原生库（Rust cdylib，封装 libgit2 + zlib）不再以二进制提交到仓库，改为构建期从
       Biturbo 仓库最新 release 拉取。Biturbo v1.1.0 起发布多平台 asset：
         Windows → biturbo.dll
         Linux   → libbiturbo.so
         macOS   → libbiturbo.dylib
       本 target 按 $(OS) 选择对应 asset，缺失时下载到 third_party/；已存在则跳过。
       CI 每次全新 checkout 都会拉最新版。
       带 curl 重试（5 次，指数退避）以容忍 GitHub release 下载偶发 SSL 连接中断
       （非 Windows runner 在 release-assets.githubusercontent.com 上偶发 SSL_ERROR_SYSCALL）。-->
  <Target Name="RestoreBiturbo" BeforeTargets="Build">
    <PropertyGroup>
      <BiturboBaseUrl>https://github.com/hebin123456/Biturbo/releases/latest/download</BiturboBaseUrl>
    </PropertyGroup>
    <!-- Windows: PowerShell 拉取 biturbo.dll（带 3 次重试 + 指数退避） -->
    <Exec Condition="'$(OS)' == 'Windows_NT' And !Exists('..\..\third_party\biturbo.dll')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; New-Item -ItemType Directory -Force -Path '..\..\third_party' | Out-Null; $url='$(BiturboBaseUrl)/biturbo.dll'; $out='..\..\third_party\biturbo.dll'; $maxAttempts=3; for($i=1; $i -le $maxAttempts; $i++){ try { Invoke-WebRequest -Uri $url -OutFile $out -UseBasicParsing -UserAgent 'ForkPlus-Build' -TimeoutSec 120; break } catch { $msg = $error[0].Exception.Message; Write-Host &quot;Attempt $i failed: $msg&quot;; if($i -eq $maxAttempts){ throw }; Start-Sleep -Seconds (5*$i) } }; Write-Host 'Restored biturbo.dll from Biturbo latest release'&quot;" />
    <!-- Unix (Linux/macOS): bash + curl，按 uname -s 选 .so / .dylib。
         用反引号 `uname -s` 做 bash 命令替换，避免 MSBuild 把 $(...) 当属性展开；
         $(BiturboBaseUrl) 仍由 MSBuild 正常展开。
         retry 选项应对 release-assets.githubusercontent.com 偶发 SSL_ERROR_SYSCALL (curl 35)。-->
    <Exec Condition="'$(OS)' == 'Unix' And !Exists('..\..\third_party\libbiturbo.so') And !Exists('..\..\third_party\libbiturbo.dylib')"
          Command="bash -c 'set -e; mkdir -p ../../third_party; os=`uname -s`; if [ &quot;$os&quot; = &quot;Darwin&quot; ]; then url=&quot;$(BiturboBaseUrl)/libbiturbo.dylib&quot;; out=&quot;../../third_party/libbiturbo.dylib&quot;; else url=&quot;$(BiturboBaseUrl)/libbiturbo.so&quot;; out=&quot;../../third_party/libbiturbo.so&quot;; fi; curl -fsSL &quot;$url&quot; -o &quot;$out&quot; --user-agent &quot;ForkPlus-Build&quot; --connect-timeout 120 --retry 5 --retry-delay 5 --retry-all-errors; echo &quot;Restored $out from Biturbo latest release&quot;'" />
  </Target>

  <!-- tokei（代码行数统计，MIT 协议）从 hebin123456/tokei 仓库最新 release 拉取预编译二进制，
       不再从源码 cargo 编译（与 biturbo 一致的发布产物拉取模式）。
       Windows: tokei-x86_64-pc-windows-msvc.exe → tokei.exe
       Linux:   tokei-x86_64-unknown-linux-gnu.tar.gz → 解压取 tokei
       macOS:   tokei-aarch64-apple-darwin.tar.gz → 解压取 tokei
                （tokei 上游仅发布 ARM64 asset；Intel Mac 通过 Rosetta 2 运行）
       本 target 缺失时下载到 third_party/；已存在则跳过。CI 每次全新 checkout 都会拉最新版。
       带重试（5 次，指数退避）以容忍 GitHub release 下载偶发 SSL 连接中断
       （release-assets.githubusercontent.com 偶发 SSL_ERROR_SYSCALL）。-->
  <Target Name="RestoreTokei" BeforeTargets="Build" Condition="!Exists('..\..\third_party\tokei.exe') And !Exists('..\..\third_party\tokei')">
    <PropertyGroup>
      <TokeiBaseUrl>https://github.com/hebin123456/tokei/releases/latest/download</TokeiBaseUrl>
    </PropertyGroup>
    <!-- Windows: PowerShell 拉取 tokei.exe（带 3 次重试 + 指数退避） -->
    <Exec Condition="'$(OS)' == 'Windows_NT' And !Exists('..\..\third_party\tokei.exe')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; New-Item -ItemType Directory -Force -Path '..\..\third_party' | Out-Null; $url='$(TokeiBaseUrl)/tokei-x86_64-pc-windows-msvc.exe'; $out='..\..\third_party\tokei.exe'; $maxAttempts=3; for($i=1; $i -le $maxAttempts; $i++){ try { Invoke-WebRequest -Uri $url -OutFile $out -UseBasicParsing -UserAgent 'ForkPlus-Build' -TimeoutSec 120; break } catch { $msg = $error[0].Exception.Message; Write-Host &quot;Attempt $i failed: $msg&quot;; if($i -eq $maxAttempts){ throw }; Start-Sleep -Seconds (5*$i) } }; Write-Host 'Restored tokei.exe from tokei latest release'&quot;" />
    <!-- Unix (Linux/macOS): bash + curl + tar，按 uname -s 选 asset。
         tar.gz 解压后只保留 tokei 二进制（删除 .tar.gz），文件名去掉 .exe 后缀。
         macOS asset 名为 aarch64-apple-darwin（tokei 上游仅发布 ARM64）；
         retry-all-errors 选项应对 release-assets.githubusercontent.com 偶发 SSL_ERROR_SYSCALL。-->
    <Exec Condition="'$(OS)' == 'Unix' And !Exists('..\..\third_party\tokei')"
          Command="bash -c 'set -e; mkdir -p ../../third_party; os=`uname -s`; if [ &quot;$os&quot; = &quot;Darwin&quot; ]; then asset=&quot;tokei-aarch64-apple-darwin.tar.gz&quot;; else asset=&quot;tokei-x86_64-unknown-linux-gnu.tar.gz&quot;; fi; url=&quot;$(TokeiBaseUrl)/$asset&quot;; tmpfile=&quot;../../third_party/tokei.tar.gz&quot;; curl -fsSL &quot;$url&quot; -o &quot;$tmpfile&quot; --user-agent &quot;ForkPlus-Build&quot; --connect-timeout 120 --retry 5 --retry-delay 5 --retry-all-errors; tar -xzf &quot;$tmpfile&quot; -C ../../third_party/ tokei 2>/dev/null || tar -xzf &quot;$tmpfile&quot; -C ../../third_party/ --strip-components=1; chmod +x ../../third_party/tokei; rm -f &quot;$tmpfile&quot;; echo &quot;Restored tokei from tokei latest release&quot;'" />
  </Target>

  <Target Name="CopyHelperExecutables" AfterTargets="Build" Condition="'$(TargetDir)' != ''">
    <!-- 子进程 exe 用 $(TargetFramework) 跟随主工程 TFM（net10.0 / net10.0-windows10.0.19041.0）。
         Exists 守卫保证非 Windows build 或子项目尚未构建时不会失败。-->
    <!-- .NET 10 下 exe 是 native apphost（启动器），托管代码在同名 .dll 中，
         apphost 还需 .runtimeconfig.json 才能解析运行时框架。三者必须一起拷到主程序
         输出目录，否则主程序 spawn ForkPlus.AskPass.exe 时报“缺少 ForkPlus.AskPass.dll”
         （v3.5.0 迁移时漏拷 .dll/.runtimeconfig.json，v3.5.1 修复）。-->
    <Copy SourceFiles="..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\ForkPlus.AskPass.exe" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\ForkPlus.AskPass.exe')" />
    <Copy SourceFiles="..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\ForkPlus.AskPass.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\ForkPlus.AskPass.dll')" />
    <Copy SourceFiles="..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\ForkPlus.AskPass.runtimeconfig.json" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\ForkPlus.AskPass.runtimeconfig.json')" />
    <Copy SourceFiles="..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\ForkPlus.RI.exe" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\ForkPlus.RI.exe')" />
    <Copy SourceFiles="..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\ForkPlus.RI.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\ForkPlus.RI.dll')" />
    <Copy SourceFiles="..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\ForkPlus.RI.runtimeconfig.json" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\ForkPlus.RI.runtimeconfig.json')" />
    <!-- biturbo 原生库按平台拷贝：Exists 守卫确保只拷实际存在的那一份 -->
    <Copy SourceFiles="..\..\third_party\biturbo.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\biturbo.dll')" />
    <Copy SourceFiles="..\..\third_party\libbiturbo.so" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\libbiturbo.so')" />
    <Copy SourceFiles="..\..\third_party\libbiturbo.dylib" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\libbiturbo.dylib')" />
    <Copy SourceFiles="..\..\third_party\tokei.exe" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\tokei.exe')" />
    <Copy SourceFiles="..\..\third_party\tokei" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\tokei')" />
  </Target>

  <!-- NativeAOT publish 模式下，子进程（AskPass / RI）和原生库（biturbo / tokei）拷贝到主工程 publish 目录。
       AOT publish 后产物路径为 bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\，
       子进程需在 CI 里先单独 publish AOT（同 RID），主工程 publish 时此 target 把它们的单文件可执行
       产物拷贝过来。Exists 守卫保证子进程未 AOT publish 时不失败（fallback 到 framework-dependent build）。
       Windows AOT 产物带 .exe 后缀，Linux/macOS 无后缀，两者都检查。.dbg 调试符号不拷贝（体积大，分发不需要）。-->
  <Target Name="CopyAotDependencies" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' != '' And '$(PublishDir)' != ''">
    <!-- AskPass AOT 产物 -->
    <Copy SourceFiles="..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\ForkPlus.AskPass.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\ForkPlus.AskPass.exe')" />
    <Copy SourceFiles="..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\ForkPlus.AskPass" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.AskPass\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\ForkPlus.AskPass')" />
    <!-- RI AOT 产物 -->
    <Copy SourceFiles="..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\ForkPlus.RI.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\ForkPlus.RI.exe')" />
    <Copy SourceFiles="..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\ForkPlus.RI" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('..\ForkPlus.RI\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\ForkPlus.RI')" />
    <!-- 原生库（biturbo / tokei） -->
    <Copy SourceFiles="..\..\third_party\biturbo.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\biturbo.dll')" />
    <Copy SourceFiles="..\..\third_party\libbiturbo.so" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\libbiturbo.so')" />
    <Copy SourceFiles="..\..\third_party\libbiturbo.dylib" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\libbiturbo.dylib')" />
    <Copy SourceFiles="..\..\third_party\tokei.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\tokei.exe')" />
    <Copy SourceFiles="..\..\third_party\tokei" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\tokei')" />
  </Target>
</Project>
