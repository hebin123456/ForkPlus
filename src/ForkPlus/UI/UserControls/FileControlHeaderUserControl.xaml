<!-- 阶段 4.5：WPF→Avalonia XAML 迁移。
     - xmlns schemas.microsoft.com → https://github.com/avaloniaui
     - 删除子元素重复 xmlns（presentation / x）
     - <Grid.Children>/<StackPanel.Children> 展开为直接子元素
     - FilePathTextBlock 改用 controls: 前缀（移除 xmlns 默认命名空间覆盖）
     - 6 个 ToggleButton.IsChecked->Image.Source 的 Style.Triggers/DataTrigger 块
       (IgnoreWhitespaces/ShowHiddenSymbols/WordWrap/ShowEntireFile/DiffLayoutMode/HighlightPixels)
       → 顶层 <UserControl.Styles> 中
         <Style Selector="ToggleButton#<name> > Image"> 设默认 (unchecked) 图标
         <Style Selector="ToggleButton#<name>:checked > Image"> 设选中 (checked) 图标
       原来的内联 <Image.Style><Style.Triggers> 全部移除。
     - IsVisible="False" → IsVisible="False"（3 个容器 StackPanel）
     -->
<UserControl BorderThickness="0,0,0,1" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:fuu="clr-namespace:ForkPlus.UI.UserControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.FileControlHeaderUserControl" xmlns:fuc="clr-namespace:ForkPlus.UI.Controls">
  <UserControl.BorderBrush>
    <DynamicResource ResourceKey="BorderBrush" />
  </UserControl.BorderBrush>
  <UserControl.Styles>
    <!-- 阶段 4.5：替代原 6 个 <Image.Style><Style.Triggers> 块。
         每对样式对应一个 ToggleButton，原 DataTrigger 绑定祖先 ToggleButton.IsChecked=True/False
         转换为 :checked 伪类选择器。unchecked 状态由默认 Style 提供 Source。 -->
    <Style Selector="ToggleButton#IgnoreWhitespacesToggleButton > Image">
      <Setter Property="Source" Value="{DynamicResource IgnoreWhiteSpacesIcon}" />
    </Style>
    <Style Selector="ToggleButton#IgnoreWhitespacesToggleButton:checked > Image">
      <Setter Property="Source" Value="{DynamicResource IgnoreWhiteSpacesOnIcon}" />
    </Style>
    <Style Selector="ToggleButton#ShowHiddenSymbolsToggleButton > Image">
      <Setter Property="Source" Value="{DynamicResource ShowHiddenSymbolsIcon}" />
    </Style>
    <Style Selector="ToggleButton#ShowHiddenSymbolsToggleButton:checked > Image">
      <Setter Property="Source" Value="{DynamicResource ShowHiddenSymbolsOnIcon}" />
    </Style>
    <Style Selector="ToggleButton#WordWrapToggleButton > Image">
      <Setter Property="Source" Value="{DynamicResource WordWrapIcon}" />
    </Style>
    <Style Selector="ToggleButton#WordWrapToggleButton:checked > Image">
      <Setter Property="Source" Value="{DynamicResource WordWrapOnIcon}" />
    </Style>
    <Style Selector="ToggleButton#ShowEntireFileToggleButton > Image">
      <Setter Property="Source" Value="{DynamicResource ShowEntireFileIcon}" />
    </Style>
    <Style Selector="ToggleButton#ShowEntireFileToggleButton:checked > Image">
      <Setter Property="Source" Value="{DynamicResource ShowEntireFileOnIcon}" />
    </Style>
    <Style Selector="ToggleButton#DiffLayoutModeToggleButton > Image">
      <Setter Property="Source" Value="{DynamicResource SideBySideIcon}" />
    </Style>
    <Style Selector="ToggleButton#DiffLayoutModeToggleButton:checked > Image">
      <Setter Property="Source" Value="{DynamicResource SideBySideOnIcon}" />
    </Style>
    <Style Selector="ToggleButton#HighlightPixelsToggleButton > Image">
      <Setter Property="Source" Value="{DynamicResource HighlightPixelsIcon}" />
    </Style>
    <Style Selector="ToggleButton#HighlightPixelsToggleButton:checked > Image">
      <Setter Property="Source" Value="{DynamicResource HighlightPixelsOnIcon}" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="140" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Orientation="Horizontal" IsVisible="False" x:Name="TextModeNavigationButtonsContainer">
      <Button IsTabStop="False" Click="PreviousButton_Click" x:Name="PreviousButton">
        <ToolTip.Tip>Go to previous change</ToolTip.Tip>
        <Image>
          <Image.Source>
            <DynamicResource ResourceKey="UpIcon" />
          </Image.Source>
          <Image.VerticalAlignment>Center</Image.VerticalAlignment>
        </Image>
      </Button>
      <Button IsTabStop="False" Click="NextButton_Click" x:Name="NextButton">
        <ToolTip.Tip>Go to next change</ToolTip.Tip>
        <Image>
          <Image.Source>
            <DynamicResource ResourceKey="DownIcon" />
          </Image.Source>
          <Image.VerticalAlignment>Center</Image.VerticalAlignment>
        </Image>
      </Button>
    </StackPanel>
    <DockPanel Grid.Column="1" HorizontalAlignment="Center">
      <Image DockPanel.Dock="Left" Margin="2,1,2,1" VerticalAlignment="Center" HorizontalAlignment="Right" x:Name="FileTypeImage" />
      <controls:FilePathTextBlock x:Name="FilePathTextBlock">
        <controls:FilePathTextBlock.Foreground>
          <DynamicResource ResourceKey="ForegroundBrush.Gray" />
        </controls:FilePathTextBlock.Foreground>
        <controls:FilePathTextBlock.Margin>0</controls:FilePathTextBlock.Margin>
      </controls:FilePathTextBlock>
    </DockPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="False" x:Name="TextModeButtonsContainer">
      <ToggleButton IsTabStop="False" Click="IgnoreWhitespacesToggleButton_Click" x:Name="IgnoreWhitespacesToggleButton">
        <ToolTip.Tip>Ignore whitespaces</ToolTip.Tip>
        <Image />
      </ToggleButton>
      <ToggleButton IsTabStop="False" Click="ShowHiddenSymbolsToggleButton_Click" x:Name="ShowHiddenSymbolsToggleButton">
        <ToolTip.Tip>Show hidden symbols</ToolTip.Tip>
        <Image />
      </ToggleButton>
      <ToggleButton IsTabStop="False" Click="WordWrapToggleButton_Click" x:Name="WordWrapToggleButton">
        <ToolTip.Tip>Word wrap</ToolTip.Tip>
        <Image />
      </ToggleButton>
      <Button IsTabStop="False" Click="DecreaseVisibleLines_Click" x:Name="DecreaseNumberOfVisibleLinesButton">
        <ToolTip.Tip>Decrease number of visible lines</ToolTip.Tip>
        <Image>
          <Image.Source>
            <DynamicResource ResourceKey="DecreaseVisibleLinesIcon" />
          </Image.Source>
        </Image>
      </Button>
      <Button IsTabStop="False" Click="IncreaseVisibleLines_Click" x:Name="IncreaseNumberOfVisibleLinesButton">
        <ToolTip.Tip>Increase number of visible lines</ToolTip.Tip>
        <Image>
          <Image.Source>
            <DynamicResource ResourceKey="IncreaseVisibleLinesIcon" />
          </Image.Source>
        </Image>
      </Button>
      <ToggleButton IsTabStop="False" Click="ShowEntireFileToggleButton_Click" x:Name="ShowEntireFileToggleButton">
        <ToolTip.Tip>Show entire file</ToolTip.Tip>
        <Image />
      </ToggleButton>
      <ToggleButton IsTabStop="False" Click="DiffLayoutModeToggleButton_Click" x:Name="DiffLayoutModeToggleButton">
        <Image />
      </ToggleButton>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="False" x:Name="ImageModeButtonsContainer">
      <ToggleButton IsTabStop="False" Click="HighlightPixelsToggleButton_Click" x:Name="HighlightPixelsToggleButton">
        <ToolTip.Tip>Highlight pixels</ToolTip.Tip>
        <Image />
      </ToggleButton>
    </StackPanel>
  </Grid>
</UserControl>
