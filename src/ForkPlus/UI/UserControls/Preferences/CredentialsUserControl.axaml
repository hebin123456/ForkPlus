<UserControl xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.Preferences.CredentialsUserControl" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <Grid Width="680">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Saved HTTP(S) credentials. User names are remembered automatically; 'Remember password' pre-fills the password in the dialog; 'Never ask' uses it silently. Add credentials in advance here — the switch re-enables prompting at any time." TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10" x:Name="DescriptionTextBlock" />
    <!-- 提前录入：host / 账号 / 密码 / 不再弹出开关 / Add / （末列留空对齐列表行的 Remove 列） -->
    <Border Grid.Row="1" BorderBrush="#22000000" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:PlaceholderTextBox Grid.Column="0" Placeholder="Host (e.g. github.com)" x:Name="AddHostTextBox" Margin="0,0,6,0" FontSize="13" />
        <controls:PlaceholderTextBox Grid.Column="1" Placeholder="User name" x:Name="AddUsernameTextBox" Margin="0,0,6,0" FontSize="13" />
        <controls:PlaceholderTextBox Grid.Column="2" Placeholder="Password" PasswordChar="●" x:Name="AddPasswordTextBox" Margin="0,0,8,0" FontSize="13" />
        <ToggleSwitch Grid.Column="3" x:Name="AddNeverAskToggle" OffContent="" OnContent="" Margin="0,0,10,0" />
        <Button Grid.Column="4" Content="Add" Click="AddButton_Click" x:Name="AddButton" />
        <!-- 第 5 列留空（与列表行的 Remove 列同宽，保证 host/账号/密码输入框与下方表格对齐） -->
        <Border Grid.Column="5" Width="0" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="CredentialsListPanel" />
    </ScrollViewer>
    <Button Grid.Row="3" Content="Ask Again for All Hosts" Click="AskAllAgainButton_Click" x:Name="AskAllAgainButton" HorizontalAlignment="Left" Margin="0,12,0,0" />
  </Grid>
</UserControl>
