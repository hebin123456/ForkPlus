<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.Preferences.ImportExportUserControl">
  <Grid Width="500">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.Children>
      <!-- 标题说明 -->
      <TextBlock Grid.Row="0" Text="Export your ForkPlus configuration (settings, custom commands, accounts) to a zip file, or import a previously exported file to restore on another machine." Margin="0,0,0,10" TextWrapping="Wrap" />

      <!-- 导出区 -->
      <TextBlock Grid.Row="1" Text="Export" FontWeight="Medium" Margin="0,0,0,4">
        <TextBlock.Style>
          <DynamicResource ResourceKey="SettingsHeaderTextBlockStyle" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
        </TextBlock.Style>
      </TextBlock>
      <CheckBox Grid.Row="2" x:Name="IncludeAccountsCheckBox" Content="Include accounts (contains tokens/credentials)" IsChecked="True" Margin="10,0,0,6" />
      <Button Grid.Row="3" x:Name="ExportButton" Content="Export to file..." Padding="12,4" Margin="10,0,0,0" HorizontalAlignment="Left" Click="ExportButton_Click" />

      <!-- 分隔 -->
      <Border Grid.Row="4" Height="1" Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Margin="0,14,0,14" />

      <!-- 导入区 -->
      <TextBlock Grid.Row="5" Text="Import" FontWeight="Medium" Margin="0,0,0,4">
        <TextBlock.Style>
          <DynamicResource ResourceKey="SettingsHeaderTextBlockStyle" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
        </TextBlock.Style>
      </TextBlock>
      <TextBlock Grid.Row="6" Text="Importing will overwrite your current configuration. ForkPlus will restart after import." Margin="10,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
      <Button Grid.Row="7" x:Name="ImportButton" Content="Import from file..." Padding="12,4" Margin="10,0,0,0" HorizontalAlignment="Left" Click="ImportButton_Click" />

      <!-- 状态文本 -->
      <TextBlock Grid.Row="8" x:Name="StatusText" Text="" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid.Children>
  </Grid>
</UserControl>
