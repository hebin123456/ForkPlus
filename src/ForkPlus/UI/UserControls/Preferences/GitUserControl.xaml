<!-- 已从 WPF 迁移到 Avalonia：xmlns 替换为 https://github.com/avaloniaui；删除 ResourceDictionary / Style / 子控件上的重复 xmlns 与 xmlns:x 声明。
     阶段 4.5：原 Style.Triggers 中 DataTrigger 绑定 GitInstanceType=Separator 时把 ComboBoxItem 渲染为 Separator
     (Height=1, IsEnabled=False, 自定义 ControlTemplate 含 Separator)。Avalonia 不支持 Style.Triggers/DataTrigger，
     改为在 ItemTemplate 中堆叠 TextBlock + Separator，通过 IsVisible 绑定 GitInstanceType + EnumEqualsConverter 切换显示。 -->
<UserControl xmlns:Preferences="clr-namespace:ForkPlus.UI.UserControls.Preferences" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.Preferences.GitUserControl" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <Grid Width="500">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4,0,0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Git Instance:" />
    <ComboBox Grid.Row="0" Grid.Column="2" Margin="8,8,0,4" HorizontalAlignment="Stretch" SelectionChanged="GitInstanceComboBox_SelectionChanged" x:Name="GitInstanceComboBox">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <!-- 普通项：GitInstanceType != Separator -->
            <TextBlock FontSize="13" VerticalAlignment="Center" IsVisible="{Binding GitInstanceType, Converter={controls:EnumNotEqualsConverter}, ConverterParameter={x:Static Preferences:GitUserControl+GitInstanceType.Separator}}">
              <TextBlock.Text>
                <Binding Path="FileName" />
              </TextBlock.Text>
            </TextBlock>
            <!-- 分隔符项：GitInstanceType == Separator -->
            <Separator HorizontalAlignment="Stretch" Margin="0" IsVisible="{Binding GitInstanceType, Converter={controls:EnumEqualsConverter}, ConverterParameter={x:Static Preferences:GitUserControl+GitInstanceType.Separator}}" />
          </Grid>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <CheckBox Grid.Row="1" Grid.Column="2" Margin="10,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Enable verbose Git output" Checked="VerboseGitOutputCheckBox_Checked" Unchecked="VerboseGitOutputCheckBox_Checked" x:Name="VerboseGitOutputCheckBox" />
    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="git-mm Instance:" />
    <ComboBox Grid.Row="2" Grid.Column="2" Margin="8,8,0,4" HorizontalAlignment="Stretch" SelectionChanged="GitMmInstanceComboBox_SelectionChanged" x:Name="GitMmInstanceComboBox">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <TextBlock FontSize="13" VerticalAlignment="Center" IsVisible="{Binding GitInstanceType, Converter={controls:EnumNotEqualsConverter}, ConverterParameter={x:Static Preferences:GitUserControl+GitInstanceType.Separator}}">
              <TextBlock.Text>
                <Binding Path="FileName" />
              </TextBlock.Text>
            </TextBlock>
            <Separator HorizontalAlignment="Stretch" Margin="0" IsVisible="{Binding GitInstanceType, Converter={controls:EnumEqualsConverter}, ConverterParameter={x:Static Preferences:GitUserControl+GitInstanceType.Separator}}" />
          </Grid>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" />
    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="Global User Information" />
    <controls:AvatarImage Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" Margin="10,0,0,0" Width="42" Height="42" HorizontalAlignment="Right" x:Name="AuthorAvatarImage" />
    <controls:PlaceholderTextBox TextChanged="UserNameTextBox_TextChanged" LostFocus="UserNameTextBox_LostFocus" Grid.Row="5" Grid.Column="2" Margin="10,0,0,4" Padding="4,2,4,2" Placeholder="User name" x:Name="UserNameTextBox" />
    <controls:PlaceholderTextBox TextChanged="EmailTextBox_TextChanged" LostFocus="EmailTextBox_LostFocus" Grid.Row="6" Grid.Column="2" Margin="10,4,0,4" Padding="4,2,4,2" Placeholder="Email" x:Name="EmailTextBox" />
    <TextBlock Grid.Row="7" Grid.Column="2" Margin="12,0,10,0" VerticalAlignment="Center">
      <Span>
        <Run>Change the avatar at</Run> <Hyperlink NavigateUri="https://gravatar.com" RequestNavigate="Hyperlink_RequestNavigate"><TextBlock HorizontalAlignment="Center" Text="gravatar.com" /></Hyperlink></Span>
    </TextBlock>
  </Grid>
</UserControl>
