<UserControl xmlns:UserControls="clr-namespace:ForkPlus.UI.UserControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.UserColorsUserControl" xmlns="https://github.com/avaloniaui">
  <Border Theme="{DynamicResource MenuShadowBorderStyle}">
    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BackgroundBrush}" CornerRadius="6">
      <ItemsControl Margin="4" x:Name="Colors">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="4" Columns="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="1">
              <!-- Bug 修复（标记颜色后弹窗秒关）：原绑 IsCheckedChanged —— 打开弹窗时
                   Refresh() 预选中已有颜色的色块，TwoWay 绑定把 IsChecked 置 true 也会
                   触发该事件 → 被当作用户点击 → 立即应用颜色 + HidePopup，弹窗打开即自关。
                   改绑 Click：仅用户点击触发；绑定初始化/程序置值不触发。 -->
              <ToggleButton Click="ColorButton_Changed" x:Name="UserColorRadioButton" Theme="{DynamicResource UserColorToggleButton}">
                <ToggleButton.Background>
                  <Binding Path="Brush" />
                </ToggleButton.Background>
                <ToggleButton.IsChecked>
                  <Binding Path="IsSelected" />
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </Border>
</UserControl>