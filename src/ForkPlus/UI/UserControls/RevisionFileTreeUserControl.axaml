<UserControl xmlns:userControls="clr-namespace:ForkPlus.UI.UserControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.RevisionFileTreeUserControl" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <!-- Migration note：原 WPF x:Key="{DataTemplateKey {x:Type T}}" 按类型隐式查找，
       Avalonia 12 无此机制（ContentPresenter 只走逻辑树 Control.DataTemplates，不查资源字典），
       搬到根元素 DataTemplates 集合恢复按 DataType 匹配 -->
  <UserControl.DataTemplates>
<DataTemplate DataType="userControls:RevisionFileTreeViewItem">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" Height="14" Width="14">
            <Image.Source>
              <Binding Path="FileTypeIcon" />
            </Image.Source>
          </Image>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch">
            <TextBlock.Text>
              <Binding Path="Title" />
            </TextBlock.Text>
          </TextBlock>
        </Grid>
      </DataTemplate>
  </UserControl.DataTemplates>
  <Grid x:Name="ContainerGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition MinWidth="220" MaxWidth="850" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- v5.3.0：文件树顶部工具条 + 过滤框（与变更页 RevisionChangesUserControl 同款
         FilterTextBox / 视图模式下拉 / 并排 diff 按钮，Ctrl+F 呼出 / Esc 收起），
         按文件/目录路径子串过滤树节点 -->
    <DockPanel Grid.Row="0" Grid.Column="0" Height="17" HorizontalAlignment="Stretch" Background="{DynamicResource BackgroundBrush}" LastChildFill="False">
      <Button DockPanel.Dock="Left" Margin="6,0,0,0" ToolTip.Tip="Filter" Click="FilterButton_Click" Theme="{DynamicResource CodeEditorHeaderButtonStyle}">
        <Image Source="{DynamicResource SearchIcon}" />
      </Button>
      <controls:DropDownButton DockPanel.Dock="Right" Margin="0,0,6,0" ToolTip.Tip="View Mode" ClickMode="Press" x:Name="FileTreeSettingsDropdownButton" Theme="{DynamicResource CodeEditorHeaderDropDownButtonStyle}">
        <Image Source="{DynamicResource ListIcon}" VerticalAlignment="Center" />
        <controls:DropDownButton.ContextMenu>
          <ContextMenu Opened="FileTreeSettingsDropdownButton_ContextMenuOpened" />
        </controls:DropDownButton.ContextMenu>
      </controls:DropDownButton>
      <Button DockPanel.Dock="Right" ToolTip.Tip="Show diff side-by-side (space bar)" Click="ShowDiffPopupButton_Click" x:Name="ShowDiffPopupButton" Theme="{DynamicResource CodeEditorHeaderButtonStyle}">
        <Image Source="{DynamicResource PreviewIcon}" />
      </Button>
    </DockPanel>
    <Grid Grid.Row="1" Grid.Column="0" x:Name="FilterTextBoxAnimationPlaceholder" />
    <controls:FilterTextBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Margin="4" x:Name="FilterTextBox">
      <controls:FilterTextBox.AnimationPlaceholder>
        <Binding ElementName="FilterTextBoxAnimationPlaceholder" />
      </controls:FilterTextBox.AnimationPlaceholder>
    </controls:FilterTextBox>
    <controls:MultiselectionTreeView Grid.Row="2" Grid.Column="0" SelectionMode="Single" SelectionChanged="FilesTreeView_SelectedItemChanged" ContextRequested="FilesTreeView_ContextMenuOpening" x:Name="FilesTreeView" DoubleTapped="FilesTreeView_MouseDoubleClick">
      <controls:MultiselectionTreeView.ItemTemplate>
        <DataTemplate>
          <ContentControl>
            <ContentControl.Content>
              <Binding />
            </ContentControl.Content>
          </ContentControl>
        </DataTemplate>
      </controls:MultiselectionTreeView.ItemTemplate>
      <controls:MultiselectionTreeView.ContextMenu>
        <ContextMenu />
      </controls:MultiselectionTreeView.ContextMenu>
    </controls:MultiselectionTreeView>
    <controls:FileContentControl Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Background="{DynamicResource BackgroundBrush}" x:Name="FileContentControl" />
    <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" HorizontalAlignment="Right" x:Name="GridSplitter" Theme="{DynamicResource VerticalGridSplitter}" />
  </Grid>
</UserControl>