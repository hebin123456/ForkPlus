<UserControl x:Class="ForkPlus.UI.UserControls.DiffEntryRowUserControl" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderBrush="#00FFFFFF" BorderThickness="1" Background="#00FFFFFF" Margin="4,0,4,0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ToggleButton Grid.Row="0" Background="#00FFFFFF" BorderThickness="0" MinHeight="0" MinWidth="0" Padding="0" IsCheckedChanged="HeaderToggleButton_CheckedChanged" x:Name="HeaderToggleButton">
<!-- Migration note：WPF ToggleButton.FocusVisualStyle 块已删（Avalonia 无 FocusVisualStyle） -->

        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Border>
            <!--
      WPF migration note: ControlTemplate.Triggers（裸模板资源）：Avalonia 无等价，条件样式须移至 ControlTheme 嵌套样式。
      原始片段：
      <ControlTemplate.Triggers xmlns="https://github.com/avaloniaui">
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Cursor" Value="Hand" />
                    </Trigger>
                  </ControlTemplate.Triggers>
    -->
          </ControlTemplate>
        </ToggleButton.Template>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="33" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Path Grid.Column="0" Data="M0,0L3.5,3.5 0,7" HorizontalAlignment="Right" Margin="25,1,0,0" Stroke="{DynamicResource Expander.Static.Arrow.Stroke}" StrokeThickness="1.5" VerticalAlignment="Center" x:Name="ArrowPath" />
          <Image Grid.Column="1" Height="14" Width="14" Margin="2,0,2,0" VerticalAlignment="Center" Source="{Binding ChangeTypeIcon}" />
          <Image Grid.Column="2" Height="14" Width="14" Margin="2,0,2,0" VerticalAlignment="Center" Source="{Binding FileTypeIcon}" />
          <TextBlock Grid.Column="3" Margin="11,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding FilePath}" ToolTip.Tip="{Binding ToolTip}" />
        </Grid>
      </ToggleButton>
      <Border Grid.Row="0" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}" x:Name="SeparatorBorder" IsVisible="False" />
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" MinHeight="180" MaxHeight="420" x:Name="DiffContentHost" IsVisible="False" />
    </Grid>
  </Border>
</UserControl>
