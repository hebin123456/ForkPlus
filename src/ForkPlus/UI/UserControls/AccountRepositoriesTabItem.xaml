<!-- 阶段 4.5：WPF→Avalonia XAML 迁移。
     - xmlns schemas.microsoft.com → https://github.com/avaloniaui
     - 删除子元素重复 xmlns（presentation / x）
     - DataTemplate DataType="local:Foo" → DataType="local:Foo"
     -->
<TabItem xmlns:usercontrols="clr-namespace:ForkPlus.UI.UserControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.AccountRepositoriesTabItem" xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:ForkPlus.UI.UserControls" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <controls:FilterTextBox Grid.Row="0" Margin="4" x:Name="FilterTextBox" />
    <ListBox Grid.Row="1" BorderThickness="0" Margin="0,0,0,0" HorizontalAlignment="Stretch" x:Name="RepositoriesListBox">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <ContentControl>
            <ContentControl.Content>
              <Binding />
            </ContentControl.Content>
          </ContentControl>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <local:FallbackUserControl Grid.Row="0" Grid.RowSpan="2" IsVisible="False" x:Name="FallbackUserControl" />
  </Grid>
</TabItem>
