<UserControl xmlns="https://github.com/avaloniaui" xmlns:fuu="clr-namespace:ForkPlus.UI.UserControls" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.ReferenceDropdownUserControl">
  <!-- 2026-09-28 残影修复：移除显式 VSP（同 PushWindow 注释），回归主题默认 StackPanel -->
  <ComboBox Margin="0" controls:ComboBoxSearch.IsEnabled="True" x:Name="ReferenceComboBox">
    <ComboBox.ItemTemplate>
      <DataTemplate>
        <StackPanel Orientation="Horizontal">
          <StackPanel.Children>
            <Image Height="16" Width="16" Margin="0" Source="{Binding Icon}" />
            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Title}" />
          </StackPanel.Children>
        </StackPanel>
      </DataTemplate>
    </ComboBox.ItemTemplate>
  </ComboBox>
</UserControl>