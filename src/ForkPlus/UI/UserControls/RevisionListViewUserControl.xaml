<!-- Migrated from WPF to Avalonia: root xmlns updated to https://github.com/avaloniaui; redundant child xmlns declarations removed; MouseDoubleClick binding removed (handler is subscribed via RevisionListView.PointerPressed in code-behind per Avalonia migration). -->
<UserControl xmlns:usercontrols="clr-namespace:ForkPlus.UI.UserControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.RevisionListViewUserControl" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <UserControl.Resources>
    
      <Geometry x:Key="OptionMarkGeomentry">F1 M 9.97498,1.22334L 4.6983,9.09834L 4.52164,9.09834L 0,5.19331L 1.27664,3.52165L 4.255,6.08833L 8.33331,1.52588e-005L 9.97498,1.22334 Z</Geometry>
      <Style x:Key="ItemContainerStyle" Selector="controls|DragAndDropListViewItem">
<Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="AllowDrop" Value="True" />
        <!-- 阶段 4.5：原 Style.Triggers 中 DataTrigger (IsHead=True -> FontWeight=Bold) 用直接绑定实现。
             Avalonia FontWeight 是 FontWeight 枚举（不可空），需 BoolToFontWeightConverter 转换。 -->
        <Setter Property="FontWeight">
          <Setter.Value>
            <Binding Path="IsHead">
              <Binding.Converter>
                <controls:BoolToFontWeightConverter TrueWeight="Bold" />
              </Binding.Converter>
            </Binding>
          </Setter.Value>
        </Setter>
        <!-- 原 DataTrigger (IsReachable=False -> Foreground=UnreachableBrush) 用直接绑定实现。
             TrueBrush=null 时返回 UnsetValue，保持继承的默认 Foreground。 -->
        <Setter Property="TextElement.Foreground">
          <Setter.Value>
            <Binding Path="IsReachable">
              <Binding.Converter>
                <controls:BoolToBrushConverter FalseBrush="{DynamicResource RevisionList.Unreachable.ForegroundBrush}" />
              </Binding.Converter>
            </Binding>
          </Setter.Value>
        </Setter>
      </Style>
      <GridView x:Key="SingleRowGridView" ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
        <GridViewColumn>
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <Grid Height="23">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:GraphCellView ExpandToggle="GraphCellView_ExpandToggle" Grid.Column="0" CellHeight="23" Margin="4 0 0 0" />
                <Ellipse Grid.Column="1" Margin="4,0,4,0" Width="5" Height="5" HorizontalAlignment="Center">
                  <Ellipse.Fill>
                    <Binding Path="UpstreamStatus"><Binding.Converter><usercontrols:RevisionUpstreamStatusToBrushConverter /></Binding.Converter></Binding>
                  </Ellipse.Fill>
                  <Ellipse.IsVisible>
                    <Binding Path="UpstreamStatus"><Binding.Converter><usercontrols:RevisionUpstreamStatusToVisibilityConverter /></Binding.Converter></Binding>
                  </Ellipse.IsVisible>
                </Ellipse>
                <ItemsControl Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" ItemTemplate="{DynamicResource ReferencesDataTemplates}">
                  <ItemsControl.ItemsSource>
                    <Binding Path="References" />
                  </ItemsControl.ItemsSource>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- 阶段 4.5：原 MultiDataTrigger (IsSelectionActive AND IsSelected -> IsParentSelected) 简化为
                     直接绑定祖先 ListViewItem.IsSelected。IsSelectionActive 在交互场景下基本恒为 True，
                     简化后视觉/行为差异可忽略。 -->
                <controls:RevisionSubjectTextField Grid.Column="3" VerticalAlignment="Center" Margin="2 0 0 2" TextTrimming="CharacterEllipsis" x:Name="RevisionSubjectTextField">
                  <controls:RevisionSubjectTextField.IsParentSelected>
                    <Binding Path="IsSelected" RelativeSource="{RelativeSource FindAncestor, AncestorType=ListViewItem}" />
                  </controls:RevisionSubjectTextField.IsParentSelected>
                  <controls:RevisionSubjectTextField.StringValue>
                    <Binding Path="Subject" />
                  </controls:RevisionSubjectTextField.StringValue>
                  <controls:RevisionSubjectTextField.HasBody>
                    <Binding Path="HasBody" />
                  </controls:RevisionSubjectTextField.HasBody>
                  <controls:RevisionSubjectTextField.HighlightString>
                    <Binding Path="SubjectSearchString" />
                  </controls:RevisionSubjectTextField.HighlightString>
                </controls:RevisionSubjectTextField>
              </Grid>
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
        <GridViewColumn Width="19">
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <Border Margin="-6,2,-6,2" Width="18" BorderThickness="1,1,0,1" CornerRadius="3,0,0,3">
                <Border.Background>
                  <Binding Path="UserBackgroundBrush" />
                </Border.Background>
                <Border.BorderBrush>
                  <Binding Path="UserBackgroundBrush" />
                </Border.BorderBrush>
                <controls:AvatarImage Width="16" Height="16" HorizontalAlignment="Center" Margin="0,0,0,0">
                  <controls:AvatarImage.UserIdentity>
                    <Binding Path="Author" />
                  </controls:AvatarImage.UserIdentity>
                </controls:AvatarImage>
              </Border>
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
        <GridViewColumn Width="120">
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <Border Margin="-7,2,0,2" BorderThickness="1" CornerRadius="0,3,3,0">
                <Border.BorderBrush>
                  <Binding Path="UserBackgroundBrush" />
                </Border.BorderBrush>
                <controls:HighlightableTextBlock VerticalAlignment="Center" Margin="4,0,2,0" x:Name="AuthorTextBlock">
                  <controls:HighlightableTextBlock.Text>
                    <Binding Path="AuthorName" />
                  </controls:HighlightableTextBlock.Text>
                  <controls:HighlightableTextBlock.HighlightString>
                    <Binding Path="SearchString" />
                  </controls:HighlightableTextBlock.HighlightString>
                </controls:HighlightableTextBlock>
              </Border>
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
        <GridViewColumn Width="70">
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <controls:HighlightableTextBlock VerticalAlignment="Center" Margin="5,0,0,0">
                <controls:HighlightableTextBlock.Text>
                  <Binding Path="AbbreviatedSha" />
                </controls:HighlightableTextBlock.Text>
                <controls:HighlightableTextBlock.HighlightString>
                  <Binding Path="SearchString" />
                </controls:HighlightableTextBlock.HighlightString>
              </controls:HighlightableTextBlock>
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
        <GridViewColumn Width="129">
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <TextBlock VerticalAlignment="Center" Margin="0,0,-5,0">
                <TextBlock.Text>
                  <Binding Path="AuthorDateLongString" />
                </TextBlock.Text>
              </TextBlock>
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
        <GridViewColumn Width="4">
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <!-- 阶段 4.5：原 DataTrigger (IsSearchMatch=True -> Background=SearchMatch.BackgroundBrush)
                   用直接绑定 + BoolToBrushConverter 实现。FalseBrush=#00FFFFFF 与原默认值一致。 -->
              <Border Margin="-4,0,0,0" Width="4" x:Name="SearchMatchBorder">
                <Border.Background>
                  <Binding Path="IsSearchMatch">
                    <Binding.Converter>
                      <controls:BoolToBrushConverter FalseBrush="#00FFFFFF" TrueBrush="{DynamicResource RevisionList.SearchMatch.BackgroundBrush}" />
                    </Binding.Converter>
                  </Binding>
                </Border.Background>
              </Border>
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
      </GridView>
      <GridView x:Key="DoubleRowGridView" ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
        <GridViewColumn>
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <Grid Height="42">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:GraphCellView ExpandToggle="GraphCellView_ExpandToggle" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" CellHeight="42" Margin="4,0,0,0" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="3,0,0,0" Orientation="Horizontal">
                  <Border Margin="0,2,0,0" Width="18" Height="18" BorderThickness="1,1,0,1" CornerRadius="3,0,0,3">
                    <Border.Background>
                      <Binding Path="UserBackgroundBrush" />
                    </Border.Background>
                    <Border.BorderBrush>
                      <Binding Path="UserBackgroundBrush" />
                    </Border.BorderBrush>
                    <controls:AvatarImage Width="16" Height="16" HorizontalAlignment="Center" Margin="0,0,0,0">
                      <controls:AvatarImage.UserIdentity>
                        <Binding Path="Author" />
                      </controls:AvatarImage.UserIdentity>
                    </controls:AvatarImage>
                  </Border>
                  <Border Height="18" Margin="0,2,0,0" BorderThickness="1" CornerRadius="0,2,3,0">
                    <Border.BorderBrush>
                      <Binding Path="UserBackgroundBrush" />
                    </Border.BorderBrush>
                    <!-- 阶段 4.5：原 DataTrigger (IsReachable=False -> Foreground=Unreachable.ForegroundBrush)
                         用直接绑定 + BoolToBrushConverter 实现。TrueBrush=null 时返回 UnsetValue，
                         保持继承 ListViewItem.Foreground（由 ItemContainerStyle 统一控制）。 -->
                    <controls:HighlightableTextBlock VerticalAlignment="Center" Margin="4,0,2,0" x:Name="AuthorTextBlock">
                      <controls:HighlightableTextBlock.Foreground>
                        <Binding Path="IsReachable">
                          <Binding.Converter>
                            <controls:BoolToBrushConverter FalseBrush="{DynamicResource RevisionList.Unreachable.ForegroundBrush}" />
                          </Binding.Converter>
                        </Binding>
                      </controls:HighlightableTextBlock.Foreground>
                      <controls:HighlightableTextBlock.Text>
                        <Binding Path="AuthorName" />
                      </controls:HighlightableTextBlock.Text>
                      <controls:HighlightableTextBlock.HighlightString>
                        <Binding Path="SearchString" />
                      </controls:HighlightableTextBlock.HighlightString>
                    </controls:HighlightableTextBlock>
                  </Border>
                  <controls:HighlightableTextBlock Width="50" Margin="8,2,4,0" VerticalAlignment="Center" HorizontalAlignment="Right" x:Name="ShaTextBlock">
                    <controls:HighlightableTextBlock.Foreground>
                      <Binding Path="IsReachable">
                        <Binding.Converter>
                          <controls:BoolToBrushConverter TrueBrush="{DynamicResource SecondaryLabelBrush}" FalseBrush="{DynamicResource RevisionList.Unreachable.ForegroundBrush}" />
                        </Binding.Converter>
                      </Binding>
                    </controls:HighlightableTextBlock.Foreground>
                    <controls:HighlightableTextBlock.Text>
                      <Binding Path="AbbreviatedSha" />
                    </controls:HighlightableTextBlock.Text>
                    <controls:HighlightableTextBlock.HighlightString>
                      <Binding Path="SearchString" />
                    </controls:HighlightableTextBlock.HighlightString>
                  </controls:HighlightableTextBlock>
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,2,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="AuthorDateTextBlock">
                  <TextBlock.Foreground>
                    <Binding Path="IsReachable">
                      <Binding.Converter>
                        <controls:BoolToBrushConverter TrueBrush="{DynamicResource SecondaryLabelBrush}" FalseBrush="{DynamicResource RevisionList.Unreachable.ForegroundBrush}" />
                      </Binding.Converter>
                    </Binding>
                  </TextBlock.Foreground>
                  <TextBlock.Text>
                    <Binding Path="AuthorDateShortString" />
                  </TextBlock.Text>
                </TextBlock>
                <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                  <Ellipse DockPanel.Dock="Left" Margin="4,0,0,0" Width="5" Height="5" HorizontalAlignment="Center">
                    <Ellipse.Fill>
                      <Binding Path="UpstreamStatus"><Binding.Converter><usercontrols:RevisionUpstreamStatusToBrushConverter /></Binding.Converter></Binding>
                    </Ellipse.Fill>
                    <Ellipse.IsVisible>
                      <Binding Path="UpstreamStatus"><Binding.Converter><usercontrols:RevisionUpstreamStatusToVisibilityConverter /></Binding.Converter></Binding>
                    </Ellipse.IsVisible>
                  </Ellipse>
                  <ItemsControl DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Top" ItemTemplate="{DynamicResource ReferencesDataTemplates}">
                    <ItemsControl.ItemsSource>
                      <Binding Path="References" />
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <!-- 阶段 4.5：原 MultiDataTrigger (IsSelectionActive AND IsSelected -> IsParentSelected) 简化为
                       直接绑定祖先 ListViewItem.IsSelected（与 SingleRowGridView 一致）。 -->
                  <controls:RevisionSubjectTextField DockPanel.Dock="Left" Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" FontSize="13.5" x:Name="RevisionSubjectTextField">
                    <controls:RevisionSubjectTextField.IsParentSelected>
                      <Binding Path="IsSelected" RelativeSource="{RelativeSource FindAncestor, AncestorType=ListViewItem}" />
                    </controls:RevisionSubjectTextField.IsParentSelected>
                    <controls:RevisionSubjectTextField.StringValue>
                      <Binding Path="Subject" />
                    </controls:RevisionSubjectTextField.StringValue>
                    <controls:RevisionSubjectTextField.HighlightString>
                      <Binding Path="SubjectSearchString" />
                    </controls:RevisionSubjectTextField.HighlightString>
                    <ToolTip.Tip>
                      <Binding Path="Subject" />
                    </ToolTip.Tip>
                    <controls:RevisionSubjectTextField.HasBody>
                      <Binding Path="HasBody" />
                    </controls:RevisionSubjectTextField.HasBody>
                  </controls:RevisionSubjectTextField>
                </DockPanel>
                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" BorderThickness="0,0,0,1" Margin="0,0,-8,0" BorderBrush="{DynamicResource BorderBrush}" />
                <!-- 阶段 4.5：原 DataTrigger (IsSearchMatch=True -> Background=SearchMatch.BackgroundBrush) 用
                     BoolToBrushConverter 直接绑定实现。FalseBrush=#00FFFFFF 与原默认值一致。 -->
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,-8,0" Width="4" HorizontalAlignment="Right" x:Name="SearchMatchBorder">
                  <Border.Background>
                    <Binding Path="IsSearchMatch">
                      <Binding.Converter>
                        <controls:BoolToBrushConverter FalseBrush="#00FFFFFF" TrueBrush="{DynamicResource RevisionList.SearchMatch.BackgroundBrush}" />
                      </Binding.Converter>
                    </Binding>
                  </Border.Background>
                </Border>
              </Grid>
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
      </GridView>
    
  </UserControl.Resources>
  <Grid ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" x:Name="SearchPanelPlaceholder" />
    <controls:DragAndDropListView SizeChanged="RevisionListView_SizeChanged" SelectionChanged="RevisionListView_SelectionChanged" Grid.Row="1" BorderThickness="0" SelectionMode="Multiple,Toggle" Margin="0,0,0,0" x:Name="RevisionListView">
      <controls:DragAndDropListView.ContextMenu>
        <ContextMenu />
      </controls:DragAndDropListView.ContextMenu>
    </controls:DragAndDropListView>
    <usercontrols:RevisionSearchPanelUserControl Grid.RowSpan="2" x:Name="RevisionSearchPanelUserControl">
      <usercontrols:RevisionSearchPanelUserControl.SearchPanelPlaceholder>
        <Binding ElementName="SearchPanelPlaceholder" />
      </usercontrols:RevisionSearchPanelUserControl.SearchPanelPlaceholder>
    </usercontrols:RevisionSearchPanelUserControl>
  </Grid>
</UserControl>
