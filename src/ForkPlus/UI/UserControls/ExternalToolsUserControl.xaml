<!-- 阶段 4.5：WPF→Avalonia XAML 迁移。
     - xmlns schemas.microsoft.com → https://github.com/avaloniaui
     - 删除子元素重复 xmlns（presentation / x）
     - 移除 WPF 特有 RenderOptions.ClearTypeHint
     - DataTemplate.Triggers (MultiDataTrigger 绑定祖先 ListBoxItem.IsSelected) → 顶层
       <UserControl.Styles><Style Selector="ListBoxItem:selected TextBlock#PrimaryTextBlock">
     - TextBlock.Visibility (经 BooleanToVisibilityConverter) → TextBlock.IsVisible (直接绑定 bool)
     - FallbackUserControl.IsVisible="False" → IsVisible="False"
     - 移除未再使用的 BooleanToVisibilityConverter 资源（InverseBooleanToVisibility 返回 bool，
       名字虽含 "ToVisibility" 但已迁移为 Avalonia IValueConverter 返回 bool）
     -->
<UserControl xmlns:uc="clr-namespace:ForkPlus.UI.UserControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.ExternalToolsUserControl" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <UserControl.Resources>
    
      <controls:InverseBooleanConverter x:Key="InverseBooleanConverter" />
      <controls:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
    
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- 阶段 4.5：替代原 DataTemplate.Triggers 中的 MultiDataTrigger。
         原触发器：当祖先 ListBoxItem.IsSelected=true 时设置 ItemTemplate 内 PrimaryTextBlock.Foreground=ForegroundBrush.Light。
         Avalonia 顶层 Style Selector 直接匹配 selected ListBoxItem 内名为 PrimaryTextBlock 的 TextBlock。 -->
    <Style Selector="ListBoxItem:selected TextBlock#PrimaryTextBlock">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="85" />
        <RowDefinition Height="17" />
      </Grid.RowDefinitions>
      <ListBox VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource BorderBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ToolsListBox_SelectionChanged" x:Name="ToolsListBox">
        <ListBox.ContextMenu>
          <ContextMenu />
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="uc:ExternalToolViewModel">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" FontSize="10" Margin="2,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="PrimaryTextBlock">
                <TextBlock.Text>
                  <Binding Path="PrimaryLabel" />
                </TextBlock.Text>
                <TextBlock.IsVisible>
                  <Binding Path="IsPrimary" />
                </TextBlock.IsVisible>
              </TextBlock>
              <Image DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center" Margin="0">
                <Image.Source>
                  <Binding Path="Icon" />
                </Image.Source>
              </Image>
              <TextBlock FontSize="13" Margin="6,1,2,1" TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                  <Binding Path="Name" />
                </TextBlock.Text>
              </TextBlock>
            </DockPanel>
            <!-- 阶段 4.5：原 WPF DataTemplate.Triggers 中的 MultiDataTrigger 绑定祖先 ListBoxItem.IsSelected=true
                 以设置 PrimaryTextBlock.Foreground=ForegroundBrush.Light。Avalonia DataTemplate 不支持 Triggers，
                 已迁移为 UserControl.Styles 中的顶层 Style Selector="ListBoxItem:selected TextBlock#PrimaryTextBlock"。 -->
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BackgroundBrush}" BorderThickness="1,0,1,1">
        <StackPanel Orientation="Horizontal">
          <Button Height="18" Width="18" Margin="-1,-1,0,-1" Click="AddToolButton_Click">
            <Image Source="{DynamicResource AddIcon}" Width="16" Height="16" VerticalAlignment="Center" />
          </Button>
          <Button Margin="0,-1,0,-1" Height="18" Width="18" Click="RemoveToolButton_Click" x:CompileBindings="False">
            <Button.IsEnabled>
              <Binding ElementName="ToolsListBox" Path="SelectedItem.IsPredefined" Converter="{StaticResource InverseBooleanConverter}" />
            </Button.IsEnabled>
            <Image Source="{DynamicResource RemoveIcon}" Width="16" Height="16" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Column="1" Grid.ColumnSpan="2" CornerRadius="4" Margin="10,0,0,0" Height="102" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource GroupBoxBackgroundBrush}">
      <Grid Margin="8,8,8,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="68" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="24" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0" Text="Name:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <controls:PlaceholderTextBox Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" Width="195" HorizontalAlignment="Left" Padding="4,2,4,2" Placeholder="External tool name" x:CompileBindings="False">
          <controls:PlaceholderTextBox.Text>
            <Binding ElementName="ToolsListBox" Path="SelectedItem.Name" UpdateSourceTrigger="PropertyChanged" />
          </controls:PlaceholderTextBox.Text>
          <controls:PlaceholderTextBox.IsVisible>
            <Binding ElementName="ToolsListBox" Path="SelectedItem.IsPredefined" Converter="{StaticResource InverseBooleanToVisibility}" />
          </controls:PlaceholderTextBox.IsVisible>
        </controls:PlaceholderTextBox>
        <TextBlock Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" Padding="7,2,4,2" Width="195" HorizontalAlignment="Left" VerticalAlignment="Center" x:CompileBindings="False">
          <TextBlock.Text>
            <Binding ElementName="ToolsListBox" Path="SelectedItem.Name" />
          </TextBlock.Text>
          <TextBlock.IsVisible>
            <Binding ElementName="ToolsListBox" Path="SelectedItem.IsPredefined" />
          </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Path:" FontSize="13" Margin="0,6,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <controls:PlaceholderTextBox Grid.Row="1" Grid.Column="1" Margin="10,6,0,0" Padding="4,2,4,2" IsReadOnly="True" Placeholder="External tool location" x:Name="ToolPathTextBox" x:CompileBindings="False">
          <controls:PlaceholderTextBox.Text>
            <Binding ElementName="ToolsListBox" Path="SelectedItem.Path" UpdateSourceTrigger="PropertyChanged" />
          </controls:PlaceholderTextBox.Text>
        </controls:PlaceholderTextBox>
        <Button Grid.Row="1" Grid.Column="2" Margin="2,6,0,0" Click="BrowseButton_Click" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Arguments:" FontSize="13" Margin="0,6,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <Grid Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Margin="10,6,0,0">
          <controls:PlaceholderTextBox Padding="4,2,14,2" Placeholder="External tool arguments" x:CompileBindings="False">
            <controls:PlaceholderTextBox.Text>
              <Binding ElementName="ToolsListBox" Path="SelectedItem.Arguments" UpdateSourceTrigger="PropertyChanged" />
            </controls:PlaceholderTextBox.Text>
          </controls:PlaceholderTextBox>
          <TextBlock x:Name="ArgumentsHintTextBlock" />
        </Grid>
      </Grid>
    </Border>
    <uc:FallbackUserControl Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,0" Height="102" IsVisible="False" x:Name="ToolsFallback" />
  </Grid>
</UserControl>
