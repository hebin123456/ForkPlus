<!-- 已从 WPF 迁移到 Avalonia：xmlns 替换为 https://github.com/avaloniaui；删除 ResourceDictionary / Style / 子控件上的重复 xmlns 与 xmlns:x 声明。
     - Style TargetType="ComboBoxItem" → Selector="ComboBoxItem"
     - Style.Triggers DataTrigger 绑定 ItemType（用于渲染 Separator 分隔项）已在阶段 4.5 收尾迁移：
       ItemTemplate 内用堆叠控件 + EnumEqualsConverter 切换可见性（见下方 ComboBox.ItemTemplate）。
       MainBranchComboBoxItemStyle 保留空壳以兼容 ItemContainerStyle 引用。 -->
<UserControl xmlns:RepositorySettings="clr-namespace:ForkPlus.UI.UserControls.RepositorySettings" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.RepositorySettings.GeneralUserControl" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <UserControl.Resources>
    
      <Style x:Key="MainBranchComboBoxItemStyle" Selector="ComboBoxItem" />
    
  </UserControl.Resources>
  <Grid Width="450">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Text="User Information" />
    <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,10" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Use global git credentials" Checked="UseGlobalGitCredentialsCheckBox_Changed" Unchecked="UseGlobalGitCredentialsCheckBox_Changed" x:Name="UseGlobalGitCredentialsCheckBox" />
    <controls:AvatarImage Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Margin="60,0,10,0" Width="42" Height="42" HorizontalAlignment="Left" x:Name="AuthorAvatarImage" />
    <controls:PlaceholderTextBox TextChanged="UserNameTextBox_TextChanged" Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" Padding="4,2,4,2" Placeholder="User name" x:Name="UserNameTextBox" />
    <controls:PlaceholderTextBox TextChanged="EmailTextBox_TextChanged" Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" Padding="4,2,4,2" Placeholder="Email" x:Name="EmailTextBox" />
    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
      <Span>
        <Run>Change the avatar at</Run> <Hyperlink NavigateUri="https://gravatar.com"><TextBlock HorizontalAlignment="Center" Text="gravatar.com" /></Hyperlink></Span>
    </TextBlock>
    <Separator Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0" />
    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Text="Lean Branching" />
    <TextBlock Grid.Column="0" Grid.Row="7" Text="Main Branch:" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
    <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,4,0,4" SelectionChanged="MainBranchComboBox_SelectionChanged" x:Name="MainBranchComboBox">
      <ComboBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ComboBox.ItemsPanel>
      <ComboBox.ItemTemplate>
        <DataTemplate DataType="RepositorySettings:GeneralUserControl+LocalBranchItem">
          <!-- 阶段 4.5：原 MainBranchComboBoxItemStyle 的 Style.Triggers DataTrigger (ItemType=Separator ->
               渲染 Separator 分隔线) 用堆叠控件 + EnumEqualsConverter 切换可见性实现。
               ItemType != Separator 时显示 Branch 行（图标+标题）；== Separator 时显示 Separator。 -->
          <Grid>
            <StackPanel Orientation="Horizontal" IsVisible="{Binding ItemType, Converter={controls:EnumNotEqualsConverter}, ConverterParameter={x:Static RepositorySettings:GeneralUserControl+LocalBranchItemType.Separator}}">
              <Image Source="{DynamicResource BranchIcon}" Height="16" Width="16" Margin="0,0,4,0" />
              <TextBlock VerticalAlignment="Center" FontSize="13">
                <TextBlock.Text>
                  <Binding Path="Title" />
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
            <Separator IsVisible="{Binding ItemType, Converter={controls:EnumEqualsConverter}, ConverterParameter={x:Static RepositorySettings:GeneralUserControl+LocalBranchItemType.Separator}}" Height="1" />
          </Grid>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <CheckBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="No fast-forward on merge" Checked="NoFastForwardCheckBox_Changed" Unchecked="NoFastForwardCheckBox_Changed" x:Name="NoFastForwardCheckBox" />
    <Separator Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0" />
    <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Text="Diff View" />
    <TextBlock Grid.Column="0" Grid.Row="11" Text="Tab Width:" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
    <TextBox Grid.Row="11" Grid.Column="1" Width="30" Margin="0,4,0,4" Padding="4,2,4,2" TextAlignment="Left" HorizontalAlignment="Left" TextChanged="TabWidthTextBox_TextChanged" x:Name="TabWidthTextBox" />
  </Grid>
</UserControl>
