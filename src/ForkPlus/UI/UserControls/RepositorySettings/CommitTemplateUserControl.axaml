<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:fuur="clr-namespace:ForkPlus.UI.UserControls.RepositorySettings" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.RepositorySettings.CommitTemplateUserControl" xmlns:fuc="clr-namespace:ForkPlus.UI.Controls">
  <Grid Width="400">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.Children>
      <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Text="Commit Template">
<!-- Migration note：WPF TextBlock.Style 块注释化（TextBlock 非 TemplatedControl，Avalonia 无 Style 属性）。原始片段：
        <TextBlock.Style>
          <DynamicResource ResourceKey="SettingsHeaderTextBlockStyle" />
        </TextBlock.Style>
-->
      </TextBlock>
      <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsCheckedChanged="UseGlobalCommitTemplateCheckbox_Changed" x:Name="UseGlobalCommitTemplateCheckBox">Use global git configuration file</CheckBox>
      <fuc:AutoTooltipTextBlock Grid.Row="2" Grid.Column="1" Margin="4,0,0,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" x:Name="CommitTemplatePathTextBlock">
        <TextBlock.Foreground>
          <DynamicResource ResourceKey="SecondaryLabelBrush" />
        </TextBlock.Foreground>
      </fuc:AutoTooltipTextBlock>
      <fuc:PlaceholderTextBox TextChanged="CommitTemplateTextBox_TextChanged" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4" HorizontalAlignment="Stretch" Height="120" VerticalAlignment="Stretch" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" x:Name="CommitTemplateTextBox" />
      <Separator Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,20,0,8" />
      <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsCheckedChanged="AddSignedOffMessageCheckBox_Changed" x:Name="AddSignedOffMessageCheckBox">Add Signed-off-by line at the end of the commit message</CheckBox>
      <Separator Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,8" />
      <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsCheckedChanged="SkipCommitMessageCheckBox_Changed" x:Name="SkipCommitMessageCheckBox">Do not require commit message</CheckBox>
      <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="Commit message regex:" x:Name="CommitMessageRegexLabel" />
      <TextBox Text="" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0" HorizontalAlignment="Stretch" Height="64" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="CommitMessageRegexTextBox_TextChanged" x:Name="CommitMessageRegexTextBox" />
    </Grid.Children>
  </Grid>
</UserControl>