<UserControl xmlns:local="clr-namespace:ForkPlus.UI.UserControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.SidebarUserControl" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <UserControl.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="SidebarFilterButton" TargetType="Button" BasedOn="{StaticResource BranchOptionButton}" />
      <ControlTheme x:Key="SidebarHideButton" TargetType="Button" BasedOn="{StaticResource BranchOptionButton}" />
      <ControlTheme x:Key="SidebarPinButton" TargetType="Button" BasedOn="{StaticResource BranchOptionButton}" />
      <ControlTheme x:Key="SidebarTruncateHyperlink" TargetType="HyperlinkButton" BasedOn="{StaticResource GrayUnderlineHyperlinkStyle}" />
      <ControlTheme x:Key="SidebarTagTitleTextBlock" TargetType="TextBlock" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Sidebar.Static.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <DockPanel Height="22" Margin="20,2,2,2">
        <controls:DropDownButton DockPanel.Dock="Right" Margin="0" Padding="0" Height="16" Width="16" BorderThickness="0" Background="#00FFFFFF" ToolTip.Tip="Repository Settings" x:Name="RepositorySettingsDropdownButton">
          <controls:DropDownButton.ContextMenu>
            <ContextMenu MaxWidth="500" Opened="RepositorySettingsDropdownButtonContextMenu_Opened" />
          </controls:DropDownButton.ContextMenu>
          <Image Source="{DynamicResource SettingsIcon}" />
        </controls:DropDownButton>
        <TextBlock DockPanel.Dock="Left" Margin="0" FontWeight="Medium" VerticalAlignment="Center" FontSize="13.5">
          <HyperlinkButton NavigateUri=" " Theme="{DynamicResource RepositoryTitleHyperlinkStyle}">
            <TextBlock HorizontalAlignment="Center" Margin="0" x:Name="RepositoryParentNameTextBlock" />
          </HyperlinkButton>
        </TextBlock>
        <controls:EditableTextBlock Margin="0" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource ForegroundBrush}" x:Name="RepositoryNameTextBlock" />
      </DockPanel>
      <RadioButton Click="Changes_Selected" x:Name="ChangesRadioButton" Theme="{DynamicResource SidebarButton}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" Source="{DynamicResource ChangesIcon}" Height="16" Width="16" />
          <TextBlock Grid.Column="1" Text="Changes" Margin="6,0,0,0" FontSize="13" TextTrimming="CharacterEllipsis" x:Name="ChangesTextBlock" />
        </Grid>
      </RadioButton>
      <RadioButton IsChecked="True" HorizontalAlignment="Stretch" Click="AllCommits_Selected" x:Name="AllCommitsRadioButton" Theme="{DynamicResource SidebarButton}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" Source="{DynamicResource RevisionListIcon}" Height="16" Width="16" />
          <TextBlock Grid.Column="1" Text="All Commits" Margin="6,0,0,0" FontSize="13" TextTrimming="CharacterEllipsis" x:Name="AllCommitsTextBlock" />
        </Grid>
      </RadioButton>
      <Border Margin="0,5,0,0" HorizontalAlignment="Stretch" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource BorderBrush}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <RadioButton ToolTip.Tip="Branches" Content="{DynamicResource SidebarBranchGeometry}" x:Name="BranchesRadioButton" Theme="{DynamicResource SidebarPathImageRadioButtonStyle}">
            <RadioButton.IsChecked>
              <Binding ElementName="BranchesTabItem" Path="IsSelected" Mode="TwoWay" />
            </RadioButton.IsChecked>
          </RadioButton>
          <RadioButton ToolTip.Tip="Search Commits" Content="{DynamicResource SidebarSearchGeometry}" x:Name="SearchRadioButton" Theme="{DynamicResource SidebarPathImageRadioButtonStyle}">
            <RadioButton.IsChecked>
              <Binding ElementName="SearchTabItem" Path="IsSelected" Mode="TwoWay" />
            </RadioButton.IsChecked>
          </RadioButton>
          <RadioButton ToolTip.Tip="Pull Requests" Content="{DynamicResource GenericRemoteGeometry}" x:Name="ServiceRadioButton" Theme="{DynamicResource SidebarPathImageRadioButtonStyle}" IsVisible="False">
            <RadioButton.IsChecked>
              <Binding ElementName="ServiceTabItem" Path="IsSelected" Mode="TwoWay" />
            </RadioButton.IsChecked>
          </RadioButton>
        </StackPanel>
      </Border>
    </StackPanel>
    <TabControl Grid.Row="1" Background="{DynamicResource Sidebar.Static.Background}" Padding="0" SelectionChanged="TabControl_SelectionChanged">
      <TabItem x:Name="BranchesTabItem">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Margin="8,2,0,2" FontSize="15" FontWeight="Medium" Text="Branches" IsVisible="False" />
          <controls:FilterTextBox Grid.Row="1" Margin="4" UseSecondaryTextBoxBackground="True" x:Name="FilterTextBox" />
          <Grid Grid.Row="2">
            <controls:MultiselectionTreeView Grid.Row="1" SelectionMode="Toggle" x:Name="SidebarTreeView" Theme="{DynamicResource SideBarMultiselectionTreeViewStyle}">
              <controls:MultiselectionTreeView.ItemTemplate>
                <DataTemplate>
                  <ContentControl HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <ContentControl.Content>
                      <Binding />
                    </ContentControl.Content>
                  </ContentControl>
                </DataTemplate>
              </controls:MultiselectionTreeView.ItemTemplate>
              <controls:MultiselectionTreeView.ContextMenu>
                <ContextMenu />
              </controls:MultiselectionTreeView.ContextMenu>
            </controls:MultiselectionTreeView>
          </Grid>
        </Grid>
      </TabItem>
      <local:SearchTabItem x:Name="SearchTabItem" />
      <local:ServiceTabItem x:Name="ServiceTabItem" />
    </TabControl>
  </Grid>
</UserControl>