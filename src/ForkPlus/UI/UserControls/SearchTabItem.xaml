<!-- 阶段 4.5：WPF→Avalonia XAML 迁移。
     - xmlns schemas.microsoft.com → https://github.com/avaloniaui
     - 删除子元素重复 xmlns（presentation / x）
     - DataTemplate DataType="local:Foo" → DataType="local:Foo"
     - DataTemplate.Triggers/DataTrigger 已迁移为顶层 Style Selector（:selected 伪类）
     -->
<TabItem Margin="10" Padding="0" xmlns:local="clr-namespace:ForkPlus.UI.UserControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.SearchTabItem" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <TabItem.Styles>
    <!-- 阶段 4.5：替代原 DataTemplate.Triggers 中的 DataTrigger。
         原触发器：当祖先 TreeViewItem.IsSelected=True 时设置 ItemTemplate 内
         RevisionSubjectTextBlock/AuthorDateTextBlock/FilePathTextBlock.Foreground=ForegroundBrush.Light。
         TreeViewItem 继承自 ListBoxItem，:selected 伪类等价于 WPF IsSelected=True。
         RevisionSubjectTextField 继承自 TextField（非 TextBlock），故用 Control# 选择器。 -->
    <Style Selector="controls|TreeViewControlItem:selected Control#RevisionSubjectTextBlock">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
    <Style Selector="controls|TreeViewControlItem:selected TextBlock#AuthorDateTextBlock">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
    <Style Selector="controls|TreeViewControlItem:selected TextBlock#FilePathTextBlock">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
  </TabItem.Styles>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
      </Grid.RowDefinitions>
      <TextBlock Margin="10,2,0,2" FontSize="15" FontWeight="Medium" Text="Search Commits" Foreground="{DynamicResource ForegroundBrush}" />
      <Grid Grid.Row="1" Margin="4,4,4,0">
        <controls:FilterTextBox UseSecondaryTextBoxBackground="True" ShowDropdown="True" x:Name="FilterTextBox" />
        <ProgressBar Margin="0,0,20,1" IsVisible="False" Width="12" Height="12" HorizontalAlignment="Right" Foreground="{DynamicResource ForegroundBrush.Gray}" x:Name="BusyIndicator" />
      </Grid>
      <DockPanel Grid.Row="2" Margin="6,3,6,3">
        <controls:DropDownButton DockPanel.Dock="Left" Height="20" Padding="4,0,4,0" VerticalAlignment="Center" BorderBrush="#00FFFFFF" Background="#00FFFFFF" x:Name="SearchDropdownButton">
          <controls:DropDownButton.ContextMenu>
            <ContextMenu MaxWidth="500" Opened="SearchDropdownButtonContextMenu_Opened" />
          </controls:DropDownButton.ContextMenu>
        </controls:DropDownButton>
        <TextBlock DockPanel.Dock="Right" Margin="0,0,0,2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="FoundCommitsTextBlock" />
      </DockPanel>
    </Grid>
    <controls:MultiselectionTreeView Grid.Row="1" SelectionMode="Multiple,Toggle" Margin="0" x:Name="TreeView">
      <controls:MultiselectionTreeView.ItemTemplate>
        <DataTemplate>
          <ContentControl>
            <ContentControl.Content>
              <Binding />
            </ContentControl.Content>
          </ContentControl>
        </DataTemplate>
      </controls:MultiselectionTreeView.ItemTemplate>
    </controls:MultiselectionTreeView>
  </Grid>
</TabItem>
