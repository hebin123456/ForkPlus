<ui:CustomWindow Loaded="ForkWindow_Loaded" Closing="Window_Closing" Activated="Window_Activated" Height="600" Width="1000" MinWidth="650" MinHeight="400" xmlns="https://github.com/avaloniaui" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.MainWindow" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:userControls="clr-namespace:ForkPlus.UI.UserControls" Theme="{DynamicResource MainWindowStyle}">
  <ui:CustomWindow.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="MainWindowStyle" TargetType="ui:CustomWindow" BasedOn="{StaticResource {x:Type ui:CustomWindow}}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ui:CustomWindow">
              <Border BorderThickness="{TemplateBinding ui:CustomWindow.WindowResizeBorderThickness}">
                <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                  <!-- 窗口菜单"放大/缩小"（Zoom In/Out，Ctrl+= / Ctrl+-）：
                       WPF 原版在此 Grid 上 LayoutTransform="{DynamicResource LayoutScaleTransform}"；
                       Avalonia 无元素级 LayoutTransform，用 LayoutTransformControl 包裹实现等效布局缩放。
                       命令链路：Increase/DecreaseLayoutScaleCommand → ForkPlusSettings.LayoutScaling
                       → ApplicationExtensions.RefreshLayoutScaling() 替换 App 资源里的
                       ScaleTransform → DynamicResource 联动到此处。 -->
                  <LayoutTransformControl LayoutTransform="{DynamicResource LayoutScaleTransform}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource Window.TitleBar.Background}" BorderThickness="0" Padding="0" x:Name="PART_WindowHeader">
                      <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                          <ToggleButton ToolTip.Tip="Notifications" x:Name="Part_NotificationManagerToggleButton" Theme="{DynamicResource WindowRoundedToggleButton}">
<!-- Migration note：WPF ToggleButton.FocusVisualStyle 块已删（Avalonia 无 FocusVisualStyle） -->

                            <Image Source="{DynamicResource NotificationIcon}" Height="16" Width="16" VerticalAlignment="Center" />
                          </ToggleButton>
                          <Popup HorizontalOffset="-340" VerticalOffset="3" PlacementTarget="{Binding ElementName=Part_NotificationManagerToggleButton}" IsOpen="{Binding IsChecked, ElementName=Part_NotificationManagerToggleButton}" x:Name="NotificationManagerPopup">
                            <userControls:NotificationManagerUserControl x:Name="NotificationManagerUserControl" />
                          </Popup>
                          <Button x:Name="PART_MinimizeButton" Theme="{DynamicResource WindowButton}">
                            <Path Data="{StaticResource MinimizeGeometry}" Theme="{DynamicResource WindowPathStyle}" />
                          </Button>
                          <Button x:Name="PART_RestoreButton" Theme="{DynamicResource WindowButton}">
                            <Path Data="{StaticResource RestoreGeometry}" Theme="{DynamicResource WindowPathStyle}" />
                          </Button>
                          <Button x:Name="PART_MaximizeButton" Theme="{DynamicResource WindowButton}">
                            <Path Data="{StaticResource MaximizeGeometry}" Theme="{DynamicResource WindowPathStyle}" />
                          </Button>
                          <Button x:Name="PART_CloseButton" Theme="{DynamicResource WindowCloseButton}">
                            <Path Data="{StaticResource CloseGeometry}" Theme="{DynamicResource WindowCloseButtonPathStyle}" />
                          </Button>
                        </StackPanel>
                        <Border>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Menu Grid.Column="0" HorizontalAlignment="Left" Background="{DynamicResource Window.TitleBar.Background}" x:Name="PART_MainMenu" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,90,0">
                              <Image Source="{TemplateBinding Icon}" />
                              <ContentControl Content="{TemplateBinding Title}" Foreground="{TemplateBinding Foreground}">
                                <Label.IsVisible>
                                  <Binding Path="IsTitleVisible" RelativeSource="{RelativeSource TemplatedParent}" />
                                </Label.IsVisible>
                              </ContentControl>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DockPanel>
                    </Border>
                    <!-- Bug 修复（2026-09-04，同 CustomWindow/DialogWindow 模板）：补 VisualLayerManager
                         且命名 PART_VisualLayerManager——TopLevel.OnApplyTemplate 经该名取回它，
                         Window.OnApplyTemplate 的 EnableVisualLayerManagerLayers 会启用 internal 的
                         EnablePopupOverlayLayer，模板内 NotificationManagerPopup 及窗口内所有 Popup
                         （颜色选择器等）才能在无平台 IPopupImpl 的环境下经 OverlayLayer 回退打开。 -->
                    <VisualLayerManager x:Name="PART_VisualLayerManager" Grid.Row="1">
                      <ContentPresenter Content="{TemplateBinding Content}" ClipToBounds="True"  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </VisualLayerManager>
    <!-- Migration note：WPF ResizeGrip 已删（Avalonia 窗口缩放由系统边框处理；自绘 chrome 需 CustomWindow 自己实现） -->
                  </Grid>
                  </LayoutTransformControl>
                </Border>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </ui:CustomWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <userControls:ToolbarUserControl Grid.Row="0" x:Name="Toolbar" />
    <controls:ClosableTabControl Grid.Row="1" x:Name="TabControl">
<!-- Migration note：WPF controls:ClosableTabControl.FocusVisualStyle 块已删（Avalonia 无 FocusVisualStyle） -->

    </controls:ClosableTabControl>
  </Grid>
</ui:CustomWindow>