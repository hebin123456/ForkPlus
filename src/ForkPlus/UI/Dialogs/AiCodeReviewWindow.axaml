<fud:AiResultWindowBase Height="720" Width="1080" MinHeight="400" MinWidth="560" xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:fud="clr-namespace:ForkPlus.UI.Dialogs" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:userControls="clr-namespace:ForkPlus.UI.UserControls" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.AiCodeReviewWindow" xmlns:fuu="clr-namespace:ForkPlus.UI.UserControls" CanResize="True">
  <Grid x:Name="AiResultGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="365" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition MinWidth="120" Width="350" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.Children>
      <!-- 标题栏：标题 + 模型下拉 + Stop + Retry -->
      <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0,10,6" LastChildFill="True">
        <Button DockPanel.Dock="Right" MinWidth="64" Padding="10,2,10,2" Content="Retry" ToolTip.Tip="Retry AI Review" Click="RetryButton_Click" x:Name="RetryButton" />
        <Button DockPanel.Dock="Right" MinWidth="64" Padding="10,2,10,2" Margin="6,0,0,0" Content="Stop" ToolTip.Tip="Stop the current AI task and abort its request" Click="StopButton_Click" x:Name="StopButton" IsVisible="False" />
        <ComboBox DockPanel.Dock="Right" x:Name="ModelComboBox" FontSize="11" MinWidth="160" MaxWidth="320" Margin="6,0,6,0" SelectionChanged="ModelComboBox_SelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" x:Name="TitleTextBlock" />
      </DockPanel>
      <Separator HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0" VerticalAlignment="Bottom" />
      <!-- 状态栏：进度条 + 状态文字（排队/请求中/收集 diff/生成中/完成） -->
      <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,4,10,6" LastChildFill="True">
        <ProgressBar DockPanel.Dock="Left" Width="120" Height="3" IsIndeterminate="True" Foreground="{DynamicResource AccentColorBrush}" x:Name="StatusProgressBar" IsVisible="False" />
        <TextBlock FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="StatusTextBlock" />
      </DockPanel>
      <fuu:RevisionDetailsUserControl Grid.Row="2" Grid.Column="0" x:Name="RevisionDetails" />
      <Grid Grid.Row="2" Grid.Column="0" x:Name="FileReviewGrid" IsVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" MinWidth="160" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>
        <fuu:FileListUserControl Grid.Column="0" EnableMultiSelection="True" x:Name="FileReviewFileListUserControl">
          <fuu:FileListUserControl.ContextMenu>
            <ContextMenu />
          </fuu:FileListUserControl.ContextMenu>
        </fuu:FileListUserControl>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" x:Name="FileReviewGridSplitter" Theme="{DynamicResource VerticalGridSplitter}" />
        <controls:CommitFileDiffControl Grid.Column="2" x:Name="FileReviewDiffControl" />
      </Grid>
      <controls:AiStreamingWebView Grid.Row="2" Grid.Column="2" x:Name="AiStreamingView" />
      <GridSplitter Grid.Row="2" Grid.Column="1" x:Name="GridSplitter">
        <GridSplitter.Theme>
          <DynamicResource ResourceKey="VerticalGridSplitter" />
        </GridSplitter.Theme>
      </GridSplitter>
    </Grid.Children>
  </Grid>
</fud:AiResultWindowBase>
