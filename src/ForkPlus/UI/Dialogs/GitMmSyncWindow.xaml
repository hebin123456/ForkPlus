<dialogs:ForkPlusDialogWindow Width="560" SizeToContent="Height" xmlns="https://github.com/avaloniaui" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.GitMmSyncWindow">
  <Grid>
    <Grid.Resources>
      <Style x:Key="GitMmAdvancedOptionsExpanderStyle" TargetType="Expander">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <DockPanel>
                <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}" Padding="6,3" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BackgroundBrush}" HorizontalAlignment="Left">
                  <ToggleButton.Template>
                    <ControlTemplate>
                      <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="0">
                        <DockPanel Margin="{TemplateBinding Padding}">
                          <!-- 阶段 4.5：原WPF ControlTemplate.Triggers 根据 IsChecked 切换 ArrowText ">" / "v"，
                               用两个堆叠 TextBlock + IsVisible 绑定 IsChecked 替代。 -->
                          <Grid Width="12">
                            <TextBlock Text=">" VerticalAlignment="Center" IsVisible="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBlock Text="v" VerticalAlignment="Center" IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                          </Grid>
                          <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <!-- 阶段 4.5：原WPF ControlTemplate.Triggers 根据 IsExpanded 切换 Visibility，已改用 IsVisible Binding 替代 -->
                <ContentPresenter DockPanel.Dock="Bottom" IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ContentSource="Content" x:Name="ExpandSite" />
              </DockPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="0" Grid.Row="0" Text="Workspace:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="1" Grid.Row="0" Margin="8,4,0,4" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="WorkspacePathTextBlock" />
      <TextBlock Grid.Column="0" Grid.Row="1" Text="Checkout jobs:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="8,4,0,4">
      <ComboBox Width="70" HorizontalAlignment="Left" x:Name="CheckoutJobsComboBox">
        <ComboBoxItem Content="1" />
        <ComboBoxItem Content="2" />
        <ComboBoxItem Content="3" />
        <ComboBoxItem Content="4" />
        <ComboBoxItem Content="5" />
        <ComboBoxItem Content="6" />
        <ComboBoxItem Content="7" />
        <ComboBoxItem Content="8" />
        <ComboBoxItem Content="9" />
        <ComboBoxItem Content="10" />
      </ComboBox>
        <TextBlock Text="Fetch jobs:" Margin="16,0,6,0" FontSize="13" VerticalAlignment="Center" />
        <ComboBox Width="70" HorizontalAlignment="Left" x:Name="FetchJobsComboBox">
          <ComboBoxItem Content="1" />
          <ComboBoxItem Content="2" />
          <ComboBoxItem Content="3" />
          <ComboBoxItem Content="4" />
          <ComboBoxItem Content="5" />
          <ComboBoxItem Content="6" />
          <ComboBoxItem Content="7" />
          <ComboBoxItem Content="8" />
          <ComboBoxItem Content="9" />
          <ComboBoxItem Content="10" />
        </ComboBox>
      </StackPanel>
      <Expander Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Header="Advanced Options" IsExpanded="False">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Grid.Column="0" Grid.Row="0" Margin="0,4,0,0" Height="14" Width="14" VerticalAlignment="Center" HorizontalAlignment="Right" Source="avares://ForkPlus/Assets/Warning.png" x:Name="ForceSyncWarningImage" />
          <CheckBox Grid.Column="1" Grid.Row="0" Margin="8,4,0,0" HorizontalAlignment="Left" Content="_Force sync" ToolTip.Tip="--force-sync" x:Name="ForceSyncCheckBox" />
          <CheckBox Grid.Column="1" Grid.Row="1" Margin="8,4,0,0" HorizontalAlignment="Left" Content="Detach local branches" ToolTip.Tip="-d" x:Name="DetachCheckBox" />
          <CheckBox Grid.Column="1" Grid.Row="2" Margin="8,4,0,0" HorizontalAlignment="Left" Content="Update manifest" ToolTip.Tip="--update-manifest" x:Name="UpdateManifestCheckBox" />
          <Grid Grid.Column="1" Grid.Row="3" Margin="8,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="135" />
              <ColumnDefinition Width="135" />
              <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Content="Local only" ToolTip.Tip="-l" x:Name="LocalOnlyCheckBox" />
            <CheckBox Grid.Column="1" Content="Network only" ToolTip.Tip="-n" x:Name="NetworkOnlyCheckBox" />
            <CheckBox Grid.Column="2" Content="Fail fast" ToolTip.Tip="--fail-fast" x:Name="FailFastCheckBox" />
          </Grid>
          <Grid Grid.Column="1" Grid.Row="4" Margin="8,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="135" />
              <ColumnDefinition Width="135" />
              <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Content="All branches" ToolTip.Tip="-a" x:Name="AllBranchesCheckBox" />
            <CheckBox Grid.Column="1" Content="Fetch tags" ToolTip.Tip="--tags" x:Name="TagsCheckBox" />
            <CheckBox Grid.Column="2" Content="Fetch submodules" ToolTip.Tip="--fetch-submodules" x:Name="FetchSubmodulesCheckBox" />
          </Grid>
          <Grid Grid.Column="1" Grid.Row="5" Margin="8,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="135" />
              <ColumnDefinition Width="135" />
              <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Content="Force checkout" ToolTip.Tip="--force-checkout" x:Name="ForceCheckoutCheckBox" />
            <CheckBox Grid.Column="1" Content="Force fetch" ToolTip.Tip="--force-fetch" x:Name="ForceFetchCheckBox" />
            <CheckBox Grid.Column="2" Content="Remove dirty projects" ToolTip.Tip="--force-remove-dirty" x:Name="ForceRemoveDirtyCheckBox" />
          </Grid>
        </Grid>
      </Expander>
      <TextBlock Grid.Column="0" Grid.Row="8" Text="Command Preview:" FontSize="13" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,0,0" />
      <ScrollViewer Grid.Column="1" Grid.Row="8" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,8,0,0">
        <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="CommandPreviewTextBlock" />
      </ScrollViewer>
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
