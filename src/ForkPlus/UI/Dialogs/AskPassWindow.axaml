<dialogs:ForkPlusDialogWindow MinHeight="170" Width="520" SizeToContent="Height" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.AskPassWindow" xmlns="https://github.com/avaloniaui">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Password:" x:Name="InputTextBlock" />
      <TextBox Text="" Grid.Row="0" Grid.Column="1" Margin="8,4,0,4" Padding="4,2,4,2" x:Name="InputTextBox" />
      <TextBox Text="" Grid.Row="0" Grid.Column="1" Margin="8,4,0,4" Padding="4,2,4,2" PasswordChar="●" x:Name="InputPasswordBox" />
      <CheckBox Grid.Column="1" Grid.Row="1" Margin="8,6,0,0" HorizontalAlignment="Left" Content="Remember in Credential Manager" ToolTip.Tip="Remember in Windows Credential Manager" x:Name="RememberCheckBox" />
      <!-- 第二档"记住密码"：下次弹窗仍出现，但密码框自动预填（弹窗内自动填充） -->
      <CheckBox Grid.Column="1" Grid.Row="2" Margin="8,6,0,0" HorizontalAlignment="Left" Content="Remember password" ToolTip.Tip="Pre-fills the password next time this host asks" x:Name="RememberPasswordCheckBox" />
      <!-- 第三档"记住密码 + 不再弹出"：凭据静默回填、完全不弹窗；偏好设置 &gt; Credentials 可用开关重新打开 -->
      <CheckBox Grid.Column="1" Grid.Row="3" Margin="8,6,0,0" HorizontalAlignment="Left" Content="Remember password and never ask again" ToolTip.Tip="Use the remembered password silently without this dialog (re-enable prompting in Preferences &gt; Credentials)" x:Name="NeverAskCheckBox" />
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
