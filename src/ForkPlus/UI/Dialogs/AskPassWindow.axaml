<dialogs:ForkPlusDialogWindow MinHeight="170" Width="520" SizeToContent="Height" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.AskPassWindow" xmlns="https://github.com/avaloniaui">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Password:" x:Name="InputTextBlock" />
      <TextBox Text="" Grid.Row="0" Grid.Column="1" Margin="8,4,0,4" Padding="4,2,4,2" x:Name="InputTextBox" />
      <TextBox Text="" Grid.Row="0" Grid.Column="1" Margin="8,4,0,4" Padding="4,2,4,2" PasswordChar="●" x:Name="InputPasswordBox" />
      <CheckBox Grid.Column="1" Grid.Row="1" Margin="8,6,0,0" HorizontalAlignment="Left" Content="Remember in Credential Manager" ToolTip.Tip="Remember in Windows Credential Manager" x:Name="RememberCheckBox" />
      <!-- 第二档"记住密码"（2026-09-14 起与第三档等效）：密码静默复用、不再弹窗；
           偏好设置 &gt; Credentials 关掉开关可忘掉密码、恢复询问 -->
      <CheckBox Grid.Column="1" Grid.Row="2" Margin="8,6,0,0" HorizontalAlignment="Left" Content="Remember password" ToolTip.Tip="Use the remembered password silently without this dialog (re-enable prompting in Preferences &gt; Credentials)" x:Name="RememberPasswordCheckBox" />
      <!-- 第三档控件保留但不再展示：静默语义已并入第二档；NeverAskAgain 标记仅作
           "密码被 erase 后快速失败"开关，偏好页 ToggleSwitch 仍可读写 -->
      <CheckBox Grid.Column="1" Grid.Row="3" Margin="8,6,0,0" HorizontalAlignment="Left" Content="Remember password and never ask again" ToolTip.Tip="Use the remembered password silently without this dialog (re-enable prompting in Preferences &gt; Credentials)" x:Name="NeverAskCheckBox" IsVisible="False" />
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
