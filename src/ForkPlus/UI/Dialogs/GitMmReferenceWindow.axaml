<dialogs:ForkPlusDialogWindow Height="680" Width="860" MinHeight="420" MinWidth="560" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:userControls="clr-namespace:ForkPlus.UI.UserControls" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.GitMmReferenceWindow" xmlns="https://github.com/avaloniaui" CanResize="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,4">
      <wv2:WebView2 x:Name="ManualWebView" />
      <userControls:FallbackUserControl x:Name="ManualFallback" IsVisible="False">
        <UserControl.Background>
          <SolidColorBrush>#00FFFFFF</SolidColorBrush>
        </UserControl.Background>
      </userControls:FallbackUserControl>
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
