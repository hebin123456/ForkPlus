<ui:CustomWindow xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.FileHistoryWindow" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:userControls="clr-namespace:ForkPlus.UI.UserControls" xmlns="https://github.com/avaloniaui">
  <!-- Migration note：原 WPF x:Key="{DataTemplateKey {x:Type T}}" 按类型隐式查找，
       Avalonia 12 无此机制（ContentPresenter 只走逻辑树 Control.DataTemplates，不查资源字典），
       搬到根元素 DataTemplates 集合恢复按 DataType 匹配 -->
  <ui:CustomWindow.DataTemplates>
<DataTemplate DataType="dialogs:HistoryEntryViewModel">
        <Grid Height="57">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="18" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Row="0" Grid.Column="0" Width="14" Height="14" Margin="4,0,4,0" VerticalAlignment="Center">
            <controls:AvatarImage>
              <controls:AvatarImage.UserIdentity>
                <Binding Path="Author" />
              </controls:AvatarImage.UserIdentity>
            </controls:AvatarImage>
          </Grid>
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="4,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12">
            <TextBlock.Text>
              <Binding Path="AuthorName" />
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Grid.Row="0" Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="AuthorDateTextBlock">
            <TextBlock.Text>
              <Binding Path="AuthorDate" />
            </TextBlock.Text>
            <ToolTip.Tip>
              <TextBlock>
                <TextBlock.Text>
                  <Binding Path="AuthorDate" />
                </TextBlock.Text>
              </TextBlock>
            </ToolTip.Tip>
          </TextBlock>
          <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="ShaTextBlock">
            <TextBlock.Text>
              <Binding Path="AbbreviatedSha" />
            </TextBlock.Text>
          </TextBlock>
          <Button Grid.Column="4" Width="14" Height="14" Padding="1" Margin="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" BorderThickness="0" Background="#00FFFFFF" Click="OpenRevisionInSeparateWindowButton_Click" Theme="{DynamicResource IconButtonStyle}">
            <ToolTip.Tip>
              <Binding Path="OpenInSeparateWindowButtonToolTip" />
            </ToolTip.Tip>
            <Image Source="{DynamicResource OpenInSeparateWindowIcon}" Height="12" Width="12" />
          </Button>
          <controls:AutoTooltipTextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="4,0,2,0" FontSize="13" VerticalAlignment="Center" x:Name="RevisionSubjectTextBlock">
            <controls:AutoTooltipTextBlock.Text>
              <Binding Path="RevisionSubject" />
            </controls:AutoTooltipTextBlock.Text>
            <ToolTip.Tip>
              <Binding Path="RevisionSubject" />
            </ToolTip.Tip>
          </controls:AutoTooltipTextBlock>
          <Image Grid.Row="2" Grid.Column="0" Height="14" Width="14" Margin="4,0,4,0" VerticalAlignment="Center">
            <Image.Source>
              <Binding Path="StatusImage" />
            </Image.Source>
          </Image>
          <controls:AutoTooltipTextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="4,0,2,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="PathTextBlock">
            <controls:AutoTooltipTextBlock.Text>
              <Binding Path="Path" />
            </controls:AutoTooltipTextBlock.Text>
          </controls:AutoTooltipTextBlock>
        </Grid>
        
      
    <!--
      WPF migration note: DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="True" xmlns="https://github.com/avaloniaui">
                  <DataTrigger.Binding>
                    <Binding Path="IsSelected">
                      <Binding.RelativeSource>
                        <RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" />
                      </Binding.RelativeSource>
                    </Binding>
                  </DataTrigger.Binding>
                  <Setter TargetName="PathTextBlock" Value="{DynamicResource ForegroundBrush.Light}" Property="Foreground" />
                  <Setter TargetName="RevisionSubjectTextBlock" Value="{DynamicResource ForegroundBrush.Light}" Property="Foreground" />
                  <Setter TargetName="AuthorDateTextBlock" Value="{DynamicResource ForegroundBrush.Light}" Property="Foreground" />
                  <Setter TargetName="ShaTextBlock" Value="{DynamicResource ForegroundBrush.Light}" Property="Foreground" />
                </DataTrigger>
    --></DataTemplate>
<DataTemplate DataType="dialogs:FolderHistoryEntryViewModel">
        <Grid Height="18">
          <ToolTip.Tip>
            <StackPanel Orientation="Horizontal">
              <TextBlock>
                <TextBlock.Text>
                  <Binding Path="AbbreviatedSha" />
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Text="" Margin="4,0,4,0" />
              <TextBlock>
                <TextBlock.Text>
                  <Binding Path="RevisionSubject" />
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </ToolTip.Tip>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="18" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Width="14" Height="14" Margin="4,0,4,0">
            <controls:AvatarImage x:Name="AuthorAvatarImage">
              <controls:AvatarImage.UserIdentity>
                <Binding Path="Author" />
              </controls:AvatarImage.UserIdentity>
            </controls:AvatarImage>
          </Grid>
          <TextBlock Grid.Column="1" Margin="4,0,2,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" x:Name="RevisionSubjectTextBlock">
            <TextBlock.Text>
              <Binding Path="RevisionSubject" />
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Grid.Column="2" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryLabelBrush}" FontSize="12" x:Name="AuthorDateTextBlock">
            <TextBlock.Text>
              <Binding Path="AuthorDate" />
            </TextBlock.Text>
            <ToolTip.Tip>
              <TextBlock>
                <TextBlock.Text>
                  <Binding Path="AuthorDate" />
                </TextBlock.Text>
              </TextBlock>
            </ToolTip.Tip>
          </TextBlock>
          <Button Grid.Column="4" Width="14" Height="14" Padding="1" Margin="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" BorderThickness="0" Background="#00FFFFFF" Click="OpenRevisionInSeparateWindowButton_Click" Theme="{DynamicResource IconButtonStyle}">
            <ToolTip.Tip>
              <Binding Path="OpenInSeparateWindowButtonToolTip" />
            </ToolTip.Tip>
            <Image Source="{DynamicResource OpenInSeparateWindowIcon}" Height="12" Width="12" />
          </Button>
        </Grid>
      </DataTemplate>
<DataTemplate DataType="dialogs:SubItemFileHistoryEntryViewModel">
        <Grid Height="18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" VerticalAlignment="Center" Margin="10,0,2,0" Width="12" Height="12">
            <Image.Source>
              <Binding Path="StatusImage" />
            </Image.Source>
          </Image>
          <Image Grid.Column="1" VerticalAlignment="Center" Margin="2" Width="12" Height="12">
            <Image.Source>
              <Binding Path="FileTypeIcon" />
            </Image.Source>
          </Image>
          <controls:AutoTooltipTextBlock Grid.Column="2" FontSize="12" x:Name="PathTextBlock">
            <controls:AutoTooltipTextBlock.Text>
              <Binding Path="Path" />
            </controls:AutoTooltipTextBlock.Text>
          </controls:AutoTooltipTextBlock>
        </Grid>
        
      
    <!--
      WPF migration note: DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="True" xmlns="https://github.com/avaloniaui">
                  <DataTrigger.Binding>
                    <Binding Path="IsSelected">
                      <Binding.RelativeSource>
                        <RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" />
                      </Binding.RelativeSource>
                    </Binding>
                  </DataTrigger.Binding>
                  <Setter TargetName="PathTextBlock" Value="{DynamicResource ForegroundBrush.Light}" Property="Foreground" />
                </DataTrigger>
    --></DataTemplate>
  </ui:CustomWindow.DataTemplates>
  <Grid Margin="20,0,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel>
      <TextBlock DockPanel.Dock="Left" Text="History" Margin="4,0,0,2" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" x:Name="HistoryTitleTextBlock" />
      <Image DockPanel.Dock="Left" Width="14" Height="14" Margin="8,0,4,0" x:Name="FileIcon" />
      <controls:GitPointView DockPanel.Dock="Right" x:Name="TargetReferenceGitPointView" />
      <ProgressBar DockPanel.Dock="Right" Margin="0,0,5,0" Width="14" Height="14" Foreground="{DynamicResource ForegroundBrush.Gray}" x:Name="BusyIndicator" Theme="{DynamicResource CircularProgressBar}" IsVisible="True" />
      <controls:FilePathTextBlock FontSize="14" VerticalAlignment="Center" x:Name="FileNameTextBlock" />
    </DockPanel>
    <Border Grid.Row="1" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource BorderBrush}" Height="17" VerticalAlignment="Top" />
    <controls:RevisionTimeLine Grid.Row="1" Height="46" Margin="1,1,1,0" x:Name="RevisionTimeLine" />
    <Grid Grid.Row="2" Background="{DynamicResource BackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="150" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:MultiselectionTreeView SelectionChanged="TreeView_SelectionChanged" Grid.Column="0" Margin="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="TreeView" DoubleTapped="TreeView_MouseDoubleClick" Theme="{DynamicResource FileHistoryMultiselectionTreeViewStyle}">
        <controls:MultiselectionTreeView.ContextMenu>
          <ContextMenu />
        </controls:MultiselectionTreeView.ContextMenu>
      </controls:MultiselectionTreeView>
      <Border Grid.Column="2" BorderThickness="0,1,1,1" BorderBrush="{DynamicResource BorderBrush}">
        <controls:FileDiffControl Target="History" x:Name="FileDiffControl" />
      </Border>
      <GridSplitter Grid.Column="1" Theme="{DynamicResource VerticalGridSplitter}" />
      <userControls:FallbackUserControl BorderThickness="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="CodeEditorFallbackUserControl" />
    </Grid>
  </Grid>
</ui:CustomWindow>