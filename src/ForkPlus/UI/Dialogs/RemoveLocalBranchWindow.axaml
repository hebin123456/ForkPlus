<dialogs:ForkPlusDialogWindow Width="570" MinWidth="500" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.RemoveLocalBranchWindow" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns="https://github.com/avaloniaui">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,2,0,2" FontSize="13" VerticalAlignment="Top" HorizontalAlignment="Right" x:Name="StartPointTextBlock" />
      <controls:GitPointView Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" x:Name="GitPointView" />
      <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" BorderThickness="1" BorderBrush="{DynamicResource TextBox.Static.Border}" x:Name="BranchesContainer">
        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ItemsControl Background="{DynamicResource TextBox.Static.Background}" x:Name="BranchesItemsControl">
<!-- Migration note：WPF ItemsControl.FocusVisualStyle 块已删（Avalonia 无 FocusVisualStyle） -->

            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Grid MinHeight="20">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{DynamicResource BranchIcon}" Height="16" Width="16" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13">
                      <TextBlock.Text>
                        <Binding Path="BranchName" />
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0">
                      <TextBlock.Text>
                        <Binding Path="SafetyText" />
                      </TextBlock.Text>
                      <TextBlock.Foreground>
                        <Binding Path="SafetyBrush" />
                      </TextBlock.Foreground>
                      <TextBlock.IsVisible>
                        <Binding Path="SafetyText"><Binding.Converter><controls:NullToVisibilityConverter /></Binding.Converter></Binding>
                      </TextBlock.IsVisible>
                    </TextBlock>
                    <DockPanel Grid.Column="3" VerticalAlignment="Center">
                      <DockPanel.IsVisible>
                        <Binding Path="UpstreamVisibility" />
                      </DockPanel.IsVisible>
                      <TextBlock Text="→" Margin="4,0,0,0">
                        <TextBlock.IsVisible>
                          <Binding Path="UpstreamName"><Binding.Converter><controls:NullToVisibilityConverter /></Binding.Converter></Binding>
                        </TextBlock.IsVisible>
                      </TextBlock>
                      <Image Height="16" Width="16" Margin="4,0,0,0">
                        <Image.Source>
                          <Binding Path="RemoteIcon" />
                        </Image.Source>
                      </Image>
                      <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="13">
                        <TextBlock.Text>
                          <Binding Path="UpstreamName" />
                        </TextBlock.Text>
                      </TextBlock>
                    </DockPanel>
                  </Grid>
                  <Expander IsExpanded="False" Margin="20,0,0,0">
                    <Expander.IsVisible>
                      <Binding Path="HasUniqueCommits" />
                    </Expander.IsVisible>
                    <Expander.Header>
                      <Binding Path="UniqueCommitsHeaderText" />
                    </Expander.Header>
                    <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Margin="0,2,0,2">
                      <TextBlock.Text>
                        <Binding Path="UniqueCommitsText" />
                      </TextBlock.Text>
                    </TextBlock>
                  </Expander>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,4,0,0" FontSize="12" VerticalAlignment="Center" x:Name="BranchSafetyStatusTextBlock" IsVisible="False" />
      <Expander Grid.Row="2" Grid.Column="1" Margin="8,4,0,0" IsExpanded="False" x:Name="BranchSafetyExpander" IsVisible="False">
        <Expander.Header>
          <TextBlock x:Name="BranchSafetyExpanderHeaderTextBlock" FontSize="12" />
        </Expander.Header>
        <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Margin="0,2,0,2" x:Name="BranchSafetyUniqueCommitsTextBlock" />
      </Expander>
      <Image Grid.Row="3" Grid.Column="0" Height="14" Width="14" Margin="0,6,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Source="avares://ForkPlus/Assets/Warning.png" x:Name="WarningImage" IsVisible="False" />
      <DockPanel Grid.Row="3" Grid.Column="1" Margin="8,6,0,0" VerticalAlignment="Center">
        <CheckBox DockPanel.Dock="Left" Margin="0" IsCheckedChanged="DeleteRemoteBranchCheckBox_Changed" x:Name="DeleteRemoteBranchCheckBox">
<!-- Migration note：WPF CheckBox.FocusVisualStyle 块已删（Avalonia 无 FocusVisualStyle） -->

        </CheckBox>
        <Image Height="16" Width="16" Margin="6,0,0,0" x:Name="DeleteRemoteBranchCheckBoxUpstreamIcon" />
        <controls:AutoTooltipTextBlock Margin="2,0,0,2" FontSize="13" x:Name="DeleteRemoteBranchCheckBoxUpstream" />
      </DockPanel>
      <Image Grid.Row="4" Grid.Column="0" Height="14" Width="14" Margin="0,6,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Source="avares://ForkPlus/Assets/Warning.png" x:Name="WorktreeWarningImage" IsVisible="False" />
      <DockPanel Grid.Row="4" Grid.Column="1" Margin="8,6,0,0" VerticalAlignment="Center" x:Name="DeleteWorktreeContainer" IsVisible="False">
        <CheckBox DockPanel.Dock="Left" Margin="0" Content="Also delete worktree" IsCheckedChanged="DeleteWorktreeCheckBox_Changed" x:Name="DeleteWorktreeCheckBox">
<!-- Migration note：WPF CheckBox.FocusVisualStyle 块已删（Avalonia 无 FocusVisualStyle） -->

        </CheckBox>
        <Image Source="{DynamicResource WorktreeIcon}" Height="16" Width="16" Margin="6,0,0,0" />
        <controls:AutoTooltipTextBlock Margin="2,0,0,2" FontSize="13" x:Name="DeleteWorktreeLabel" />
      </DockPanel>
      <TextBlock Grid.Row="5" Grid.Column="1" Margin="8,8,0,0" FontSize="12" TextWrapping="Wrap" x:Name="UndoHintTextBlock" Foreground="{DynamicResource SecondaryLabelBrush}" IsVisible="False" />
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
