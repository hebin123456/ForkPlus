<dialogs:ForkPlusDialogWindow CanResize="True" xmlns="https://github.com/avaloniaui" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.InteractiveRebaseWindow" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:userControls="clr-namespace:ForkPlus.UI.UserControls">
  <dialogs:ForkPlusDialogWindow.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <DataTemplate x:Key="NoneDataTemplate" DataType="dialogs:GraphItemType" />
      <DataTemplate x:Key="StartDataTemplate" DataType="dialogs:GraphItemType">
        <Canvas Height="22" Width="22">
          <Line Stroke="{DynamicResource ForegroundBrush.Gray}" StrokeThickness="1.4"  StartPoint="11,11" EndPoint="11,22" />
          <Ellipse Fill="{DynamicResource ForegroundBrush.Gray}" Height="6" Width="6" Canvas.Top="8" Canvas.Left="8" />
        </Canvas>
      </DataTemplate>
      <DataTemplate x:Key="MiddleDataTemplate" DataType="dialogs:GraphItemType">
        <Canvas Height="22" Width="22">
          <Line Stroke="{DynamicResource ForegroundBrush.Gray}" StrokeThickness="1.4"  StartPoint="11,0" EndPoint="11,22" />
          <Ellipse Fill="{DynamicResource ForegroundBrush.Gray}" Height="6" Width="6" Canvas.Top="8" Canvas.Left="8" />
        </Canvas>
      </DataTemplate>
      <DataTemplate x:Key="ThroughDataTemplate" DataType="dialogs:GraphItemType">
        <Canvas Height="22" Width="22">
          <Line Stroke="{DynamicResource ForegroundBrush.Gray}" StrokeThickness="1.4"  StartPoint="11,0" EndPoint="11,22" />
        </Canvas>
      </DataTemplate>
      <DataTemplate x:Key="TargetDataTemplate" DataType="dialogs:GraphItemType">
        <Canvas Height="22" Width="22">
          <Grid Canvas.Top="0" Canvas.Left="11" Height="14" Width="18">
            <Path Stretch="Fill" StrokeThickness="0" Margin="-1,0,0,0" Fill="{DynamicResource ForegroundBrush.Gray}" Data="M8.38,11.598C3.523,9.982,-0.0640000000000001,5.335,0.00100000000000122,0.159000000000001L0.00100000000000122,6.93889390390723E-16C0.487000000000001,0.00100000000000069 0.974000000000001,0.00300000000000069 1.46,0.00400000000000069 1.447,4.469 4.236,8.469 8.38,10.051L8.38,7.566 18.034,10.784 8.38,14.002 8.38,11.598z" />
          </Grid>
        </Canvas>
      </DataTemplate>
      <!-- 阶段 4.5：替代原 DataTemplate.Triggers 中 ActionsComboBox 的 MultiDataTrigger
           (IsMouseOver AND IsSelected -> Foreground=ForegroundBrush)。简化为祖先 ListBoxItem
           选中+悬停时触发（:selected:pointerover 等价 WPF IsSelected AND IsMouseOver）。 -->
      
    </ResourceDictionary>
  </dialogs:ForkPlusDialogWindow.Resources>
  <dialogs:ForkPlusDialogWindow.Styles>
    <Style Selector="ListBoxItem:selected:pointerover ComboBox#ActionsComboBox">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush}" />
      </Style>
  </dialogs:ForkPlusDialogWindow.Styles>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="40" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Interactive Rebase" Margin="4,0,0,6" FontSize="18" FontWeight="Medium" />
      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,4,4" Text="Rebase:" />
        <controls:GitPointView Grid.Column="1" Margin="8,0,8,4" x:Name="SourceGitPointView" />
        <TextBlock Grid.Column="2" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,4,4" Text="On:" />
        <controls:GitPointView Grid.Column="3" Margin="8,0,0,4" x:Name="DestinationGitPointView" />
        <CheckBox Grid.Column="4" Margin="30,0,4,4" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Content="Update dependent branches" ToolTip.Tip="--update-refs" x:Name="UpdateRefsCheckBox" />
      </Grid>
      <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource BackgroundBrush}">
        <dialogs:MultiselectionListView SizeChanged="RevisionListView_SizeChanged" SelectionChanged="RevisionListView_SelectionChanged" BorderThickness="0" SelectionMode="Multiple,Toggle" x:Name="RevisionListView">
          <dialogs:MultiselectionListView.View>
            <GridView ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
              <GridViewColumn Width="100">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox Width="85" VerticalAlignment="Center" Margin="0" Focusable="False" BorderThickness="0" Background="#00FFFFFF" DropDownClosed="ActionsComboBox_DropDownClosed" SelectionChanged="ComboBox_SelectionChanged" x:Name="ActionsComboBox">
                      <ComboBox.Foreground>
                        <Binding Path="Foreground"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ListViewItem}" /></Binding.RelativeSource></Binding>
                      </ComboBox.Foreground>
                      <ComboBox.SelectedItem>
                        <Binding Path="Action"><Binding.Converter><dialogs:InteractiveRebaseActionToInteractiveRebaseComboBoxItemConverter /></Binding.Converter></Binding>
                      </ComboBox.SelectedItem>
                      <ComboBox.ItemsSource>
                        <Binding Path="DataContext.InteractiveRebaseComboBoxItemsSource"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ListView}" /></Binding.RelativeSource></Binding>
                      </ComboBox.ItemsSource>
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Width="450">
                            <Ellipse DockPanel.Dock="Left" Height="12" Width="12" Margin="0,0,4,0">
                              <Ellipse.Fill>
                                <Binding Path="Action"><Binding.Converter><dialogs:InteractiveRebaseActionToColorConverter /></Binding.Converter></Binding>
                              </Ellipse.Fill>
                              <Ellipse.IsVisible>
                                <Binding Path="Action"><Binding.Converter><dialogs:InteractiveRebaseActionToVisibilityConverter /></Binding.Converter></Binding>
                              </Ellipse.IsVisible>
                            </Ellipse>
                            <TextBlock DockPanel.Dock="Left" Width="70" Margin="0,0,0,2" FontSize="13">
                              <TextBlock.Text>
                                <Binding Path="DisplayTitle" />
                              </TextBlock.Text>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Width="40" Margin="0,0,0,2" HorizontalAlignment="Right">
                              <TextBlock.Text>
                                <Binding Path="Shortcut" />
                              </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Margin="4,0,4,2" HorizontalAlignment="Stretch" FontSize="13">
                              <TextBlock.Text>
                                <Binding Path="DisplayDescription" />
                              </TextBlock.Text>
                            </TextBlock>
                          </DockPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="40">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <!-- 阶段 4.5：原 ContentControl.Style 的 Style.Triggers (GraphType 枚举 -> ContentTemplate)
                         用 5 个堆叠 ContentControl + EnumEqualsConverter 切换 IsVisible 实现。
                         每个 ContentControl 绑定对应的 DataTemplate，仅当 GraphType 匹配时可见。 -->
                    <Grid Margin="4 0 0 0" Width="22">
                      <ContentControl ContentTemplate="{StaticResource NoneDataTemplate}" IsVisible="{Binding GraphType, Converter={controls:EnumEqualsConverter}, ConverterParameter={x:Static dialogs:GraphItemType.None}}">
                        <ContentControl.Content><Binding /></ContentControl.Content>
                      </ContentControl>
                      <ContentControl ContentTemplate="{StaticResource StartDataTemplate}" IsVisible="{Binding GraphType, Converter={controls:EnumEqualsConverter}, ConverterParameter={x:Static dialogs:GraphItemType.Start}}">
                        <ContentControl.Content><Binding /></ContentControl.Content>
                      </ContentControl>
                      <ContentControl ContentTemplate="{StaticResource MiddleDataTemplate}" IsVisible="{Binding GraphType, Converter={controls:EnumEqualsConverter}, ConverterParameter={x:Static dialogs:GraphItemType.Middle}}">
                        <ContentControl.Content><Binding /></ContentControl.Content>
                      </ContentControl>
                      <ContentControl ContentTemplate="{StaticResource ThroughDataTemplate}" IsVisible="{Binding GraphType, Converter={controls:EnumEqualsConverter}, ConverterParameter={x:Static dialogs:GraphItemType.Through}}">
                        <ContentControl.Content><Binding /></ContentControl.Content>
                      </ContentControl>
                      <ContentControl ContentTemplate="{StaticResource TargetDataTemplate}" IsVisible="{Binding GraphType, Converter={controls:EnumEqualsConverter}, ConverterParameter={x:Static dialogs:GraphItemType.Target}}">
                        <ContentControl.Content><Binding /></ContentControl.Content>
                      </ContentControl>
                    </Grid>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn>
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <controls:ReferencePanel DockPanel.Dock="Left">
                        <controls:ReferencePanel.ItemsSource>
                          <Binding Path="RefViewModels" />
                        </controls:ReferencePanel.ItemsSource>
                        
                      </controls:ReferencePanel>
                      <TextBlock VerticalAlignment="Center" Margin="2 0 0 2" x:Name="SubjectTextBlock">
                        <TextBlock.Text>
                          <Binding Path="Subject" />
                        </TextBlock.Text>
                        <TextBlock.Foreground>
                          <Binding Path="Action"><Binding.Converter><dialogs:InteractiveRebaseActionToForegroundConverter /></Binding.Converter></Binding>
                        </TextBlock.Foreground>
                        <!-- 阶段 4.5：原 DataTrigger (Action=Drop -> TextDecorations=Strikethrough) 用 EnumToTextDecorationsConverter
                             绑定实现。IsSelected -> Foreground=ForegroundBrush.Light 简化忽略（Foreground 已绑定 Action）。 -->
                        <TextBlock.TextDecorations>
                          <Binding Path="Action"><Binding.Converter><controls:EnumToTextDecorationsConverter ConverterParameter="Drop" /></Binding.Converter></Binding>
                        </TextBlock.TextDecorations>
                      </TextBlock>
                    </DockPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="19">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <controls:AvatarImage Width="16" Height="16" HorizontalAlignment="Center" Margin="-6,2,-6,2">
                      <controls:AvatarImage.UserIdentity>
                        <Binding Path="Author" />
                      </controls:AvatarImage.UserIdentity>
                    </controls:AvatarImage>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="120">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock VerticalAlignment="Center" Margin="-2,0,0,2" x:Name="AuthorTextBlock">
                      <TextBlock.Text>
                        <Binding Path="AuthorName" />
                      </TextBlock.Text>
                      <TextBlock.Foreground>
                        <Binding Path="Action"><Binding.Converter><dialogs:InteractiveRebaseActionToForegroundConverter /></Binding.Converter></Binding>
                      </TextBlock.Foreground>
                      <TextBlock.TextDecorations>
                        <Binding Path="Action"><Binding.Converter><controls:EnumToTextDecorationsConverter ConverterParameter="Drop" /></Binding.Converter></Binding>
                      </TextBlock.TextDecorations>
                    </TextBlock>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="70">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,2" x:Name="AbbreviatedShaTextBlock">
                      <TextBlock.Text>
                        <Binding Path="AbbreviatedSha" />
                      </TextBlock.Text>
                      <TextBlock.Foreground>
                        <Binding Path="Action"><Binding.Converter><dialogs:InteractiveRebaseActionToForegroundConverter /></Binding.Converter></Binding>
                      </TextBlock.Foreground>
                      <TextBlock.TextDecorations>
                        <Binding Path="Action"><Binding.Converter><controls:EnumToTextDecorationsConverter ConverterParameter="Drop" /></Binding.Converter></Binding>
                      </TextBlock.TextDecorations>
                    </TextBlock>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="120">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock VerticalAlignment="Center" Margin="0,0,-5,2" x:Name="AuthorDateTextBlock">
                      <TextBlock.Text>
                        <Binding Path="AuthorDate" />
                      </TextBlock.Text>
                      <TextBlock.Foreground>
                        <Binding Path="Action"><Binding.Converter><dialogs:InteractiveRebaseActionToForegroundConverter /></Binding.Converter></Binding>
                      </TextBlock.Foreground>
                      <TextBlock.TextDecorations>
                        <Binding Path="Action"><Binding.Converter><controls:EnumToTextDecorationsConverter ConverterParameter="Drop" /></Binding.Converter></Binding>
                      </TextBlock.TextDecorations>
                    </TextBlock>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </dialogs:MultiselectionListView.View>
        </dialogs:MultiselectionListView>
      </Grid>
      <userControls:RevisionDetailsUserControl Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" BorderThickness="0" Background="{DynamicResource BackgroundBrush}" x:Name="RevisionDetails" />
      <GridSplitter Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" />
      <GridSplitter Grid.Row="3" Grid.Column="1" Height="32" Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />
      <GridSplitter Grid.Row="3" Grid.Column="2" VerticalAlignment="Top" />
      <userControls:FallbackUserControl Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="RevisionListFallbackUserControl" />
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
