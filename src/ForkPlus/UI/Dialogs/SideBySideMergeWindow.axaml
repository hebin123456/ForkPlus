<local:ForkPlusDialogWindow Title="Merge" Height="720" MinWidth="980" Width="1020" xmlns:local="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.SideBySideMergeWindow" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:mergeControls="clr-namespace:ForkPlus.UI.Controls.Editor.Merge" xmlns="https://github.com/avaloniaui" CanResize="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,-4,0,2">
      <TextBlock Text="Merge" DockPanel.Dock="Left" Margin="2,0,0,2" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" />
      <Image DockPanel.Dock="Left" Width="14" Height="14" Margin="8,0,4,0" x:Name="FileIcon" />
      <controls:FilePathTextBlock FontSize="14" VerticalAlignment="Center" x:Name="FilePathTextBlock" />
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <CheckBox Margin="0,0,0,0" Width="320" HorizontalAlignment="Left" IsCheckedChanged="AllRemoteCheckBox_Changed" x:Name="AllRemoteCheckBox" Theme="{StaticResource MergerSelectAllCheckBox}">
          <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="18" />
              <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <controls:GitPointView IconMargin="2,0,6,0" x:Name="RemoteGitPointView" TextElement.FontSize="14" TextElement.FontWeight="Medium" TextElement.Foreground="{DynamicResource LabelBrush}" />
            <DockPanel Grid.Row="1">
              <controls:AvatarImage DockPanel.Dock="Left" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" x:Name="RemoteAuthorAvatarImage" />
              <TextBlock DockPanel.Dock="Right" Margin="8,1,0,0" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="RemoteAuthorDateTextBlock" />
              <TextBlock Margin="6,0,0,0" FontSize="13" TextTrimming="CharacterEllipsis" x:Name="RemoteSubjectTextBlock" />
            </DockPanel>
            <TextBlock Grid.Row="1" Margin="6,0,0,0" FontSize="13" Text="Applied changes" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="StashTextBlock" IsVisible="False" />
          </Grid>
        </CheckBox>
      </DockPanel>
      <TextBlock Grid.Column="1" Margin="4,0,4,2" FontSize="14" Text="Resolved" VerticalAlignment="Bottom" HorizontalAlignment="Center" x:Name="ResolvedTextBlock" />
      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Right" x:Name="NextPrevMergeButtonsContainer">
          <Border DockPanel.Dock="Top" Padding="4,0,4,0" HorizontalAlignment="Center" CornerRadius="4" Background="{DynamicResource Merge.StatusLabelBrush.Red}" x:Name="MergeStatusBorder">
            <TextBlock Margin="0" FontSize="11" Foreground="#FFFFFFFF" Text="0/1" x:Name="MergeStatusTextBlock" />
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Margin="0,7,2,0" Height="22" Padding="4,0" Click="PreviousChunkButton_Click">
              <Image Source="{DynamicResource PrevIcon}" Width="16" Height="16" VerticalAlignment="Center" />
            </Button>
            <Button Margin="0,7,0,0" Height="22" Padding="4,0" Click="NextChunkButton_Click">
              <Image Source="{DynamicResource NextIcon}" Width="16" Height="16" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </DockPanel>
        <DockPanel>
          <CheckBox Margin="0,0,0,0" Width="360" HorizontalAlignment="Left" IsCheckedChanged="AllLocalCheckBox_Changed" x:Name="AllLocalCheckBox" Theme="{StaticResource MergerSelectAllCheckBox}">
            <Grid HorizontalAlignment="Stretch">
              <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="18" />
              </Grid.RowDefinitions>
              <controls:GitPointView IconMargin="2,0,6,0" x:Name="LocalGitPointView" TextElement.FontSize="14" TextElement.FontWeight="Medium" TextElement.Foreground="{DynamicResource LabelBrush}" />
              <DockPanel Grid.Row="1" x:Name="LocalCheckBoxDetails">
                <controls:AvatarImage DockPanel.Dock="Left" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" x:Name="LocalAuthorAvatarImage" />
                <TextBlock DockPanel.Dock="Right" Margin="8,1,0,0" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="LocalAuthorDateTextBlock" />
                <TextBlock Margin="6,0,0,0" FontSize="13" TextTrimming="CharacterEllipsis" x:Name="LocalSubjectTextBlock" />
              </DockPanel>
            </Grid>
          </CheckBox>
        </DockPanel>
      </DockPanel>
    </Grid>
    <Border Grid.Row="2" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" x:Name="MergeCodeEditorContainer">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <mergeControls:MergeCodeEditor Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" x:Name="RemoteMergeEditor" />
        <mergeControls:MergeCodeEditor Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" x:Name="MergedMergeEditor" />
        <mergeControls:MergeCodeEditor Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" x:Name="LocalMergeEditor" />
        <Border Grid.Column="1" BorderThickness="1,0,1,0" BorderBrush="{DynamicResource BorderBrush}" x:Name="MergedVerticalBorder" />
        <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Top" x:Name="MergedHorizontalSeparator" Theme="{DynamicResource HorizontalGridSplitter}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,-16" Text="editing allowed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="{DynamicResource SecondaryLabelBrush}" />
      </Grid>
    </Border>
    <Border Grid.Row="2" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" x:Name="FileMergeControlContainer">
      <controls:FileMergeControl Grid.Row="2" x:Name="FileMergeControl" />
    </Border>
    <DockPanel Grid.Row="3" Margin="0,12,0,2" HorizontalAlignment="Left">
      <ToggleButton Margin="0" Padding="4,0" Height="22" ToolTip.Tip="Switch orientation" IsCheckedChanged="LayoutOrientationToggleButton_Changed" x:Name="LayoutOrientationToggleButton">
        <Image Source="{DynamicResource HorizontalMergerIcon}" Width="16" Height="16" VerticalAlignment="Center" x:Name="LayoutOrientationToggleButtonImage" />
      </ToggleButton>
      <controls:AiActionButton ActionVerb="Resolve" Margin="6,0,0,0" Click="AiResolveButton_Click" ToolTip.Tip="Use AI to resolve all conflicts" x:Name="AiResolveButton" />
    </DockPanel>
  </Grid>
</local:ForkPlusDialogWindow>