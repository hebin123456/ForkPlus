<dialogs:ForkPlusDialogWindow Width="610" SizeToContent="Height" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.LeanBranchingStartWindow" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns="https://github.com/avaloniaui">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Start branch on:" />
      <controls:GitPointView Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" Height="18" x:Name="GitPointView" />
      <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,0,0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Branch name:" />
      <controls:ReferenceTextBox TextChanged="BranchName_TextChanged" Grid.Row="1" Grid.Column="1" Margin="8,5,0,0" Padding="1,2,2,2" Placeholder="Enter branch name" Icon="{DynamicResource BranchIcon}" x:Name="BranchNameTextBox" />
      <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" Text="Local changes:" FontSize="13" x:Name="LocalChangesTextBlock" />
      <Grid Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" x:Name="LocalChangesOptionsContainer">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <RadioButton Grid.Row="0" Grid.Column="1" Margin="8,6,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Content="Don't change" ToolTip.Tip="Stop if some local changes would be overwritten by checkout" IsCheckedChanged="LocalChangesOption_Changed" x:Name="DoNotChangeRadioButton" />
        <RadioButton Grid.Row="1" Grid.Column="1" Margin="8,6,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Content="Stash and reapply" ToolTip.Tip="Hold Shift to not reapply" IsCheckedChanged="LocalChangesOption_Changed" x:Name="StashAndReapplyRadioButton" />
        <Image Grid.Row="2" Grid.Column="0" Margin="-16,6,0,0" Height="14" Width="14" VerticalAlignment="Center" HorizontalAlignment="Right" Source="avares://ForkPlus/Assets/Warning.png" x:Name="DiscardWarningImage" IsVisible="False" />
        <RadioButton Grid.Row="2" Grid.Column="1" Margin="8,6,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Content="Discard" ToolTip.Tip="Discard local changes (--force)" IsCheckedChanged="LocalChangesOption_Changed" x:Name="DiscardRadioButton" />
      </Grid>
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
