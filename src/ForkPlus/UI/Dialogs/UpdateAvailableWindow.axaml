<dialogs:ForkPlusDialogWindow Width="540" MaxHeight="520" SizeToContent="Height" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.UpdateAvailableWindow" xmlns="https://github.com/avaloniaui" xmlns:fuu="clr-namespace:ForkPlus.UI.UserControls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
      <!-- 结果区（Release Notes + 跳过勾选）：进入自动更新后切换为下载进度面板 -->
      <StackPanel x:Name="ContentPanel">
        <TextBlock Text="Release Notes" FontWeight="Medium" FontSize="13" Margin="0,0,0,4" />
        <!-- 2026-09-17：markdown 渲染替代只读 TextBox 源码显示（与 ReleaseNotesWindow / UpdateCheckWindow 同款） -->
        <Border x:Name="ReleaseNotesBox" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="6" MaxHeight="280">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ReleaseNotesPanel" Margin="2" />
          </ScrollViewer>
        </Border>
        <CheckBox x:Name="SkipVersionCheckBox" Content="Don't remind me for this version" Margin="0,8,0,0" FontSize="13" />
      </StackPanel>
      <fuu:UpdateDownloadPanel x:Name="DownloadPanel" IsVisible="False" />
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
