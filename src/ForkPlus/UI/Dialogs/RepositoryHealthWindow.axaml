<dialogs:ForkPlusDialogWindow Title="Repository Health" Width="900" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.RepositoryHealthWindow" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:usercontrols="clr-namespace:ForkPlus.UI.UserControls" xmlns="https://github.com/avaloniaui">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel>
      <TextBlock Text="Repository Health" DockPanel.Dock="Left" Margin="4,0,0,2" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" />
      <controls:AutoTooltipTextBlock Margin="8,0,0,0" FontSize="14" VerticalAlignment="Center" x:Name="RepositoryNameTextBlock" />
    </DockPanel>
    <Grid Grid.Row="1">
      <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <controls:TouchpadAwareScrollViewer ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <usercontrols:RepositoryHealthUserControl HorizontalAlignment="Stretch" x:Name="RepositoryHealthUserControl" />
        </controls:TouchpadAwareScrollViewer>
      </Border>
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
