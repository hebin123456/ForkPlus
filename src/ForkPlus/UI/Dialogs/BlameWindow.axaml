<ui:CustomWindow xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.BlameWindow" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:userControls="clr-namespace:ForkPlus.UI.UserControls" xmlns:diff="clr-namespace:ForkPlus.UI.Controls.Editor.Diff" xmlns="https://github.com/avaloniaui">
  <!-- Migration note：原 WPF x:Key="{DataTemplateKey {x:Type T}}" 按类型隐式查找，
       Avalonia 12 无此机制（ContentPresenter 只走逻辑树 Control.DataTemplates，不查资源字典），
       搬到根元素 DataTemplates 集合恢复按 DataType 匹配 -->
  <ui:CustomWindow.DataTemplates>
<DataTemplate DataType="dialogs:DummyBlameItemViewModel">
        <Grid Height="16.393333333333334">
          <Border Margin="-4,0,-4,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" />
        </Grid>
      </DataTemplate>
<DataTemplate DataType="dialogs:BlameItemViewModel">
        <Grid Height="16.393333333333334">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="18" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Grid.ColumnSpan="6" Margin="-4,-1,-4,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" />
          <controls:AvatarImage Grid.Column="0" Margin="4,2,6,1" VerticalAlignment="Top" Height="12" Width="12">
            <controls:AvatarImage.UserIdentity>
              <Binding Path="Author" />
            </controls:AvatarImage.UserIdentity>
            <ToolTip.Tip>
              <Binding Path="FullCredentials" />
            </ToolTip.Tip>
          </controls:AvatarImage>
          <!-- git-ai AI 归属徽标：该 blame 块由 AI agent 生成的行 -->
          <Border Grid.Column="1" Margin="0,1,5,0" Padding="4,0,4,0" Height="13" VerticalAlignment="Top" CornerRadius="2" Background="{DynamicResource AiBadge.Background}" IsVisible="{Binding AiBadgeVisibility}" ToolTip.Tip="{Binding AiBadgeToolTip}">
            <TextBlock Text="AI" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AiBadge.Foreground}" />
          </Border>
          <controls:AutoTooltipTextBlock Grid.Column="2" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Padding="0,-2,0,0" FontSize="12">
            <controls:AutoTooltipTextBlock.Text>
              <Binding Path="RevisionSubject" />
            </controls:AutoTooltipTextBlock.Text>
          </controls:AutoTooltipTextBlock>
          <TextBlock Grid.Column="3" Margin="2,1,0,0" Padding="0,-2,0,0" FontSize="12" HorizontalAlignment="Right">
            <TextBlock.Text>
              <Binding Path="AuthorDate" />
            </TextBlock.Text>
            <ToolTip.Tip>
              <Binding Path="AuthorDate" />
            </ToolTip.Tip>
          </TextBlock>
          <!-- Migration note（v3.13 修复）：SHA 按钮原版在 Grid.Column="4"（日期在 3、SHA 在 4、
               独立窗口按钮在 5），迁移时误把两按钮各左移一格——SHA 与日期同格且都右对齐，
               日期后渲染盖住 SHA（用户反馈"时间把 commit id 挡住了"）。改回原版列号。 -->
          <Button Grid.Column="4" Margin="0,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12" Height="20" IsTabStop="False" Foreground="{DynamicResource ForegroundBrush.Gray}" Click="ShaButton_Click" Theme="{DynamicResource TextButtonStyle}">
            <Button.Content>
              <Binding Path="AbbreviatedSha" />
            </Button.Content>
            <ToolTip.Tip>
              <Binding Path="ShaToolTip" />
            </ToolTip.Tip>
          </Button>
          <Button Grid.Column="5" Width="14" Height="14" Padding="1" Margin="4,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Center" BorderThickness="0" Background="#00FFFFFF" Click="OpenRevisionInSeparateWindowButton_Click" Theme="{DynamicResource IconButtonStyle}">
            <ToolTip.Tip>
              <Binding Path="OpenInSeparateWindowButtonToolTip" />
            </ToolTip.Tip>
            <Image Source="{DynamicResource OpenInSeparateWindowIcon}" Height="12" Width="12" />
          </Button>
        </Grid>
      </DataTemplate>
<DataTemplate DataType="dialogs:BlameItemBodyViewModel">
        <Grid Height="16.393333333333334" />
      </DataTemplate>
  </ui:CustomWindow.DataTemplates>
  <Grid Margin="20,2,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel>
      <ComboBox DockPanel.Dock="Right" HorizontalAlignment="Right" Height="22" Width="570" Padding="4,0,4,0" HorizontalContentAlignment="Stretch" Focusable="False" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="RevisionsComboBox_SelectionChanged" x:Name="RevisionsComboBox">
        <ComboBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ComboBox.ItemsPanel>
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <Grid Width="530">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
              </Grid.ColumnDefinitions>
              <controls:AvatarImage Margin="4,0,4,0" VerticalAlignment="Center" Height="14" Width="14" x:Name="AuthorAvatarImage">
                <controls:AvatarImage.UserIdentity>
                  <Binding Path="Author" />
                </controls:AvatarImage.UserIdentity>
              </controls:AvatarImage>
              <TextBlock Grid.Column="1" Margin="0,2,0,2" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush.Gray}">
                <TextBlock.Text>
                  <Binding Path="AbbreviatedSha" />
                </TextBlock.Text>
              </TextBlock>
              <controls:AutoTooltipTextBlock Grid.Column="2" Margin="4,2,0,2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13">
                <controls:AutoTooltipTextBlock.Text>
                  <Binding Path="RevisionSubject" />
                </controls:AutoTooltipTextBlock.Text>
              </controls:AutoTooltipTextBlock>
              <TextBlock Grid.Column="3" Margin="2,2,2,2" Foreground="{DynamicResource ForegroundBrush.Gray}" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock.Text>
                  <Binding Path="AuthorDate" />
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button DockPanel.Dock="Right" Margin="0,0,2,0" IsEnabled="False" ToolTip.Tip="Go Forward" Click="RedoButton_Click" x:Name="RedoButton" Theme="{DynamicResource IconButtonStyle}">
        <Image Source="{DynamicResource NextIcon}" Width="16" Height="16" VerticalAlignment="Center" />
      </Button>
      <Button DockPanel.Dock="Right" ToolTip.Tip="Go Back" Click="UndoButton_Click" x:Name="UndoButton" Theme="{DynamicResource IconButtonStyle}">
        <Image Source="{DynamicResource PrevIcon}" Width="16" Height="16" VerticalAlignment="Center" />
      </Button>
      <ProgressBar DockPanel.Dock="Right" Margin="0,0,5,0" Width="14" Height="14" Foreground="{DynamicResource ForegroundBrush.Gray}" x:Name="BusyIndicator" Theme="{DynamicResource CircularProgressBar}" IsVisible="True" />
      <TextBlock Text="Blame" DockPanel.Dock="Left" Margin="4,0,0,2" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" x:Name="BlameTitleTextBlock" />
      <Image DockPanel.Dock="Left" Width="14" Height="14" Margin="8,0,4,0" x:Name="FileIcon" />
      <controls:FilePathTextBlock FontSize="14" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" x:Name="FileNameTextBlock" />
    </DockPanel>
    <Border Grid.Row="2" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource BorderBrush}" Height="17" VerticalAlignment="Top" />
    <controls:RevisionTimeLine Grid.Row="2" Height="46" Margin="1,1,1,0" x:Name="RevisionTimeLine" />
    <Grid Grid.Row="3" Background="{DynamicResource BackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="150" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,1" x:Name="RevisionListFallbackBorder">
        <userControls:FallbackUserControl Grid.Column="0" x:Name="RevisionListFallbackUserControl" />
      </Border>
      <ListBox Grid.Column="0" SelectionMode="Single" BorderThickness="1,1,0,1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="BlameListBox" Theme="{DynamicResource NoSelectionListBoxStyle}">
        <ListBox.ContextMenu>
          <ContextMenu />
        </ListBox.ContextMenu>
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Item.Static.Background}" />
            
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" x:Name="Bd">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <ContentControl>
              <ContentControl.Content>
                <Binding />
              </ContentControl.Content>
            </ContentControl>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="2" BorderThickness="0,1,1,1" BorderBrush="{DynamicResource BorderBrush}">
        <diff:SplitTextDiffControl x:Name="TextDiffControl" IsVisible="False" />
      </Border>
      <GridSplitter Grid.Column="1" Theme="{DynamicResource VerticalGridSplitter}" />
      <userControls:FallbackUserControl BorderThickness="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="CodeEditorFallbackUserControl" />
    </Grid>
  </Grid>
</ui:CustomWindow>