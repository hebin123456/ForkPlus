<dialogs:ForkPlusDialogWindow MinHeight="348" Width="240" SizeToContent="Height" Title="About" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.AboutWindow" xmlns="https://github.com/avaloniaui">
  <dialogs:ForkPlusDialogWindow.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="HyperlinkStyle" TargetType="HyperlinkButton">
        
        <Setter Property="Foreground" Value="{DynamicResource ReferenceBrush}" />
        
      
    <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ReferenceBrush}" />
    </Style></ControlTheme>
    </ResourceDictionary>
  </dialogs:ForkPlusDialogWindow.Resources>
  <Grid Margin="20,0,20,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="0" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Image Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Source="avares://ForkPlus/Assets/ForkPlusIcon.png" Width="90" Height="90" />
    <DockPanel Grid.Row="2" Grid.Column="1" LastChildFill="False">
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,10,0,8" Text="ForkPlus" FontSize="32" Foreground="{DynamicResource ForegroundBrush.WindowsInfo}" />
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" x:Name="VersionTextBlock" />
      <ContentControl DockPanel.Dock="Top" HorizontalAlignment="Center" FontSize="13">
        <HyperlinkButton NavigateUri="https://hebin.me" Theme="{DynamicResource HyperlinkStyle}">
          <TextBlock HorizontalAlignment="Center" Text="hebin.me" Margin="0" />
        </HyperlinkButton>
      </ContentControl>
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,8,0,0" Text="Designed and implemented by" Foreground="{DynamicResource ForegroundBrush.Gray}" />
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,4,0,4" Text="Hebin" />
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0" x:Name="CopyrightTextBlock" />
    </DockPanel>
  </Grid>
</dialogs:ForkPlusDialogWindow>