<dialogs:ForkPlusDialogWindow Width="490" SizeToContent="Height" xmlns="https://github.com/avaloniaui" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.ChangeRemoteTrackingWindow" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <!-- 阶段 4.5：Separator 项已迁移——RemoteBranchesComboBox.ItemTemplate 用堆叠 Grid + EnumEqualsConverter 切换 ItemType==Separator 的可见性（替代原 WPF DataTrigger+ControlTemplate for ItemType=="Separator"）。 -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Branch:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <controls:GitPointView Grid.Row="0" Grid.Column="1" Margin="8,4,0,4" x:Name="GitPointView" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Track:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <!-- NOTE (Avalonia limitation): TextSearch.TextPath="ShortName" 已移除——Avalonia 无 TextSearch.TextPath 等价 API，ComboBox 选中项展示由 ItemTemplate 统一渲染。 -->
      <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4" SelectionChanged="RemoteBranchesComboBox_SelectionChanged" x:Name="RemoteBranchesComboBox">
        <ComboBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ComboBox.ItemsPanel>
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Separator IsVisible="{Binding ItemType, Converter={controls:EnumEqualsConverter}, ConverterParameter={x:Static dialogs:ChangeRemoteTrackingWindow+RemoteBranchItemType.Separator}}" Height="1" />
              <StackPanel Orientation="Horizontal" IsVisible="{Binding ItemType, Converter={controls:EnumNotEqualsConverter}, ConverterParameter={x:Static dialogs:ChangeRemoteTrackingWindow+RemoteBranchItemType.Separator}}">
                <Image Source="{DynamicResource BranchIcon}" Height="16" Width="16" Margin="0">
                  <Image.Visibility>
                    <Binding Path="IconVisibility" />
                  </Image.Visibility>
                </Image>
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="13">
                  <TextBlock.Text>
                    <Binding Path="Title" />
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
