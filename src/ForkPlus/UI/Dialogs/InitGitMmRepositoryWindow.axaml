<dialogs:ForkPlusDialogWindow MinHeight="260" Width="590" SizeToContent="Height" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.InitGitMmRepositoryWindow" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns="https://github.com/avaloniaui">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="0" Grid.Row="0" Text="Manifest Repository Url:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <controls:PlaceholderTextBox TextChanged="TextBox_TextChanged" Grid.Row="0" Grid.Column="1" Margin="8,4,0,4" Padding="4,2,4,2" Placeholder="Manifest repository URL" Icon="{DynamicResource SubmoduleIcon}" x:Name="ManifestUrlTextBox" />
      <TextBlock Grid.Column="0" Grid.Row="1" Text="Parent Folder:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <Grid Grid.Column="1" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:PlaceholderTextBox TextChanged="TextBox_TextChanged" Grid.Column="0" Margin="8,4,0,4" Padding="4,2,4,2" Placeholder="Parent folder path" x:Name="ParentDirectoryTextBox" />
        <Button Grid.Column="1" Click="BrowseButton_Click" Theme="{DynamicResource BrowseButtonStyle}" />
      </Grid>
      <TextBlock Grid.Column="0" Grid.Row="2" Text="Name:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <controls:PlaceholderTextBox TextChanged="TextBox_TextChanged" Grid.Row="2" Grid.Column="1" Margin="8,4,0,4" Padding="4,2,4,2" Placeholder="Repository name" x:Name="RepositoryNameTextBox" />
      <TextBlock Grid.Column="0" Grid.Row="3" Text="Manifest File:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <controls:PlaceholderTextBox TextChanged="TextBox_TextChanged" Grid.Row="3" Grid.Column="1" Margin="8,4,0,4" Padding="4,2,4,2" Placeholder="Manifest file" Text="dependency.xml" x:Name="ManifestFileTextBox" />
      <TextBlock Grid.Column="0" Grid.Row="4" Text="Manifest Branch:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <controls:PlaceholderTextBox TextChanged="TextBox_TextChanged" Grid.Row="4" Grid.Column="1" Margin="8,4,0,4" Padding="4,2,4,2" Placeholder="Manifest branch" Text="master" x:Name="ManifestBranchTextBox" />
      <TextBlock Grid.Column="0" Grid.Row="5" Text="Manifest Group:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <controls:PlaceholderTextBox TextChanged="TextBox_TextChanged" Grid.Row="5" Grid.Column="1" Margin="8,4,0,4" Padding="4,2,4,2" Placeholder="Manifest group" Text="default" x:Name="ManifestGroupTextBox" />
      <TextBlock Grid.Column="0" Grid.Row="6" Text="Command Preview:" FontSize="13" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,0,0" />
      <Grid Grid.Column="1" Grid.Row="6" Margin="8,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="CommandPreviewTextBlock" />
        </ScrollViewer>
        <!-- Bug 修复（2026-09-07，"命令预览右侧没有复制按钮"）：git mm 四弹窗的预览区是 XAML 内联实现，
             不走 ForkPlusDialogWindow.AddCommandPreview 基类路径（那条自带复制按钮），迁移时漏掉了。
             按钮/图标与基类实现同款：透明底无边框 + 矢量复制图标。 -->
        <Button x:Name="CommandPreviewCopyButton" Grid.Column="1" Click="CommandPreviewCopyButton_Click" Background="Transparent" BorderThickness="0" Padding="2" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" ToolTip.Tip="Copy to clipboard">
          <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource SecondaryLabelBrush}" Data="M4,2 L12,2 L12,14 L4,14 Z M6,4 L6,12 L10,12 L10,4 Z M2,4 L2,16 L14,16 L14,14 L13,14 L13,15 L3,15 L3,5 L4,5 L4,4 Z" />
        </Button>
      </Grid>
    </Grid>
  </Grid>
</dialogs:ForkPlusDialogWindow>
