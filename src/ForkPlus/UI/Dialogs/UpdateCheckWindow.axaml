<dialogs:ForkPlusDialogWindow Width="520" MinHeight="160" SizeToContent="Height" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.UpdateCheckWindow" xmlns="https://github.com/avaloniaui" xmlns:fuu="clr-namespace:ForkPlus.UI.UserControls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
      <!-- 检查中：进度条 + 状态文本 -->
      <DockPanel x:Name="CheckingPanel" Margin="0,4,0,8">
        <ProgressBar IsIndeterminate="True" Height="3" DockPanel.Dock="Top" Foreground="{DynamicResource AccentColorBrush}" />
        <TextBlock x:Name="StatusTextBlock" Text="Checking for updates..." FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
      </DockPanel>
      <!-- 结果区：版本信息 + Release Notes + 跳过勾选（默认隐藏，检测完成后再显示） -->
      <StackPanel x:Name="ResultPanel" IsVisible="False">
        <TextBlock x:Name="VersionInfoTextBlock" FontSize="13" FontWeight="Medium" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBlock x:Name="ReleaseNotesLabel" Text="Release Notes" FontWeight="Medium" FontSize="13" Margin="0,4,0,4" />
        <TextBox Text="" x:Name="ReleaseNotesTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{DynamicResource BorderBrush}" Padding="6" />
        <CheckBox x:Name="SkipVersionCheckBox" Content="Don't remind me for this version" Margin="0,8,0,0" FontSize="13" />
      </StackPanel>
      <!-- 重置下载中：进度面板（与 UpdateAvailableWindow 自动更新同款，重置流切换显示） -->
      <fuu:UpdateDownloadPanel x:Name="DownloadPanel" IsVisible="False" Margin="0,4,0,8" />
      <!-- "重置此版本"：版本损坏时的就地修复入口（重新从 GitHub 拉当前版本解压替换；
           点击后经两次确认（重置确认 + 是否重置设置）再启动重置流） -->
      <HyperlinkButton x:Name="ResetVersionButton" Theme="{DynamicResource BlueUnderlineHyperlinkStyle}" Click="ResetVersionButton_Click" FontSize="13" Margin="0,2,0,2" HorizontalAlignment="Left">
        <TextBlock x:Name="ResetVersionButtonTextBlock" Text="Reset this version" />
      </HyperlinkButton>
    </StackPanel>
  </Grid>
</dialogs:ForkPlusDialogWindow>
