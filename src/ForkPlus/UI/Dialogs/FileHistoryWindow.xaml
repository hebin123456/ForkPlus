<ui:CustomWindow xmlns="https://github.com/avaloniaui" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.FileHistoryWindow" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:userControls="clr-namespace:ForkPlus.UI.UserControls">
  <ui:CustomWindow.Styles>
    <!-- 阶段 4.5：替代原 DataTemplate.Triggers 中的 DataTrigger。
         当祖先 TreeViewItem.IsSelected=True 时设置 PathTextBlock/RevisionSubjectTextBlock/
         AuthorDateTextBlock/ShaTextBlock.Foreground=ForegroundBrush.Light。
         TreeViewItem 继承自 ListBoxItem，:selected 伪类等价于 WPF IsSelected=True。
         RevisionSubjectTextBlock/PathTextBlock 是 AutoTooltipTextBlock (继承自 TextBlock)，用 TextBlock# 命中。
         跨 DataTemplate 的同名元素（如 AuthorDateTextBlock 同时存在于 HistoryEntry 与 FolderHistory 模板）
         在选中态时统一应用前景色，符合 WPF 行为。 -->
    <Style Selector="controls|TreeViewControlItem:selected TextBlock#PathTextBlock">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
    <Style Selector="controls|TreeViewControlItem:selected TextBlock#RevisionSubjectTextBlock">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
    <Style Selector="controls|TreeViewControlItem:selected TextBlock#AuthorDateTextBlock">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
    <Style Selector="controls|TreeViewControlItem:selected TextBlock#ShaTextBlock">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
  </ui:CustomWindow.Styles>
  <ui:CustomWindow.Resources>
    <ResourceDictionary>
      
      
      
    </ResourceDictionary>
  </ui:CustomWindow.Resources>

  <Grid Margin="20,0,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel>
      <TextBlock DockPanel.Dock="Left" Text="History" Margin="4,0,0,2" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" x:Name="HistoryTitleTextBlock" />
      <Image DockPanel.Dock="Left" Width="14" Height="14" Margin="8,0,4,0" x:Name="FileIcon" />
      <controls:GitPointView DockPanel.Dock="Right" x:Name="TargetReferenceGitPointView" />
      <ProgressBar DockPanel.Dock="Right" Margin="0,0,5,0" IsVisible="True" Width="14" Height="14" Foreground="{DynamicResource ForegroundBrush.Gray}" x:Name="BusyIndicator" />
      <controls:FilePathTextBlock FontSize="14" VerticalAlignment="Center" x:Name="FileNameTextBlock" />
    </DockPanel>
    <Border Grid.Row="1" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource BorderBrush}" Height="17" VerticalAlignment="Top" />
    <controls:RevisionTimeLine Grid.Row="1" Height="46" Margin="1,1,1,0" x:Name="RevisionTimeLine" />
    <Grid Grid.Row="2" Background="{DynamicResource BackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="150" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:MultiselectionTreeView SelectionChanged="TreeView_SelectionChanged" Grid.Column="0" Margin="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" x:Name="TreeView">
        <controls:MultiselectionTreeView.ContextMenu>
          <ContextMenu />
        </controls:MultiselectionTreeView.ContextMenu>
      </controls:MultiselectionTreeView>
      <Border Grid.Column="2" BorderThickness="0,1,1,1" BorderBrush="{DynamicResource BorderBrush}">
        <controls:FileDiffControl Target="History" x:Name="FileDiffControl" />
      </Border>
      <GridSplitter Grid.Column="1" />
      <userControls:FallbackUserControl BorderThickness="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="CodeEditorFallbackUserControl" />
    </Grid>
  </Grid>
</ui:CustomWindow>
