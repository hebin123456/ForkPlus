<dialogs:ForkPlusDialogWindow Width="560" SizeToContent="Height" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.MmSubrepoPushGuidanceWindow" xmlns="https://github.com/avaloniaui">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <!-- v3.12.1：mm 子仓 push 引导窗口。检测到当前仓库隶属 git mm 工作区时展示：
           引导默认走 git mm upload（多仓一起推送，保持子仓间变更一致性），逃生口允许仅推送当前仓库。 -->
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Workspace:" FontSize="13" VerticalAlignment="Center" />
        <TextBlock Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" Foreground="{DynamicResource SecondaryLabelBrush}" x:Name="WorkspacePathTextBlock" />
      </StackPanel>
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SecondaryLabelBrush}" Text="Pushing only this repository may leave the other subrepos in the git mm workspace out of sync." />
      <RadioButton Margin="0,14,0,0" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" GroupName="MmPushChoice" IsChecked="True" Content="Upload the git mm workspace (recommended)" ToolTip.Tip="Switch to the git mm workspace and run git mm upload" IsCheckedChanged="Option_Changed" x:Name="MmUploadRadioButton" />
      <TextBlock Margin="24,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" Text="Switch to the git mm workspace and push all subrepos together with git mm upload." />
      <RadioButton Margin="0,10,0,0" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" GroupName="MmPushChoice" Content="Push this repository only" ToolTip.Tip="Skip git mm upload and push this repository as a standalone repository" IsCheckedChanged="Option_Changed" x:Name="SinglePushRadioButton" />
      <TextBlock Margin="24,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" Text="Skip git mm upload and push this repository as a standalone repository." />
    </StackPanel>
  </Grid>
</dialogs:ForkPlusDialogWindow>
