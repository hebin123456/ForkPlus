<ui:CustomWindow xmlns="https://github.com/avaloniaui" xmlns:dialogs="clr-namespace:ForkPlus.UI.Dialogs" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.Dialogs.BlameWindow" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:userControls="clr-namespace:ForkPlus.UI.UserControls" xmlns:diff="clr-namespace:ForkPlus.UI.Controls.Editor.Diff">
  <ui:CustomWindow.Resources>
    <ResourceDictionary>
      
      
      
    </ResourceDictionary>
  </ui:CustomWindow.Resources>

  <Grid Margin="20,2,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel>
      <ComboBox DockPanel.Dock="Right" HorizontalAlignment="Right" Height="22" Width="570" Padding="4,0,4,0" Focusable="False" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="RevisionsComboBox_SelectionChanged" x:Name="RevisionsComboBox">
        <ComboBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ComboBox.ItemsPanel>
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <Grid Width="530">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
              </Grid.ColumnDefinitions>
              <controls:AvatarImage Margin="4,0,4,0" VerticalAlignment="Center" Height="14" Width="14" x:Name="AuthorAvatarImage">
                <controls:AvatarImage.UserIdentity>
                  <Binding Path="Author" />
                </controls:AvatarImage.UserIdentity>
              </controls:AvatarImage>
              <TextBlock Grid.Column="1" Margin="0,2,0,2" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush.Gray}">
                <TextBlock.Text>
                  <Binding Path="AbbreviatedSha" />
                </TextBlock.Text>
              </TextBlock>
              <controls:AutoTooltipTextBlock Grid.Column="2" Margin="4,2,0,2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13">
                <controls:AutoTooltipTextBlock.Text>
                  <Binding Path="RevisionSubject" />
                </controls:AutoTooltipTextBlock.Text>
              </controls:AutoTooltipTextBlock>
              <TextBlock Grid.Column="3" Margin="2,2,2,2" Foreground="{DynamicResource ForegroundBrush.Gray}" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock.Text>
                  <Binding Path="AuthorDate" />
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button DockPanel.Dock="Right" Margin="0,0,2,0" IsEnabled="False" ToolTip.Tip="Go Forward" Click="RedoButton_Click" x:Name="RedoButton">
        <Image Source="{DynamicResource NextIcon}" Width="16" Height="16" VerticalAlignment="Center" />
      </Button>
      <Button DockPanel.Dock="Right" ToolTip.Tip="Go Back" Click="UndoButton_Click" x:Name="UndoButton">
        <Image Source="{DynamicResource PrevIcon}" Width="16" Height="16" VerticalAlignment="Center" />
      </Button>
      <ProgressBar DockPanel.Dock="Right" Margin="0,0,5,0" IsVisible="True" Width="14" Height="14" Foreground="{DynamicResource ForegroundBrush.Gray}" x:Name="BusyIndicator" />
      <TextBlock Text="Blame" DockPanel.Dock="Left" Margin="4,0,0,2" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" x:Name="BlameTitleTextBlock" />
      <Image DockPanel.Dock="Left" Width="14" Height="14" Margin="8,0,4,0" x:Name="FileIcon" />
      <controls:FilePathTextBlock FontSize="14" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" x:Name="FileNameTextBlock" />
    </DockPanel>
    <Border Grid.Row="2" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource BorderBrush}" Height="17" VerticalAlignment="Top" />
    <controls:RevisionTimeLine Grid.Row="2" Height="46" Margin="1,1,1,0" x:Name="RevisionTimeLine" />
    <Grid Grid.Row="3" Background="{DynamicResource BackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="150" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,1" x:Name="RevisionListFallbackBorder">
        <userControls:FallbackUserControl Grid.Column="0" x:Name="RevisionListFallbackUserControl" />
      </Border>
      <ListBox Grid.Column="0" SelectionMode="Single" BorderThickness="1,1,0,1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" x:Name="BlameListBox">
        <ListBox.ContextMenu>
          <ContextMenu />
        </ListBox.ContextMenu>
        <!-- NOTE (Avalonia limitation): Avalonia 迁移 - 已移除原 ListBox.ItemContainerStyle（含 ListBoxItem 自定义 ControlTemplate：无边框、无焦点样式 Focusable=False、FocusVisualStyle=null、透明背景 Item.Static.Background）。需在后续迁移中用 ItemContainerTheme/Styles 重写该自定义 ListBoxItem ControlTemplate。 -->
        <ListBox.ItemTemplate>
          <DataTemplate>
            <ContentControl>
              <ContentControl.Content>
                <Binding />
              </ContentControl.Content>
            </ContentControl>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="2" BorderThickness="0,1,1,1" BorderBrush="{DynamicResource BorderBrush}">
        <diff:SplitTextDiffControl IsVisible="False" x:Name="TextDiffControl" />
      </Border>
      <GridSplitter Grid.Column="1" />
      <userControls:FallbackUserControl BorderThickness="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="CodeEditorFallbackUserControl" />
    </Grid>
  </Grid>
</ui:CustomWindow>
