<!-- Migrated from WPF to Avalonia: root xmlns updated to https://github.com/avaloniaui; redundant child xmlns/x declarations removed; MouseUp renamed to PointerReleased (matching code-behind RepositoriesListBox_MouseUp with PointerReleasedEventArgs); DataTemplate DataType simplified (removed {x:Type}); SnapsToDevicePixels attributes removed; LayoutTransform kept as-is for later migration; DataTemplate.Triggers kept as-is for later Selector migration. -->
<ui:CustomWindow Width="620" Height="370" ShowHeader="False" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}" xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:ForkPlus.UI.QuickLaunch" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.QuickLaunch.QuickLaunchWindow" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:controls="clr-namespace:ForkPlus.UI.Controls">
  <ui:CustomWindow.Styles>
    <!-- 阶段 4.5：替代原 ControlTemplate/DataTemplate.Triggers 中的 IsSelected 触发器。
         原触发器：ListBoxItem 选中态时（IsSelectionActive=True/False）设置 Bd 的 Background/BorderBrush/Foreground；
         ItemTemplate 内 PathTextBlock/DashTextBlock.Foreground=ForegroundBrush.Light；IconImage.Source=SelectedIcon。
         Avalonia 中 :selected 伪类等价于 WPF IsSelected=True，:focus 表示 IsSelectionActive=True。
         SelectedIcon 替换无法用纯 Selector 表达（需绑定到 SelectedIcon 属性），保留为 DataTemplate 内直接绑定。 -->
    <Style Selector="ListBoxItem:selected /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock#PathTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock#DashTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush.Light}" />
    </Style>
  </ui:CustomWindow.Styles>
  <ui:CustomWindow.Resources>
    <ResourceDictionary>
      <Style x:Key="QuickLaunchListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
<Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" x:Name="Bd">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="{DataTemplateKey {x:Type local:CommandProviderItem}}" DataType="local:CommandProviderItem">
        <DockPanel Height="25" LastChildFill="True" Margin="10,0,0,0">
          <!-- 阶段 4.5：原 DataTrigger (IsSelected=True -> IconImage.Source=SelectedIcon) 用堆叠 Image 实现。
               默认 Image 绑定 Icon，选中 Image 绑定 SelectedIcon，通过祖先 ListBoxItem.IsSelected 切换 IsVisible。 -->
          <Grid DockPanel.Dock="Left" Width="14" Height="14" VerticalAlignment="Bottom" Margin="0,0,4,4">
            <Image Width="14" Height="14" Source="{Binding Icon}" IsVisible="{Binding !IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}" />
            <Image Width="14" Height="14" Source="{Binding SelectedIcon}" IsVisible="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}" />
          </Grid>
          <controls:FuzzyHighlightableTextBlock DockPanel.Dock="Left" FontSize="14" Margin="0,0,0,4" VerticalAlignment="Bottom" x:Name="NameTextBlock">
            <controls:FuzzyHighlightableTextBlock.Text>
              <Binding Path="Title" />
            </controls:FuzzyHighlightableTextBlock.Text>
            <controls:FuzzyHighlightableTextBlock.FuzzySearchString>
              <Binding Path="FuzzySearchString" />
            </controls:FuzzyHighlightableTextBlock.FuzzySearchString>
          </controls:FuzzyHighlightableTextBlock>
          <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" Margin="4,0,4,4" VerticalAlignment="Bottom" IsVisible="{Binding DescriptionVisibility}" x:Name="DashTextBlock" />
          <controls:FuzzyHighlightableTextBlock FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" x:Name="PathTextBlock">
            <controls:FuzzyHighlightableTextBlock.Text>
              <Binding Path="SecondaryTitle" />
            </controls:FuzzyHighlightableTextBlock.Text>
            <controls:FuzzyHighlightableTextBlock.FuzzySearchString>
              <Binding Path="FuzzySearchString" />
            </controls:FuzzyHighlightableTextBlock.FuzzySearchString>
          </controls:FuzzyHighlightableTextBlock>
        </DockPanel>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type local:HeaderCommandProviderItem}}" DataType="local:HeaderCommandProviderItem">
        <DockPanel Height="25" LastChildFill="True" Margin="10,0,0,0">
          <TextBlock DockPanel.Dock="Left" FontSize="13.5" Margin="0,0,0,4" FontWeight="Medium" VerticalAlignment="Bottom" x:Name="NameTextBlock">
            <TextBlock.Text>
              <Binding Path="Title" />
            </TextBlock.Text>
          </TextBlock>
        </DockPanel>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type local:RepositoryInfoItem}}" DataType="local:RepositoryInfoItem">
        <DockPanel Height="25" LastChildFill="True" Margin="10,0,0,0">
          <Grid DockPanel.Dock="Left" Width="14" Height="14" VerticalAlignment="Bottom" Margin="0,0,4,4">
            <Image Width="14" Height="14" Source="{Binding Icon}" IsVisible="{Binding !IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}" />
            <Image Width="14" Height="14" Source="{Binding SelectedIcon}" IsVisible="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}" />
          </Grid>
          <controls:FuzzyHighlightableTextBlock DockPanel.Dock="Left" FontSize="14" Margin="0,0,0,4" VerticalAlignment="Bottom" x:Name="NameTextBlock">
            <controls:FuzzyHighlightableTextBlock.Text>
              <Binding Path="Title" />
            </controls:FuzzyHighlightableTextBlock.Text>
            <controls:FuzzyHighlightableTextBlock.FuzzySearchString>
              <Binding Path="FuzzySearchString" />
            </controls:FuzzyHighlightableTextBlock.FuzzySearchString>
          </controls:FuzzyHighlightableTextBlock>
          <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" Margin="4,0,4,4" VerticalAlignment="Bottom" IsVisible="{Binding DescriptionVisibility}" x:Name="DashTextBlock" />
          <controls:FuzzyHighlightableTextBlock FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" x:Name="PathTextBlock">
            <controls:FuzzyHighlightableTextBlock.Text>
              <Binding Path="SecondaryTitle" />
            </controls:FuzzyHighlightableTextBlock.Text>
            <controls:FuzzyHighlightableTextBlock.FuzzySearchString>
              <Binding Path="FuzzySearchString" />
            </controls:FuzzyHighlightableTextBlock.FuzzySearchString>
          </controls:FuzzyHighlightableTextBlock>
        </DockPanel>
      </DataTemplate>
    </ResourceDictionary>
  </ui:CustomWindow.Resources>
  <Grid Margin="0,10,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
      <StackPanel Orientation="Horizontal" Margin="10,0,0,7">
        <Image Source="{DynamicResource SearchIcon}" Margin="0,3,6,0" Width="16" />
        <controls:CommandTextBox FontSize="16" BorderThickness="0" x:Name="CommandTextBox" />
      </StackPanel>
    </Border>
    <ListBox Grid.Row="2" BorderThickness="0" SelectionMode="Single" Margin="0" PointerReleased="RepositoriesListBox_MouseUp" x:Name="RepositoriesListBox"><ListBox.ItemTemplate>
        <DataTemplate>
          <ContentControl>
            <ContentControl.Content>
              <Binding />
            </ContentControl.Content>
          </ContentControl>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</ui:CustomWindow>
