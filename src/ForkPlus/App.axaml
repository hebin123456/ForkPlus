<DataTemplate DataType="ui:LocalBranchSidebarItem">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- Migration note：WPF DataTrigger LocalBranch.IsActive=True → BranchImage 换 ActiveBranchIcon
           （双 Image 分支恢复；选中+聚焦组合换 ActiveBranchSelectedIcon 的 MultiDataTrigger 暂缓）。 -->
      <Image Grid.Column="0" Height="16" Width="16" x:Name="ActiveBranchImage" Source="{DynamicResource ActiveBranchIcon}" IsVisible="{Binding LocalBranch.IsActive}" />
      <Image Grid.Column="0" Height="16" Width="16" x:Name="BranchImage" IsVisible="{Binding !LocalBranch.IsActive}">
        <Image.Source>
          <Binding Path="UpstreamStatus"><Binding.Converter><ui:UpstreamStatusToImageConverter /></Binding.Converter></Binding>
        </Image.Source>
      </Image>
      <!-- Migration note：WPF DataTrigger LocalBranch.IsActive=True → FontWeight=Bold（当前分支加粗），
           经 BoolToFontWeight 转换器绑定恢复。 -->
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Left" FontWeight="{Binding LocalBranch.IsActive, Converter={StaticResource BoolToFontWeight}}" x:Name="TitleTextBlock">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <ToolTip.Tip>
          <Binding Path="Tooltip" />
        </ToolTip.Tip>
      </TextBlock>
      <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,2,0">
        <TextBlock.Text>
          <Binding Path="UpstreamStatusString" />
        </TextBlock.Text>
      </TextBlock>
      <Button Grid.Column="3" x:Name="PinButton" Theme="{DynamicResource SidebarPinButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Pin">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="Pinned" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="PinTooltip" />
        </ToolTip.Tip>
        <Image x:Name="PinButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Pin">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="Pinned" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
      <Button Grid.Column="4" x:Name="FilterButton" Theme="{DynamicResource SidebarFilterButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Filter">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="FilterState" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </ToolTip.Tip>
        <Image x:Name="FilterButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Filter">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="FilterState" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
      <Button Grid.Column="5" x:Name="HideButton" Theme="{DynamicResource SidebarHideButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Hide">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="FilterState" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </ToolTip.Tip>
        <Image x:Name="HideButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Hide">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="FilterState" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
    </Grid>
    
  
    <!--
      WPF migration note: DataTemplate.Triggers 内非 DataTrigger 触发器需人工改写。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
              <MultiDataTrigger.Conditions>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsSelected"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsKeyboardFocusWithin"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="BranchImage" Property="Source">
                <Setter.Value>
                  <Binding Path="UpstreamStatus"><Binding.Converter><ui:UpstreamStatusToImageConverter xmlns:ui="clr-namespace:ForkPlus.UI" /></Binding.Converter></Binding>
                </Setter.Value>
              </Setter>
            </MultiDataTrigger>
    -->
