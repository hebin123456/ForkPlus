<Application xmlns="https://github.com/avaloniaui" xmlns:ui="clr-namespace:ForkPlus.UI" xmlns:controls="clr-namespace:ForkPlus.UI.Controls" xmlns:f="clr-namespace:ForkPlus" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ForkPlus/Theme/Generic.Light.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Migration note：DataTrigger 视觉状态补齐——bool→FontWeight 转换器（IsActive 加粗当前分支），
           下方 DataTemplates 的 LocalBranch/ReferencePanel 模板引用。 -->
      <controls:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
      <controls:SidebarOptionButtonVisibilityConverter x:Key="SidebarOptionButtonVisibility" />
      <controls:SidebarOptionButtonIconConverter x:Key="SidebarOptionButtonIcon" />
    </ResourceDictionary>
  </Application.Resources>

    <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <!-- Migration note：OxyPlot.Avalonia 2.1.0-avalonia11 无 buildTransitive 自动注入，
         必须手动 Include 主题——缺了它 PlotBase(TemplatedControl) 无 ControlTemplate，
         OnApplyTemplate 找不到 PART_Panel → canvas 永不创建 → 统计页图表空白
         （StatisticsUserControl.LinePlot 实测）。 -->
    <StyleInclude Source="avares://OxyPlot.Avalonia/Themes/Default.axaml" />
    <!-- Migration note（v3.13 修复）：全局框架兼容样式——Avalonia 对"Stretch+显式宽超槽位"
         居中排列（WPF 退化为左对齐），ComboBox 关闭态 VisualBrush 快照 Rectangle（运行时
         生成、无 TemplatedParent、ControlTheme 嵌套样式够不到）需要 App 级样式补左对齐，
         详见 Theme/GlobalFrameworkCompatStyles.axaml 注释。 -->
    <StyleInclude Source="avares://ForkPlus/Theme/GlobalFrameworkCompatStyles.axaml" /></Application.Styles>  <!-- Migration note：原 WPF Theme/Styles/Sidebar.axaml 13 个 DataTemplateKey 类型模板。
       WPF 按类型隐式查找（app 级 merged dictionary + DataTemplateKey），Avalonia 12
       ContentPresenter 只走 FindDataTemplate（逻辑树 Control.DataTemplates → 全局），
       资源字典字符串 key 永不命中 → 侧栏树渲染 ToString() 类型名。搬入
       Application.DataTemplates（IGlobalDataTemplates，FindDataTemplate 最后兜底）。 -->
  <Application.DataTemplates>
<DataTemplate DataType="ui:SidebarGroupItem">
    <TextBlock VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Left" FontWeight="Medium" FontSize="13.5">
      <TextBlock.Text>
        <Binding Path="Title" />
      </TextBlock.Text>
    </TextBlock>
  </DataTemplate>
<DataTemplate DataType="ui:RemoteSidebarItem">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16">
        <Image.Source>
          <Binding Path="Remote.Icon" />
        </Image.Source>
      </Image>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Left">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <ToolTip.Tip>
          <Binding Path="Tooltip" />
        </ToolTip.Tip>
      </TextBlock>
    </Grid>
  </DataTemplate>
<DataTemplate DataType="ui:FilterableRemoteSidebarItem">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16">
        <Image.Source>
          <Binding Path="Remote.Icon" />
        </Image.Source>
      </Image>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Left">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <ToolTip.Tip>
          <Binding Path="Tooltip" />
        </ToolTip.Tip>
      </TextBlock>
      <Button Grid.Column="2" x:Name="FilterButton" Theme="{DynamicResource SidebarFilterButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Filter">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="FilterState" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </ToolTip.Tip>
        <Image x:Name="FilterButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Filter">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="FilterState" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
      <Button Grid.Column="3" x:Name="HideButton" Theme="{DynamicResource SidebarHideButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Hide">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="FilterState" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </ToolTip.Tip>
        <Image x:Name="HideButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Hide">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="FilterState" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
    </Grid>
    
  
    <!--
      WPF migration note: DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="True" xmlns="https://github.com/avaloniaui">
              <DataTrigger.Binding>
                <Binding Path="IsMouseOver"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              </DataTrigger.Binding>
              <Setter TargetName="FilterButtonImage" Value="{DynamicResource BranchFilterOffIcon}" Property="Source" />
              
              <Setter TargetName="HideButtonImage" Value="{DynamicResource HideBranchOffIcon}" Property="Source" />
              
            </DataTrigger>
    -->
    <!--
      WPF migration note: DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="Filter" xmlns="https://github.com/avaloniaui">
              <DataTrigger.Binding>
                <Binding Path="FilterState" />
              </DataTrigger.Binding>
              <Setter TargetName="FilterButtonImage" Value="{DynamicResource BranchFilterOnIcon}" Property="Source" />
              
              
            </DataTrigger>
    -->
    <!--
      WPF migration note: DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="Hide" xmlns="https://github.com/avaloniaui">
              <DataTrigger.Binding>
                <Binding Path="FilterState" />
              </DataTrigger.Binding>
              <Setter TargetName="HideButtonImage" Value="{DynamicResource HideBranchOnIcon}" Property="Source" />
              
            </DataTrigger>
    -->
    <!--
      WPF migration note: DataTemplate.Triggers 内非 DataTrigger 触发器需人工改写。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
              <MultiDataTrigger.Conditions>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsMouseOver"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
                <Condition Value="Filter">
                  <Condition.Binding>
                    <Binding Path="FilterState" />
                  </Condition.Binding>
                </Condition>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="HideButton" Property="IsVisible" Value="True" />
            </MultiDataTrigger>
    --></DataTemplate>
<DataTemplate DataType="ui:FolderSidebarItem">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Source="{DynamicResource SidebarFolderIcon}" Height="16" Width="16" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Left">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
      </TextBlock>
    </Grid>
  </DataTemplate>
<DataTemplate DataType="ui:FilterableFolderSidebarItem">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Source="{DynamicResource SidebarFolderIcon}" Height="16" Width="16" Margin="2,0,0,0" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Left">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
      </TextBlock>
      <Button Grid.Column="2" x:Name="FilterButton" Theme="{DynamicResource SidebarFilterButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Filter">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="FilterState" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </ToolTip.Tip>
        <Image x:Name="FilterButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Filter">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="FilterState" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
      <Button Grid.Column="3" x:Name="HideButton" Theme="{DynamicResource SidebarHideButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Hide">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="FilterState" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </ToolTip.Tip>
        <Image x:Name="HideButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Hide">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="FilterState" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
    </Grid>
    
  
    <!--
      WPF migration note: DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="True" xmlns="https://github.com/avaloniaui">
              <DataTrigger.Binding>
                <Binding Path="IsMouseOver"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              </DataTrigger.Binding>
              <Setter TargetName="FilterButtonImage" Value="{DynamicResource BranchFilterOffIcon}" Property="Source" />
              
              <Setter TargetName="HideButtonImage" Value="{DynamicResource HideBranchOffIcon}" Property="Source" />
              
            </DataTrigger>
    -->
    <!--
      WPF migration note: DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
