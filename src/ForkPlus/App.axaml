              <Setter TargetName="HideButton" Property="IsVisible" Value="True" />
            </MultiDataTrigger>
    --></DataTemplate>
<DataTemplate DataType="ui:TruncateSidebarItem">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" FontSize="13" Margin="4,0,0,0" Padding="0" VerticalAlignment="Center">
        <HyperlinkButton NavigateUri=" " Theme="{DynamicResource SidebarTruncateHyperlink}">
          <TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Left">
            <TextBlock.Text>
              <Binding Path="Title" />
            </TextBlock.Text>
          </TextBlock>
        </HyperlinkButton>
      </TextBlock>
    </Grid>
  </DataTemplate>
<DataTemplate DataType="ui:TagSidebarItem">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Source="{DynamicResource TagIcon}" Height="16" Width="16" x:Name="TagImage" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Left" ToolTip.Tip="" x:Name="TagTitleTextBlock" Theme="{DynamicResource SidebarTagTitleTextBlock}">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
      </TextBlock>
      <Button Grid.Column="2" x:Name="PinButton" Theme="{DynamicResource SidebarPinButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Pin">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="Pinned" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="PinTooltip" />
        </ToolTip.Tip>
        <Image x:Name="PinButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Pin">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="Pinned" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
      <Button Grid.Column="3" x:Name="FilterButton" Theme="{DynamicResource SidebarFilterButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Filter">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="FilterState" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </ToolTip.Tip>
        <Image x:Name="FilterButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Filter">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="FilterState" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
      <Button Grid.Column="4" x:Name="HideButton" Theme="{DynamicResource SidebarHideButton}">
        <Button.IsVisible>
          <MultiBinding Converter="{StaticResource SidebarOptionButtonVisibility}" ConverterParameter="Hide">
            <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
            <Binding Path="FilterState" />
          </MultiBinding>
        </Button.IsVisible>
        <ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </ToolTip.Tip>
        <Image x:Name="HideButtonImage">
          <Image.Source>
            <MultiBinding Converter="{StaticResource SidebarOptionButtonIcon}" ConverterParameter="Hide">
              <Binding Path="IsPointerOver"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              <Binding Path="FilterState" />
            </MultiBinding>
          </Image.Source>
        </Image>
      </Button>
    </Grid>
    
  
    <!--
      WPF migration note: DataTemplate.Triggers 内非 DataTrigger 触发器需人工改写。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
              <MultiDataTrigger.Conditions>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsSelected"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsKeyboardFocusWithin"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="TagImage" Value="{DynamicResource TagSelectedIcon}" Property="Source" />
            </MultiDataTrigger>
    -->
    <!--
      WPF migration note: DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="True" xmlns="https://github.com/avaloniaui">
              <DataTrigger.Binding>
                <Binding Path="IsMouseOver"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
              </DataTrigger.Binding>
              <Setter TargetName="PinButtonImage" Value="{DynamicResource PinOffIcon}" Property="Source" />
              
              <Setter TargetName="FilterButtonImage" Value="{DynamicResource BranchFilterOffIcon}" Property="Source" />
              
              <Setter TargetName="HideButtonImage" Value="{DynamicResource HideBranchOffIcon}" Property="Source" />
              
            </DataTrigger>
    -->
    <!--
      WPF migration note: DataTemplate.Triggers 内非 DataTrigger 触发器需人工改写。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
              <MultiDataTrigger.Conditions>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsSelected"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
