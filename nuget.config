<?xml version="1.0" encoding="utf-8"?>
<!-- 仓库级 NuGet 源配置：
     1. 显式 <clear /> 后只保留 nuget.org + 本地 third_party/nuget 目录源，构建可复现
        （避免机器级/用户级 NuGet 配置注入不可控源）。
     2. third_party/nuget 是本地目录源：OxyPlot.Avalonia 的 fork 包
        （hebin123456/oxyplot-avalonia release 产出的 nupkg，按 Avalonia 12.1.1 编译）由
        构建期自动下载到该目录——ForkPlus.csproj 的 RestoreOxyPlotAvalonia target（本地开发）
        / build.yml 的显式下载步骤（CI），NuGet restore 随后从该目录解析
        PackageReference Include="OxyPlot.Avalonia"。目录为空或不存在时 NuGet 只是匹配不到
        本地包（首次下载前），不影响其他包从 nuget.org 正常恢复。
     3. 注意：包版本用 -avalonia12.x 预发布后缀（如 2.1.2-avalonia12.1），nuget.org 官方
        OxyPlot.Avalonia 2.1.2（面向 Avalonia 11）永远不会有该版本号 → 恢复只命中 fork 包。-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ForkPlusThirdParty" value="third_party/nuget" />
  </packageSources>
</configuration>
